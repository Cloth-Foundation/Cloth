static final int32 Count = 1;

func Run(int32 limit): int32 {
  var deferred;
  int32 total = 0;
  { total += 1; }
  if (limit) {
    total++;
  } else {
    total--;
  }
  while (limit) {
    break;
    continue;
  }
  for (var value in values) {
    total += value;
  }
  for (int32 index = 0; index < limit; index++, ++total) {
    total += index;
  }
  switch (total) {
    case 0, 1: { total = 2; }
    default: { total = 3; }
  }
  return total;
}

DefinitionValid(int32 value): Base(value) {
  Count = value;
}

