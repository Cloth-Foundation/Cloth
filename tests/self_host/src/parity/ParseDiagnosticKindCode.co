import clothc.frontend.diagnostic::ParseDiagnosticKind;

class {
  static func Get(ParseDiagnosticKind kind): int32 throws StateError {
    if (kind == ParseDiagnosticKind.kInvalidFileName) { return 0; }
    if (kind == ParseDiagnosticKind.kExpectedDeclaration) { return 1; }
    if (kind == ParseDiagnosticKind.kMisplacedImport) { return 2; }
    if (kind == ParseDiagnosticKind.kExpectedImportName) { return 3; }
    if (kind == ParseDiagnosticKind.kExpectedImportType) { return 4; }
    if (kind == ParseDiagnosticKind.kExpectedImportPathContinuation) {
      return 5;
    }
    if (kind == ParseDiagnosticKind.kReservedStandardLibraryRoot) { return 6; }
    if (kind == ParseDiagnosticKind.kReservedImportAlias) { return 7; }
    if (kind == ParseDiagnosticKind.kExpectedImportAlias) { return 8; }
    if (kind == ParseDiagnosticKind.kWildcardImportAlias) { return 9; }
    if (kind == ParseDiagnosticKind.kExpectedImportTerminator) { return 10; }
    if (kind == ParseDiagnosticKind.kDuplicateFileModifier) { return 11; }
    if (kind == ParseDiagnosticKind.kExpectedFileType) { return 12; }
    if (kind == ParseDiagnosticKind.kInvalidFileModifier) { return 13; }
    if (kind == ParseDiagnosticKind.kRepeatedFileName) { return 14; }
    if (kind == ParseDiagnosticKind.kExpectedBaseType) { return 15; }
    if (kind == ParseDiagnosticKind.kExpectedInterfaceType) { return 16; }
    if (kind == ParseDiagnosticKind.kExpectedFileBody) { return 17; }
    if (kind == ParseDiagnosticKind.kExpectedFileClose) { return 18; }
    if (kind == ParseDiagnosticKind.kExpectedFileEnd) { return 19; }
    if (kind == ParseDiagnosticKind.kExpectedEnumCase) { return 20; }
    if (kind == ParseDiagnosticKind.kDuplicateEnumCase) { return 21; }
    if (kind == ParseDiagnosticKind.kEnumCaseLimit) { return 22; }
    if (kind == ParseDiagnosticKind.kEmptyEnum) { return 23; }
    if (kind == ParseDiagnosticKind.kExpectedEnumSeparator) { return 24; }
    if (kind == ParseDiagnosticKind.kExpectedType) { return 25; }
    if (kind == ParseDiagnosticKind.kRepeatedNullability) { return 26; }
    if (kind == ParseDiagnosticKind.kMultidimensionalArray) { return 27; }
    if (kind == ParseDiagnosticKind.kExpectedArrayClose) { return 28; }
    if (kind == ParseDiagnosticKind.kExpectedParameterOpen) { return 29; }
    if (kind == ParseDiagnosticKind.kExpectedParameterName) { return 30; }
    if (kind == ParseDiagnosticKind.kExpectedParameterSeparator) { return 31; }
    if (kind == ParseDiagnosticKind.kExpectedParameter) { return 32; }
    if (kind == ParseDiagnosticKind.kExpectedParameterClose) { return 33; }
    if (kind == ParseDiagnosticKind.kExpectedFieldName) { return 34; }
    if (kind == ParseDiagnosticKind.kExpectedFieldInitializer) { return 35; }
    if (kind == ParseDiagnosticKind.kExpectedFieldTerminator) { return 36; }
    if (kind == ParseDiagnosticKind.kDuplicateFunctionModifier) { return 37; }
    if (kind == ParseDiagnosticKind.kInvalidInterfaceFunctionModifier) {
      return 38;
    }
    if (kind == ParseDiagnosticKind.kExpectedFunc) { return 39; }
    if (kind == ParseDiagnosticKind.kExpectedFunctionName) { return 40; }
    if (kind == ParseDiagnosticKind.kAbstractFunctionBody) { return 41; }
    if (kind == ParseDiagnosticKind.kExpectedAbstractTerminator) { return 42; }
    if (kind == ParseDiagnosticKind.kExpectedBody) { return 43; }
    if (kind == ParseDiagnosticKind.kUnterminatedBody) { return 44; }
    if (kind == ParseDiagnosticKind.kExpectedThrowsType) { return 45; }
    if (kind == ParseDiagnosticKind.kExpectedThrowsSeparatorType) { return 46; }
    if (kind == ParseDiagnosticKind.kInvalidConstructorName) { return 47; }
    if (kind == ParseDiagnosticKind.kInterfaceConstructor) { return 48; }
    if (kind == ParseDiagnosticKind.kInterfaceField) { return 49; }
    if (kind == ParseDiagnosticKind.kExpectedConstructorInitializer) {
      return 50;
    }
    if (kind == ParseDiagnosticKind.kMemberConflict) { return 51; }
    if (kind == ParseDiagnosticKind.kDuplicateCallableSignature) { return 52; }
    if (kind == ParseDiagnosticKind.kNestedTypeUnsupported) { return 53; }
    if (kind == ParseDiagnosticKind.kResourceLimit) { return 54; }
    if (kind == ParseDiagnosticKind.kExpectedExpression) { return 55; }
    if (kind == ParseDiagnosticKind.kUnexpectedExpressionToken) { return 56; }
    if (kind == ParseDiagnosticKind.kExpectedCheckedType) { return 57; }
    if (kind == ParseDiagnosticKind.kExpectedGroupClose) { return 58; }
    if (kind == ParseDiagnosticKind.kExpectedArgument) { return 59; }
    if (kind == ParseDiagnosticKind.kExpectedArgumentSeparator) { return 60; }
    if (kind == ParseDiagnosticKind.kExpectedCallClose) { return 61; }
    if (kind == ParseDiagnosticKind.kExpectedIndexExpression) { return 62; }
    if (kind == ParseDiagnosticKind.kExpectedIndexClose) { return 63; }
    if (kind == ParseDiagnosticKind.kExpectedMemberName) { return 64; }
    if (kind == ParseDiagnosticKind.kExpectedMetaName) { return 65; }
    if (kind == ParseDiagnosticKind.kExpectedSafeMemberName) { return 66; }
    if (kind == ParseDiagnosticKind.kExpectedSafeMetaName) { return 67; }
    if (kind == ParseDiagnosticKind.kExpectedArrayElement) { return 68; }
    if (kind == ParseDiagnosticKind.kExpectedArraySeparator) { return 69; }
    if (kind == ParseDiagnosticKind.kExpectedArrayLiteralClose) { return 70; }
    if (kind == ParseDiagnosticKind.kExpectedArrayConstructionOpen) {
      return 71;
    }
    if (kind == ParseDiagnosticKind.kExpectedArrayConstructionColon) {
      return 72;
    }
    if (kind == ParseDiagnosticKind.kExpectedArrayLength) { return 73; }
    if (kind == ParseDiagnosticKind.kExpectedArrayConstructionClose) {
      return 74;
    }
    if (kind == ParseDiagnosticKind.kExpectedNumericConversionOpen) {
      return 75;
    }
    if (kind == ParseDiagnosticKind.kExpectedNumericConversionValue) {
      return 76;
    }
    if (kind == ParseDiagnosticKind.kNumericConversionArity) { return 77; }
    if (kind == ParseDiagnosticKind.kExpectedNumericConversionClose) {
      return 78;
    }
    if (kind == ParseDiagnosticKind.kExpectedIntegerConversionMode) {
      return 79;
    }
    if (kind == ParseDiagnosticKind.kExpectedIntegerConversionOpen) {
      return 80;
    }
    if (kind == ParseDiagnosticKind.kExpectedIntegerConversionValue) {
      return 81;
    }
    if (kind == ParseDiagnosticKind.kIntegerConversionArity) { return 82; }
    if (kind == ParseDiagnosticKind.kExpectedIntegerConversionClose) {
      return 83;
    }
    if (kind == ParseDiagnosticKind.kExpectedConstructorInitializerType) {
      return 84;
    }
    if (kind == ParseDiagnosticKind.kExpectedConstructorInitializerOpen) {
      return 85;
    }
    if (kind ==
        ParseDiagnosticKind.kExpectedConstructorInitializerArgument) {
      return 86;
    }
    if (kind ==
        ParseDiagnosticKind.kExpectedConstructorInitializerSeparator) {
      return 87;
    }
    if (kind == ParseDiagnosticKind.kExpectedConstructorInitializerClose) {
      return 88;
    }
    if (kind == ParseDiagnosticKind.kConstantDeclarationLimit) { return 89; }
    if (kind == ParseDiagnosticKind.kConstantExpressionNodeLimit) { return 90; }
    if (kind == ParseDiagnosticKind.kPackageConstantExpressionNodeLimit) {
      return 91;
    }
    if (kind == ParseDiagnosticKind.kConstantExpressionDepthLimit) {
      return 92;
    }
    if (kind == ParseDiagnosticKind.kConstantNumericLiteralLimit) { return 93; }
    if (kind == ParseDiagnosticKind.kExpectedBlockOpen) { return 94; }
    if (kind == ParseDiagnosticKind.kSwitchLabelOutsideSwitch) { return 95; }
    if (kind == ParseDiagnosticKind.kExpectedLocalName) { return 96; }
    if (kind == ParseDiagnosticKind.kExpectedLocalTerminator) { return 97; }
    if (kind == ParseDiagnosticKind.kExpectedReturnTerminator) { return 98; }
    if (kind == ParseDiagnosticKind.kExpectedIfOpen) { return 99; }
    if (kind == ParseDiagnosticKind.kExpectedIfClose) { return 100; }
    if (kind == ParseDiagnosticKind.kExpectedIfBody) { return 101; }
    if (kind == ParseDiagnosticKind.kExpectedElseBody) { return 102; }
    if (kind == ParseDiagnosticKind.kExpectedWhileOpen) { return 103; }
    if (kind == ParseDiagnosticKind.kExpectedWhileClose) { return 104; }
    if (kind == ParseDiagnosticKind.kExpectedWhileBody) { return 105; }
    if (kind == ParseDiagnosticKind.kExpectedForOpen) { return 106; }
    if (kind == ParseDiagnosticKind.kExpectedForInitializerTerminator) {
      return 107;
    }
    if (kind == ParseDiagnosticKind.kExpectedForConditionTerminator) {
      return 108;
    }
    if (kind == ParseDiagnosticKind.kExpectedForClose) { return 109; }
    if (kind == ParseDiagnosticKind.kExpectedForBody) { return 110; }
    if (kind == ParseDiagnosticKind.kExpectedSwitchOpen) { return 111; }
    if (kind == ParseDiagnosticKind.kExpectedSwitchClose) { return 112; }
    if (kind == ParseDiagnosticKind.kExpectedSwitchBody) { return 113; }
    if (kind == ParseDiagnosticKind.kExpectedSwitchArm) { return 114; }
    if (kind == ParseDiagnosticKind.kSwitchDefaultRepeated) { return 115; }
    if (kind == ParseDiagnosticKind.kSwitchDefaultNotLast) { return 116; }
    if (kind == ParseDiagnosticKind.kExpectedSwitchLabel) { return 117; }
    if (kind == ParseDiagnosticKind.kSwitchLabelLimit) { return 118; }
    if (kind == ParseDiagnosticKind.kExpectedSwitchColon) { return 119; }
    if (kind == ParseDiagnosticKind.kExpectedSwitchArmBody) { return 120; }
    if (kind == ParseDiagnosticKind.kSwitchArmLimit) { return 121; }
    if (kind == ParseDiagnosticKind.kEmptySwitch) { return 122; }
    if (kind == ParseDiagnosticKind.kExpectedLoopControlTerminator) {
      return 123;
    }
    if (kind == ParseDiagnosticKind.kExpectedExpressionTerminator) {
      return 124;
    }
    throw StateError("unknown parse diagnostic kind");
  }
}
