import clothc.frontend.syntax.declaration::DeclarationKind;
import clothc.frontend.syntax.expression::ExpressionKind;
import clothc.frontend.syntax.expression::LiteralKind;
import clothc.frontend.syntax.statement::StatementKind;
import clothc.frontend.syntax.tree::FileTypeKind;
import clothc.frontend.syntax.tree::ImportKind;
import clothc.frontend.syntax.tree::Visibility;

class {
  static func Expression(ExpressionKind kind): int32 {
    switch (kind) {
      case ExpressionKind.kInvalid: { return 0; }
      case ExpressionKind.kIdentifier: { return 1; }
      case ExpressionKind.kLiteral: { return 2; }
      case ExpressionKind.kSuper: { return 3; }
      case ExpressionKind.kThrow: { return 4; }
      case ExpressionKind.kUnary: { return 5; }
      case ExpressionKind.kUpdate: { return 6; }
      case ExpressionKind.kBinary: { return 7; }
      case ExpressionKind.kTypeTest: { return 8; }
      case ExpressionKind.kCheckedCast: { return 9; }
      case ExpressionKind.kNumericConversion: { return 10; }
      case ExpressionKind.kIntegerConversion: { return 11; }
      case ExpressionKind.kAssignment: { return 12; }
      case ExpressionKind.kMemberAccess: { return 13; }
      case ExpressionKind.kMetaAccess: { return 14; }
      case ExpressionKind.kSafeMemberAccess: { return 15; }
      case ExpressionKind.kSafeMetaAccess: { return 16; }
      case ExpressionKind.kNullCoalesce: { return 17; }
      case ExpressionKind.kNullAssert: { return 18; }
      case ExpressionKind.kCall: { return 19; }
      case ExpressionKind.kArrayLiteral: { return 20; }
      case ExpressionKind.kArrayConstruction: { return 21; }
      case ExpressionKind.kIndex: { return 22; }
      case ExpressionKind.kParenthesized: { return 23; }
    }
  }

  static func Statement(StatementKind kind): int32 {
    switch (kind) {
      case StatementKind.kInvalid: { return 0; }
      case StatementKind.kLocalVariable: { return 1; }
      case StatementKind.kReturn: { return 2; }
      case StatementKind.kExpression: { return 3; }
      case StatementKind.kIf: { return 4; }
      case StatementKind.kWhile: { return 5; }
      case StatementKind.kForEach: { return 6; }
      case StatementKind.kFor: { return 7; }
      case StatementKind.kSwitch: { return 8; }
      case StatementKind.kBreak: { return 9; }
      case StatementKind.kContinue: { return 10; }
      case StatementKind.kNestedBlock: { return 11; }
    }
  }

  static func Declaration(DeclarationKind kind): int32 {
    switch (kind) {
      case DeclarationKind.kField: { return 0; }
      case DeclarationKind.kFunction: { return 1; }
      case DeclarationKind.kConstructor: { return 2; }
    }
  }

  static func FileType(FileTypeKind kind): int32 {
    switch (kind) {
      case FileTypeKind.kClass: { return 0; }
      case FileTypeKind.kInterface: { return 1; }
      case FileTypeKind.kEnum: { return 2; }
      case FileTypeKind.kStruct: { return 3; }
      case FileTypeKind.kError: { return 4; }
    }
  }

  static func VisibilityValue(Visibility visibility): int32 {
    switch (visibility) {
      case Visibility.kPrivate: { return 0; }
      case Visibility.kPublic: { return 1; }
    }
  }

  static func Import(ImportKind kind): int32 {
    switch (kind) {
      case ImportKind.kType: { return 0; }
      case ImportKind.kWildcard: { return 1; }
    }
  }

  static func Literal(LiteralKind kind): int32 {
    switch (kind) {
      case LiteralKind.kInteger: { return 0; }
      case LiteralKind.kFloat: { return 1; }
      case LiteralKind.kString: { return 2; }
      case LiteralKind.kCharacter: { return 3; }
      case LiteralKind.kBoolean: { return 4; }
      case LiteralKind.kNull: { return 5; }
      case LiteralKind.kEnum: { return 6; }
    }
  }
}
