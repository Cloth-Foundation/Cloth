import clothc.frontend.diagnostic::ParseDiagnosticKind;
import clothc.frontend.lexer::Lexer;
import clothc.frontend.lexer::LexerResult;
import clothc.frontend.parser.declaration::DeclarationOutline;
import clothc.frontend.parser.declaration::DeclarationParser;
import clothc.frontend.parser.declaration::DeclarationResult;
import clothc.frontend.parser.support::TokenIndexRange;
import clothc.frontend.source::SourceFile;
import clothc.frontend.syntax.declaration::DeclarationKind;
import clothc.frontend.syntax.tree::FileTypeKind;
import clothc.frontend.syntax.tree::ImportKind;
import clothc.frontend.syntax.tree::TypeSyntax;

class {
  static func Run(): int32 throws IoError, StateError {
    final int32 implicitStatus = checkImplicit();
    if (implicitStatus != 0) { return implicitStatus; }
    final int32 explicitStatus = checkExplicit();
    if (explicitStatus != 0) { return explicitStatus; }
    final int32 interfaceStatus = checkInterface();
    if (interfaceStatus != 0) { return interfaceStatus; }
    final int32 enumStatus = checkEnumDuplicate();
    if (enumStatus != 0) { return enumStatus; }
    return checkMemberDuplicates();
  }

  static func checkImplicit(): int32 throws IoError, StateError {
    final DeclarationResult result = parse(
        "testdata/parser/implicit.co", "Sample", "bootstrap.parser");
    if (!result.IsValid() || result.GetDiagnostics().GetCount() != 0 ||
        result.GetFile().HasExplicitDeclaration() ||
        result.GetFile().GetFileTypeKind() != FileTypeKind.kClass ||
        result.GetFile().GetImports().GetCount() != 2 ||
        result.GetMembers().GetCount() != 4) {
      return 480;
    }
    if (result.GetFile().GetImports().Get(0).GetKind() != ImportKind.kType ||
        result.GetFile().GetImports().Get(1).GetKind() !=
            ImportKind.kWildcard) {
      return 481;
    }
    final DeclarationOutline count = result.GetMembers().Get(0);
    final TokenIndexRange? initializer = count.GetFieldInitializerTokens();
    if (count.GetKind() != DeclarationKind.kField || !count.IsStatic() ||
        !count.IsFinal() || initializer == null || initializer.IsEmpty()) {
      return 482;
    }
    final TypeSyntax? namesType =
        result.GetMembers().Get(1).GetDeclaredType();
    if (namesType == null || !namesType.IsArray() ||
        !namesType.IsNullable() || !namesType.IsElementNullable()) {
      return 483;
    }
    final DeclarationOutline function = result.GetMembers().Get(2);
    final TokenIndexRange? functionBody = function.GetBodyTokens();
    if (function.GetKind() != DeclarationKind.kFunction ||
        function.GetParameters().GetCount() != 2 ||
        !function.GetParameters().Get(0).IsFinal() ||
        function.GetThrowsTypes().GetCount() != 2 ||
        !function.HasExplicitThrows() || functionBody == null ||
        functionBody.IsEmpty()) {
      return 484;
    }
    final DeclarationOutline constructor = result.GetMembers().Get(3);
    final TokenIndexRange? constructorInitializer =
        constructor.GetConstructorInitializerTokens();
    if (constructor.GetKind() != DeclarationKind.kConstructor ||
        constructor.GetParameters().GetCount() != 1 ||
        constructorInitializer == null || constructorInitializer.IsEmpty() ||
        constructor.GetBodyTokens() == null) {
      return 485;
    }
    return 0;
  }

  static func checkExplicit(): int32 throws IoError, StateError {
    final DeclarationResult result = parse(
        "testdata/parser/explicit.co", "Explicit", "bootstrap.parser");
    if (!result.IsValid() || !result.GetFile().HasExplicitDeclaration() ||
        result.GetFile().GetFileTypeKind() != FileTypeKind.kClass ||
        !result.GetFile().IsAbstract() || !result.GetFile().IsSealed() ||
        result.GetFile().GetBaseClass() == null ||
        result.GetFile().GetInterfaces().GetCount() != 2 ||
        result.GetMembers().GetCount() != 1 ||
        !result.GetMembers().Get(0).IsAbstract() ||
        result.GetMembers().Get(0).GetBodyTokens() != null) {
      return 486;
    }
    return 0;
  }

  static func checkInterface(): int32 throws IoError, StateError {
    final DeclarationResult result = parse(
        "testdata/parser/interface.co", "Contract", "bootstrap.parser");
    if (!result.IsValid() ||
        result.GetFile().GetFileTypeKind() != FileTypeKind.kInterface ||
        result.GetFile().GetBaseClass() != null ||
        result.GetFile().GetInterfaces().GetCount() != 2 ||
        result.GetMembers().GetCount() != 1 ||
        !result.GetMembers().Get(0).IsAbstract()) {
      return 487;
    }
    return 0;
  }

  static func checkEnumDuplicate(): int32 throws IoError, StateError {
    final DeclarationResult result = parse(
        "testdata/parser/enum_duplicate.co", "Color", "bootstrap.parser");
    if (result.IsValid() ||
        result.GetFile().GetFileTypeKind() != FileTypeKind.kEnum ||
        result.GetFile().GetEnumCases().GetCount() != 3 ||
        !result.GetFile().GetEnumCases().Get(0).IsValid() ||
        result.GetFile().GetEnumCases().Get(2).IsValid() ||
        result.GetDiagnostics().GetCount() != 1 ||
        result.GetDiagnostics().Get(0).GetKind() !=
            ParseDiagnosticKind.kDuplicateEnumCase ||
        result.GetDiagnostics().Get(0).GetRelatedRange() == null) {
      return 488;
    }
    return 0;
  }

  static func checkMemberDuplicates(): int32 throws IoError, StateError {
    final DeclarationResult result = parse(
        "testdata/parser/member_duplicate.co", "Duplicate",
        "bootstrap.parser");
    if (result.IsValid() || result.GetMembers().GetCount() != 6 ||
        !result.GetMembers().Get(1).IsValid() ||
        result.GetMembers().Get(2).IsValid() ||
        !result.GetMembers().Get(3).IsValid() ||
        result.GetMembers().Get(4).IsValid() ||
        !result.GetMembers().Get(5).IsValid() ||
        result.GetDiagnostics().GetCount() != 2 ||
        result.GetDiagnostics().Get(0).GetKind() !=
            ParseDiagnosticKind.kDuplicateCallableSignature ||
        result.GetDiagnostics().Get(1).GetKind() !=
            ParseDiagnosticKind.kDuplicateCallableSignature) {
      return 489;
    }
    return 0;
  }

  static func parse(string path, string fileName,
                    string packageName): DeclarationResult
      throws IoError, StateError {
    final SourceFile source = SourceFile.Load(path);
    final LexerResult lexer = Lexer.Lex(source);
    if (lexer.GetDiagnostics().GetCount() != 0) {
      throw StateError("declaration grammar fixture has lexical diagnostics");
    }
    return DeclarationParser.Parse(source, lexer.GetTokens(), fileName,
                                   packageName);
  }
}
