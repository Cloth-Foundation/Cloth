import clothc.frontend.lexer::Lexer;
import clothc.frontend.lexer::LexerResult;
import clothc.frontend.parser.declaration::DeclarationParser;
import clothc.frontend.parser.declaration::DeclarationResult;
import clothc.frontend.parser.definition::DefinitionParser;
import clothc.frontend.parser.definition::DefinitionResult;
import clothc.frontend.source::SourceFile;

class {
  static func Run(): int32 throws IoError, StateError {
    for (int32 iteration = 0; iteration < 128; iteration++) {
      final SourceFile source =
          SourceFile.Load(
              "tests/self_host/testdata/parser/DefinitionValid.co");
      final LexerResult lexer = Lexer.Lex(source);
      final DeclarationResult declaration = DeclarationParser.Parse(
          source, lexer.GetTokens(), "DefinitionValid", "bootstrap.parser");
      final DefinitionResult definition =
          DefinitionParser.Parse(declaration, null);
      final byte[] pressure = byte[:8192];
      pressure[0] = byte(iteration);
      if (!definition.IsValid() ||
          definition.GetDeclaration() != declaration ||
          definition.GetTree().GetFile().GetSource().GetByte(0) != 115 ||
          definition.GetTree().GetFile().GetStorage().GetNodeCount() < 40 ||
          pressure[0] > 255) {
        return 573;
      }
    }
    return 0;
  }
}
