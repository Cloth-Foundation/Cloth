import clothc.frontend.package::PackageFrontendResult;

import checks.frontend::FrontendCoordinatorCheck;

class {
  static func Run(): int32 throws StateError {
    for (int32 iteration = 0; iteration < 128; iteration++) {
      final PackageFrontendResult result =
          FrontendCoordinatorCheck.BuildMixedResult();
      final byte[] pressure = byte[:8192];
      pressure[0] = byte(iteration);
      if (result.GetFileCount() != 4 || result.GetFile(0).GetDefinition() == null ||
          result.GetFile(0).GetDefinition()!.GetTree().GetFile().GetName() !=
              "Main" ||
          result.GetFile(1).GetPackageSource().GetSource().GetByte(0) != 64 ||
          result.GetFile(2).GetDefinition() == null ||
          result.GetFile(3).GetQualifiedName() != "fib-core.zeta.Zed" ||
          pressure[0] != byte(iteration)) {
        return 606;
      }
    }
    return 0;
  }
}
