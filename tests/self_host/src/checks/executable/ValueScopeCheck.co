import clothc.frontend.package::FrontendCoordinator;
import clothc.frontend.package::PackageFrontendInput;
import clothc.frontend.package::PackageIdentity;
import clothc.frontend.package::PackageSource;
import clothc.frontend.source::SourceFile;
import clothc.frontend.syntax::BlockId;
import clothc.frontend.syntax::StatementId;
import clothc.frontend.syntax.declaration::ConstructorSyntax;
import clothc.frontend.syntax.declaration::DeclarationSyntax;
import clothc.frontend.syntax.declaration::FunctionSyntax;
import clothc.frontend.syntax.statement::BlockNodeSyntax;
import clothc.frontend.syntax.statement::ForEachStatementSyntax;
import clothc.frontend.syntax.statement::ForStatementSyntax;
import clothc.frontend.syntax.statement::NestedBlockStatementSyntax;
import clothc.frontend.syntax.storage::SyntaxStorage;
import clothc.frontend.syntax.tree::FileSyntax;
import clothc.semantic.diagnostic::SemanticDiagnosticKind;
import clothc.semantic.executable::ExecutableSemanticLimits;
import clothc.semantic.executable::ExecutableSemanticResult;
import clothc.semantic.executable::ValueScopeCollector;
import clothc.semantic.identity::SemanticName;
import clothc.semantic.model::SemanticFile;
import clothc.semantic.model::SymbolId;
import clothc.semantic.package::PackageSymbolCollector;
import clothc.semantic.package::SemanticDependency;
import clothc.semantic.package::SemanticLimits;
import clothc.semantic.package::SemanticPackageInput;
import clothc.semantic.package::SemanticPackageResult;
import clothc.semantic.value::LexicalScope;
import clothc.semantic.value::ScopeId;
import clothc.semantic.value::ScopeKind;
import clothc.semantic.value::StatementScopes;
import clothc.semantic.value::ValueId;
import clothc.semantic.value::ValueKind;
import clothc.semantic.value::ValueSymbol;

class {
  static func Run(): int32 throws IoError, StateError {
    final ExecutableSemanticResult result = BuildValidResult();
    final int32 shapeStatus = checkShape(result);
    if (shapeStatus != 0) { return shapeStatus; }
    final int32 lookupStatus = checkLookup(result);
    if (lookupStatus != 0) { return lookupStatus; }
    final int32 duplicateStatus = checkDuplicates();
    if (duplicateStatus != 0) { return duplicateStatus; }
    final int32 stableStatus = checkStable(result, BuildValidResult());
    if (stableStatus != 0) { return stableStatus; }
    ExecutableSemanticLimits.ValidateCounts(
        SemanticLimits.MaxValues(), SemanticLimits.MaxExecutableScopes());
    ExecutableSemanticLimits.ValidateDepth(
        SemanticLimits.MaxStructuralDepth());
    return 0;
  }

  static func BuildValidResult(): ExecutableSemanticResult
      throws IoError, StateError {
    return build("Scopes.co");
  }

  static func checkShape(ExecutableSemanticResult result): int32
      throws StateError {
    if (!result.IsValid() || result.GetDiagnostics().GetCount() != 0 ||
        result.GetValueCount() != 15 || result.GetScopeCount() != 8) {
      return 900;
    }
    final SemanticPackageResult semantic = result.GetSemantic();
    final SemanticFile file = semantic.GetFileAt(0);
    final ScopeId? constructorScope =
        result.FindCallableScope(file.GetMember(1));
    final ScopeId? staticScope = result.FindCallableScope(file.GetMember(2));
    final ScopeId? instanceScope =
        result.FindCallableScope(file.GetMember(3));
    if (constructorScope == null || staticScope == null ||
        instanceScope == null ||
        result.GetScope(constructorScope).GetKind() != ScopeKind.kCallable ||
        result.GetScope(staticScope).GetKind() != ScopeKind.kCallable ||
        result.GetScope(instanceScope).GetKind() != ScopeKind.kCallable) {
      return 901;
    }
    int32 selfCount = 0;
    int32 unresolvedCount = 0;
    int32 immutableCount = 0;
    for (int32 index = 0; index < result.GetValueCount(); index++) {
      final ValueSymbol value = result.GetValueAt(index);
      if (value.GetKind() == ValueKind.kSelf) {
        selfCount++;
        if (value.IsMutable()) { return 902; }
      }
      if (!value.IsTypeResolved()) { unresolvedCount++; }
      if (!value.IsMutable()) { immutableCount++; }
    }
    if (selfCount != 2 || unresolvedCount != 2 || immutableCount != 4) {
      return 903;
    }
    return 0;
  }

  static func checkLookup(ExecutableSemanticResult result): int32
      throws StateError {
    final SemanticPackageResult semantic = result.GetSemantic();
    final SemanticFile file = semantic.GetFileAt(0);
    final FileSyntax syntax =
        file.GetFrontend()!.GetDefinition()!.GetTree().GetFile();
    final SyntaxStorage storage = syntax.GetStorage();
    final ConstructorSyntax? constructor =
        syntax.GetDeclarations().Get(1) as ConstructorSyntax?;
    final FunctionSyntax? staticFunction =
        syntax.GetDeclarations().Get(2) as FunctionSyntax?;
    final FunctionSyntax? instanceFunction =
        syntax.GetDeclarations().Get(3) as FunctionSyntax?;
    if (constructor == null || staticFunction == null ||
        instanceFunction == null) {
      return 904;
    }
    final ScopeId? rootValue =
        result.FindCallableScope(file.GetMember(1));
    final ScopeId? bodyScope =
        result.FindBlockScope(file.GetId(), constructor.GetBody());
    if (rootValue == null || bodyScope == null ||
        bodyScope.GetIndex() != rootValue.GetIndex()) {
      return 905;
    }
    final ScopeId root = rootValue;
    final int32 sourceEnd = syntax.GetSource().GetLength();
    if (!isNamed(result, result.FindValue(
            root, SemanticName.FromString("self"), sourceEnd), "self") ||
        !isNamed(result, result.FindValue(
            root, SemanticName.FromString("initial"), sourceEnd),
            "initial") ||
        !isNamed(result, result.FindValue(
            root, SemanticName.FromString("value"), sourceEnd), "value")) {
      return 906;
    }

    final BlockNodeSyntax? body =
        storage.GetBlock(constructor.GetBody()) as BlockNodeSyntax?;
    if (body == null || body.GetStatements().GetCount() != 5) { return 907; }
    final StatementId nestedId = body.GetStatements().Get(1);
    final NestedBlockStatementSyntax? nested =
        storage.GetStatement(nestedId) as NestedBlockStatementSyntax?;
    if (nested == null) { return 908; }
    final ScopeId? nestedScopeValue =
        result.FindBlockScope(file.GetId(), nested.GetBlock());
    if (nestedScopeValue == null) { return 909; }
    final ScopeId nestedScope = nestedScopeValue;
    final BlockNodeSyntax? nestedBlock =
        storage.GetBlock(nested.GetBlock()) as BlockNodeSyntax?;
    if (nestedBlock == null) { return 910; }
    final int32 ownInitializer = storage.GetStatement(
        nestedBlock.GetStatements().Get(0)).GetRange().GetBegin().GetOffset();
    final ValueId? before = result.FindValue(
        nestedScope, SemanticName.FromString("value"), ownInitializer);
    final ValueId? after = result.FindValue(
        nestedScope, SemanticName.FromString("value"), sourceEnd);
    if (before == null || after == null ||
        result.GetValue(before).GetScope().GetIndex() != root.GetIndex() ||
        result.GetValue(after).GetScope().GetIndex() !=
            nestedScope.GetIndex()) {
      return 911;
    }

    final StatementId forId = body.GetStatements().Get(2);
    final ForStatementSyntax? forStatement =
        storage.GetStatement(forId) as ForStatementSyntax?;
    final StatementScopes? forScopes =
        result.FindStatementScopes(file.GetId(), forId);
    if (forStatement == null || forScopes == null ||
        forScopes.GetEntry().GetIndex() != root.GetIndex() ||
        result.GetScope(forScopes.GetContinuation()).GetKind() !=
            ScopeKind.kLoop ||
        result.FindValue(forScopes.GetEntry(),
                         SemanticName.FromString("index"), sourceEnd) != null ||
        result.FindValue(forScopes.GetContinuation(),
                         SemanticName.FromString("index"), sourceEnd) == null) {
      return 912;
    }

    final StatementId eachId = body.GetStatements().Get(4);
    final ForEachStatementSyntax? each =
        storage.GetStatement(eachId) as ForEachStatementSyntax?;
    final StatementScopes? eachScopes =
        result.FindStatementScopes(file.GetId(), eachId);
    if (each == null || eachScopes == null ||
        eachScopes.GetEntry().GetIndex() != root.GetIndex() ||
        result.FindValue(eachScopes.GetEntry(),
                         SemanticName.FromString("item"), sourceEnd) != null ||
        result.FindValue(eachScopes.GetContinuation(),
                         SemanticName.FromString("item"), sourceEnd) == null) {
      return 913;
    }

    final ScopeId? staticRoot =
        result.FindCallableScope(file.GetMember(2));
    final ScopeId? instanceRoot =
        result.FindCallableScope(file.GetMember(3));
    if (staticRoot == null || instanceRoot == null ||
        result.FindValue(staticRoot, SemanticName.FromString("self"),
                         sourceEnd) != null ||
        result.FindValue(instanceRoot, SemanticName.FromString("self"),
                         sourceEnd) == null) {
      return 914;
    }
    return 0;
  }

  static func checkDuplicates(): int32 throws IoError, StateError {
    final ExecutableSemanticResult result = build("Duplicate.co");
    if (result.IsValid() || !result.GetSemantic().IsValid() ||
        result.GetDiagnostics().GetCount() != 2) {
      return 915;
    }
    for (int32 index = 0; index < 2; index++) {
      if (result.GetDiagnostics().Get(index).GetKind() !=
              SemanticDiagnosticKind.kValueNameDeclaredMoreThanOnce ||
          result.GetDiagnostics().Get(index).GetRelatedRange() == null) {
        return 916;
      }
    }
    return 0;
  }

  static func checkStable(ExecutableSemanticResult left,
                          ExecutableSemanticResult right): int32
      throws StateError {
    if (left.GetValueCount() != right.GetValueCount() ||
        left.GetScopeCount() != right.GetScopeCount()) {
      return 917;
    }
    for (int32 index = 0; index < left.GetValueCount(); index++) {
      final ValueSymbol leftValue = left.GetValueAt(index);
      final ValueSymbol rightValue = right.GetValueAt(index);
      if (!leftValue.GetName().Equals(rightValue.GetName()) ||
          leftValue.GetKind() != rightValue.GetKind() ||
          leftValue.GetScope().GetIndex() !=
              rightValue.GetScope().GetIndex() ||
          leftValue.GetDeclarationOrder() !=
              rightValue.GetDeclarationOrder()) {
        return 918;
      }
    }
    for (int32 index = 0; index < left.GetScopeCount(); index++) {
      final LexicalScope leftScope = left.GetScopeAt(index);
      final LexicalScope rightScope = right.GetScopeAt(index);
      if (leftScope.GetKind() != rightScope.GetKind() ||
          leftScope.GetDepth() != rightScope.GetDepth()) {
        return 919;
      }
    }
    return 0;
  }

  static func isNamed(ExecutableSemanticResult result, ValueId? id,
                      string name): bool throws StateError {
    return id != null && result.GetValue(id).GetName().EqualsString(name);
  }

  static func build(string fileName): ExecutableSemanticResult
      throws IoError, StateError {
    final PackageSource?[] sources = PackageSource?[:1];
    sources[0] = PackageSource.Build(
        fileName, SourceFile.Load(
            "tests/self_host/testdata/executable/" + fileName));
    final SemanticPackageResult semantic = PackageSymbolCollector.Collect(
        SemanticPackageInput.Build(
            FrontendCoordinator.Check(PackageFrontendInput.Build(
                PackageIdentity.Build("scope-test", "1.0.0"), sources)),
            SemanticDependency?[:0]));
    return ValueScopeCollector.Collect(semantic);
  }
}
