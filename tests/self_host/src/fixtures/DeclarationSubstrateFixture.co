import clothc.frontend.diagnostic::ParseDiagnosticBuilder;
import clothc.frontend.parser.declaration::DeclarationOutline;
import clothc.frontend.parser.declaration::DeclarationResult;
import clothc.frontend.parser.declaration::FileDeclarationOutline;
import clothc.frontend.parser.declaration::MemberOutlineBuilder;
import clothc.frontend.parser.declaration::MemberOutlineSequence;
import clothc.frontend.parser.support::TokenIndexRange;
import clothc.frontend.parser.storage::EnumCaseSyntaxBuilder;
import clothc.frontend.parser.storage::ImportSyntaxBuilder;
import clothc.frontend.parser.storage::ParameterSyntaxBuilder;
import clothc.frontend.parser.storage::TypeSyntaxBuilder;
import clothc.frontend.source::SourceFile;
import clothc.frontend.source::SourceLocation;
import clothc.frontend.source::SourceRange;
import clothc.frontend.source::SourceSpan;
import clothc.frontend.syntax.declaration::DeclarationKind;
import clothc.frontend.syntax.declaration::ParameterSyntaxSequence;
import clothc.frontend.syntax.tree::FileTypeKind;
import clothc.frontend.syntax.tree::TypeSyntaxSequence;
import clothc.frontend.syntax.tree::Visibility;
import clothc.frontend.token::Token;
import clothc.frontend.token::TokenBuffer;
import clothc.frontend.token::TokenKind;

class {
  final SourceFile source;
  final TokenBuffer tokens;
  final DeclarationResult result;

  DeclarationSubstrateFixture(SourceFile source, TokenBuffer tokens,
                              DeclarationResult result) {
    self.source = source;
    self.tokens = tokens;
    self.result = result;
  }

  static func Build(): DeclarationSubstrateFixture throws StateError {
    final SourceFile source = buildSource();
    final TokenBuffer tokens = buildTokens(source);
    final DeclarationOutline member = buildMember(source, 4, 6);
    final var members = MemberOutlineBuilder();
    members.Add(member);
    final MemberOutlineSequence memberValues = members.Finish();

    final var imports = ImportSyntaxBuilder();
    final var interfaces = TypeSyntaxBuilder();
    final var enumCases = EnumCaseSyntaxBuilder();
    final SourceRange fileRange = SourceRange(
        SourceLocation(source.GetPath(), 0, 1, 1),
        SourceLocation(source.GetPath(), 15, 2, 1));
    final var file = FileDeclarationOutline(
        "Fixture", "bootstrap", "", "bootstrap.Fixture",
        Visibility.kPublic, imports.Finish(), null, interfaces.Finish(),
        enumCases.Finish(), FileTypeKind.kClass, false, false, false,
        fileRange, true);
    final var diagnostics = ParseDiagnosticBuilder();
    final DeclarationResult result = DeclarationResult.Build(
        source, tokens, file, memberValues, diagnostics.Finish(), true);
    return DeclarationSubstrateFixture(source, tokens, result);
  }

  static func BuildMember(SourceFile source, int32 bodyBegin,
                          int32 bodyEnd): DeclarationOutline
      throws StateError {
    return buildMember(source, bodyBegin, bodyEnd);
  }

  static func NameRange(SourceFile source): SourceRange {
    return range(source, 5, 9, 6, 10);
  }

  static func NameSpan(SourceFile source): SourceSpan throws StateError {
    return SourceSpan(source, 5, 9);
  }

  func GetSource(): SourceFile { return self.source; }
  func GetTokens(): TokenBuffer { return self.tokens; }
  func GetResult(): DeclarationResult { return self.result; }

  static func buildMember(SourceFile source, int32 bodyBegin,
                          int32 bodyEnd): DeclarationOutline
      throws StateError {
    final var parameters = ParameterSyntaxBuilder();
    final ParameterSyntaxSequence parameterValues = parameters.Finish();
    final var throwsTypes = TypeSyntaxBuilder();
    final TypeSyntaxSequence throwValues = throwsTypes.Finish();
    return DeclarationOutline.Build(
        DeclarationKind.kFunction, NameSpan(source), Visibility.kPublic, null,
        parameterValues, throwValues, false, true, false, false, false, 0,
        null, null, TokenIndexRange(bodyBegin, bodyEnd),
        range(source, 0, 14, 1, 15), true);
  }

  static func buildSource(): SourceFile {
    final byte[] bytes = byte[:15];
    bytes[0] = byte(102);
    bytes[1] = byte(117);
    bytes[2] = byte(110);
    bytes[3] = byte(99);
    bytes[4] = byte(32);
    bytes[5] = byte(77);
    bytes[6] = byte(97);
    bytes[7] = byte(105);
    bytes[8] = byte(110);
    bytes[9] = byte(40);
    bytes[10] = byte(41);
    bytes[11] = byte(32);
    bytes[12] = byte(123);
    bytes[13] = byte(125);
    bytes[14] = byte(10);
    return SourceFile.FromBytes("Fixture.co", bytes);
  }

  static func buildTokens(SourceFile source): TokenBuffer throws StateError {
    final var tokens = TokenBuffer(7);
    add(tokens, source, TokenKind.kKwFunc, 0, 4, 1, 5);
    add(tokens, source, TokenKind.kIdentifier, 5, 9, 6, 10);
    add(tokens, source, TokenKind.kLeftParen, 9, 10, 10, 11);
    add(tokens, source, TokenKind.kRightParen, 10, 11, 11, 12);
    add(tokens, source, TokenKind.kLeftBrace, 12, 13, 13, 14);
    add(tokens, source, TokenKind.kRightBrace, 13, 14, 14, 15);
    final var eofLocation = SourceLocation(source.GetPath(), 15, 2, 1);
    tokens.Add(Token(TokenKind.kEof, SourceSpan(source, 15, 15),
                     SourceRange.PointRange(eofLocation)));
    return tokens;
  }

  static func add(TokenBuffer tokens, SourceFile source, TokenKind kind,
                  int32 begin, int32 end, uint32 beginColumn,
                  uint32 endColumn): void throws StateError {
    tokens.Add(Token(kind, SourceSpan(source, begin, end),
                     range(source, begin, end, beginColumn, endColumn)));
  }

  static func range(SourceFile source, int32 begin, int32 end,
                    uint32 beginColumn, uint32 endColumn): SourceRange {
    return SourceRange(SourceLocation(source.GetPath(), begin, 1, beginColumn),
                       SourceLocation(source.GetPath(), end, 1, endColumn));
  }
}
