import clothc.frontend.source::SourceRange;
import clothc.frontend.syntax::StatementSyntax;
import clothc.frontend.syntax.statement::StatementKind;

class is StatementSyntax {
  final int32 value;
  final SourceRange range;

  StatementStorageProbe(int32 value, SourceRange range) {
    self.value = value;
    self.range = range;
  }

  override func GetRange(): SourceRange { return self.range; }
  override func IsValid(): bool { return true; }
  override func GetStatementKind(): StatementKind {
    return StatementKind.kInvalid;
  }

  func GetValue(): int32 {
    return self.value;
  }
}
