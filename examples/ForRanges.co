fn<int> start() = 5
fn<int> end() = 8

fn<int> main() {
    // Bounds are evaluated once; the omitted stepper means +1.
    def total = 0
    for (def i <- start()..end()) total += i
    if (total != 18) { return 1 }
    println(total)

    total = 0
    for (def<int> i <- 10..=2; i -= 2) total += i
    if (total != 30) { return 2 }
    println(total)

    total = 0
    for (def i <- 0..=10; i += 2) total += i
    if (total != 30) { return 3 }
    println(total)

    // Direction may change inside the saved bounds, including at the end.
    def step = 1
    def sequence = 0
    for (def i <- 1..=3; i += step) {
        sequence = sequence * 10 + i
        if (i == 3) { step = -1 }
    }
    if (sequence != 12321) { return 4 }
    println(sequence)

    // Header overflow ends traversal instead of wrapping back to zero.
    def count = 0
    for (def<unsigned int<8>> i <- 254..=255) count++
    if (count != 2) { return 5 }
    println(count)
    return 0
}
