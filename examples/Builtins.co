fn<isize> main() {
    print("Hello, ")
    println("Cloth!")
    println()

    println(42)
    println(unsigned int<64>::max)
    println(true)
    println('😀')
    println(#"Type: {int[3]::type}")
    def<typeinfo> info = float::type
    println(info)
    println(true)

    return if (isize::size >= 8) { 1 } else { 0 }
}
