fn<int> main() {
    def<float<64>> value = -3.5
    println(value.abs())
    println(value.clamp(-1.0, 1.0))
    println(value.signum())

    def<float<16>> half = -0.5
    def<float<32>> single = -0.5
    println(half.abs()::type)
    println(single.abs()::type)
    println(value.abs()::type)
    println(half.signum()::type)

    def zero = -0.0
    if (1.0 / zero.abs() < 0.0) return 1
    if (1.0 / zero.clamp(0.0, 0.0) > 0.0) return 2

    // Safe scalar consumers can reclaim temporary producers in loops.
    def n = 0.0
    while (n.clamp(0.0, 10.0) < 10.0) { n += 1.0 }
    return 0
}
