// Returns 0 when this example passes its checks, or 1 on failure.
fn<int> main() {
    // Explicit and inferred string bindings use the usual = and := rules.
    def<string> greeting = "Hello, Cloth!"
    def original := greeting
    def<string> fixed := "Unicode: é 中 😀"

    greeting = fixed
    def copy = greeting
    greeting = "A new value leaves copies unchanged."

    // Escapes work in ordinary strings; triple-quoted strings keep their raw text.
    def escaped := "a quote: \" and a backslash: \\"
    def raw := """Raw text keeps \n and "quotes" unchanged."""

    // Concatenation makes a new value; comparisons use the complete contents.
    def<string> welcome = "Hello, " + "Cloth!"
    def snapshot := welcome
    welcome = welcome + " 😀"
    def<bool> same := snapshot == "Hello, Cloth!"
    def different := welcome != snapshot
    def withNul := "before\0" + "after"
    def complete := withNul == "before\0after"

    return if (copy == "Unicode: é 中 😀" && same && different && complete) { 0 } else { 1 }
}
