// Returns 0 when this example passes its checks, or 1 on failure.
fn<int> main() {
    return if (60 / (9 + 3 * 10 / 2 - 4) % 3 + (764 / 2 + 12 * 3) * ((2 + 2) * 4) + 1 == 6689) { 0 } else { 1 }

    //60 / (9 + 3 * 10 / 2 - 4) % 3 + (764 / 2 + 12 * 3) * ((2 + 2) * 4) / 1.4 // 4777.1428571428578
}
