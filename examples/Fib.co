fn<usize> iter(usize n) {
    if (n <= 1) return n

    def<usize> previous = 0
    def<usize> current = 1

    for (def<usize> i <- 2..=n) {
        def<usize> next := previous + current
        previous = current
        current = next
    }

    return current
}

fn<usize> recur(usize n) {
    if (n <= 1) return n
    return recur(n - 1) + recur(n - 2)
}

fn main(opt<string[]?> args ?: null) {
    for (def<usize> n <- 0..10) {
        println(iter(n))
    }

    println()
    for (def<int<64>> i <- 2..=10_000; i += 2) println(i)

    /*def<usize> n = 50
    println(#"Printing recursive fibonacci for: {n}")
    println(recur(n))*/
}
