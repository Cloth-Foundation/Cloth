fn<int> fibonacci(int n) {
    if (n <= 1) { return n }

    def previous = 0
    def current = 1

    for (def i <- 2..=n) {
        def next := previous + current
        previous = current
        current = next
    }

    return current
}

fn main() {
    for (def n <- 0..10) {
        println(fibonacci(n))
    }
}