using cloth.collections.List: List
using token.Token: Token

pub typedef<class> TokenList {
    pub def<List<Token>> tokens = List<Token>::new

    // Appending transfers ownership of the token.
    pub mt append(Token token) = tokens.append(token)
    // The returned token is borrowed from this list.
    pub mt<Token> get(usize index) = tokens.get(index)
    pub mt<usize> size() = tokens.size()

    ~TokenList {
        for (def index <- 0..tokens.size()) {
            def token := tokens.get(index)
            token::delete
        }
        tokens::delete
    }
}
