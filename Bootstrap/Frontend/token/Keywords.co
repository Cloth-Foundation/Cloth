pub typedef<enum> Keywords (pub def<string> spelling) {
    MODULE("mod"),
    DEFINITION("def"),
    TYPEDEF("typedef"),
    USING("using"),
    SELF("self"),
    RETURN("return"),
    CONST("const"),
    DEFAULT("default"),
    INTEROP("interop"),
    NEW("new"),
    DELETE("delete"),
    FINAL("final"),
    OPT("opt"),
    CLASS("class"),
    STRUCT("struct"),
    ENUM("enum"),
    INTERFACE("interface"),
    METHOD("mt"),
    OVERRIDE("override"),
    VIRTUAL("virtual"),
    OPERATOR("operator"),
    AUTO("auto"),
    FUNCTION("fn"),
    CONSTRUCTOR("ctor"),
    PUBLIC("pub"),
    BOOLEAN("bool"),
    STRING("string"),
    FLOAT("float"),
    INTEGER("int"),
    CHARACTER("char"),
    VOID("void"),
    TYPEINFO("typeinfo"),
    STATE("state"),
    TRUE("true"),
    FALSE("false"),
    NULL("null"),
    UNSIGNED("unsigned"),
    USIZE("usize"),
    ISIZE("isize"),
    INIT("init"),
    IF("if"),
    ELSE("else"),
    IS("is"),
    FOR("for"),
    WHILE("while"),
    DO("do"),
    CONTINUE("continue"),
    BREAK("break");

    operator ::str() = spelling
}
