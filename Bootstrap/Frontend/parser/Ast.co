using cloth.collections.List: List
using parser.declarations.ParameterDeclaration: ParameterDeclaration, deleteParameters
using parser.statements.Statement: Statement, deleteStatements
using parser.types.TypeReference: TypeReference
using token.Token: Token, TokenSpan

// Nodes borrow their syntax tokens. The caller keeps the token list alive.
pub typedef<class> SourceUnit {
    pub def<List<FunctionDeclaration>> functions = List<FunctionDeclaration>::new

    ~SourceUnit {
        for (def index <- 0..functions.size()) functions.get(index)::delete
        functions::delete
    }

    operator ::str() {
        def result = "(source"
        for (def index <- 0..functions.size()) result += " " + functions.get(index)::str
        return result + ")"
    }
}

pub typedef<class> FunctionDeclaration (
    pub def<Token?> visibility,
    pub def<Token> keyword,
    pub def<TypeReference[]> returnTypes,
    pub def<Token> name,
    pub def<List<ParameterDeclaration>> parameters,
    pub def<List<Statement>> statements,
    pub def<TokenSpan> bodySpan
) {
    // The declaration owns both spans. Each span borrows the source.
    pub def<TokenSpan> span = (visibility ?: keyword).span.through(bodySpan)

    ~FunctionDeclaration {
        deleteParameters(parameters)
        deleteStatements(statements)
        span::delete
        bodySpan::delete
    }

    operator ::str() {
        def result = "("
        if (visibility != null) result += visibility.lexeme + " "
        result += keyword.lexeme
        if (returnTypes::size != 0) {
            result += " (returnTypes"
            for (def returnType <- returnTypes) result += " " + returnType.name.lexeme
            result += ")"
        }
        result += " " + name.lexeme
        def parameterCount := parameters.size()
        if (parameterCount != 0) {
            result += " (parameters"
            for (def index <- 0..parameterCount) result += " " + parameters.get(index)::str
            result += ")"
        }
        for (def index <- 0..statements.size()) result += " " + statements.get(index)::str
        return result + ")"
    }
}

// Number and name expressions have no operands. Operators own their operands.
pub typedef<class> Expression (pub def<Token> token, pub def<Expression[]> operands) {
    ~Expression {
        for (def operand <- operands) operand::delete
    }

    operator ::str() {
        if (operands::size == 0) return token.lexeme
        def result = "(" + token.lexeme
        for (def operand <- operands) result += " " + operand::str
        return result + ")"
    }
}
