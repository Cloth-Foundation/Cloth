using cloth.collections.List: List
using parser.Ast: SourceUnit, FunctionDeclaration, Expression
using parser.ParseCursor: ParseCursor, ParseFailure
using parser.declarations.FunctionHeaderParser: FunctionHeader, parseFunctionHeader
using parser.declarations.ParameterDeclaration: deleteParameters
using parser.statements.BindingDeclaration: BindingDeclaration
using parser.statements.ReturnStatement: ReturnStatement
using parser.statements.Statement: Statement, deleteStatements
using parser.types.TypeParser: parsePlainTypeAnnotation
using parser.types.TypeReference: TypeReference
using token.Keywords: Keywords
using token.Operators: Operators
using token.Token: Token, TokenType
using token.TokenList: TokenList

pub typedef<class> Parser (TokenList tokens) {
    def<ParseCursor> cursor = ParseCursor::new(tokens)
    def<int> powerPrecedence = 30
    pub def<ParseFailure?> failure = null

    ~Parser {
        cursor::delete
        if (failure != null) failure::delete
    }

    // Parse an EOF-terminated lexer result once. Success transfers the tree to
    // the caller. On failure the parser deletes the partial tree.
    pub mt<SourceUnit?> parse() {
        def unit := SourceUnit::new
        cursor.skipNewlines()
        while (cursor.peek().type != TokenType.EOF) {
            def<FunctionDeclaration?> declaration := parseFunction()
            if (declaration == null) return failUnit(unit)
            unit.functions.append(declaration)
            def next := cursor.peek()
            if (next.type != TokenType.NewLine && next.type != TokenType.EOF) {
                cursor.expected("a newline or end of file after a brace-bodied function")
                return failUnit(unit)
            }
            cursor.skipNewlines()
        }
        return unit
    }

    mt<SourceUnit?> failUnit(SourceUnit unit) {
        unit::delete
        failure = cursor.takeFailure()
        return null
    }

    mt<bool> atSeparator() = cursor.peek().type == TokenType.NewLine || cursor.atOperator(Operators.SEMICOLON)

    mt<FunctionDeclaration?> parseFunction() {
        def<FunctionHeader?> header := parseFunctionHeader(cursor)
        if (header == null) return null
        cursor.skipNewlines()
        def<Token?> opening := cursor.expectOperator(Operators.BRACE_OPEN)
        if (opening == null) {
            deleteParameters(header.parameters)
            return null
        }

        def statements := List<Statement>::new
        def<Token?> closing := parseBody(statements)
        if (closing == null) {
            deleteStatements(statements)
            deleteParameters(header.parameters)
            return null
        }
        def bodySpan := opening.span.through(closing.span)
        return FunctionDeclaration::new(
            header.visibility, header.keyword, header.returnTypes, header.name,
            header.parameters, statements, bodySpan
        )
    }

    mt<Token?> parseBody(List<Statement> statements) {
        while (cursor.peek().type != TokenType.EOF && !cursor.atOperator(Operators.BRACE_CLOSE)) {
            if (atSeparator()) {
                cursor.advance()
                continue
            }
            def<Statement?> statement := parseStatement()
            if (statement == null) return null
            statements.append(statement)
            if (!atSeparator() && !cursor.atOperator(Operators.BRACE_CLOSE) && cursor.peek().type != TokenType.EOF) {
                cursor.fail("C2001", #"Expected a newline or '{Operators.SEMICOLON::str}' after statement, found {cursor.found()}")
                return null
            }
        }
        return cursor.expectOperator(Operators.BRACE_CLOSE)
    }

    mt<Statement?> parseStatement() {
        if (cursor.atKeyword(Keywords.DEFINITION)) return parseBinding()
        if (cursor.atKeyword(Keywords.RETURN)) return ReturnStatement::new(cursor.advance())
        cursor.expected(#"a '{Keywords.DEFINITION::str}' binding or '{Keywords.RETURN::str}'")
        return null
    }

    mt<BindingDeclaration?> parseBinding() {
        def keyword := cursor.advance()
        def<TypeReference?> type = null
        if (cursor.atOperator(Operators.LESS)) {
            type = parsePlainTypeAnnotation(cursor)
            if (type == null) return null
        }
        def<Token?> name := cursor.expectIdentifier("a binding name")
        if (name == null) return null
        if (!cursor.atOperator(Operators.ASSIGN) && !cursor.atOperator(Operators.FINAL_ASSIGN)) {
            cursor.expected(#"'{Operators.ASSIGN::str}' or '{Operators.FINAL_ASSIGN::str}'")
            return null
        }
        def assignment := cursor.advance()
        def<Expression?> initializer := parseExpression(0)
        if (initializer == null) return null
        return BindingDeclaration::new(keyword, type, name, assignment, initializer)
    }

    mt<int> binaryPrecedence(string spelling) {
        if (spelling == Operators.MUL_MUL) return powerPrecedence
        if (spelling == Operators.MULTIPLY || spelling == Operators.DIVIDE || spelling == Operators.MODULO) return 20
        if (spelling == Operators.PLUS || spelling == Operators.MINUS) return 10
        return 0
    }

    mt<bool> endsExpression(string spelling) {
        return spelling == Operators.PAREN_CLOSE || spelling == Operators.BRACE_CLOSE || spelling == Operators.BRACKET_CLOSE || spelling == Operators.COMMA || spelling == Operators.SEMICOLON
    }

    mt<Expression?> parseExpression(int minimumPrecedence) {
        def<Expression?> initial := parsePrefix()
        if (initial == null) return null
        def<Expression> left = initial
        while (true) {
            def symbol := cursor.peek()
            if (symbol.type != TokenType.Operator || endsExpression(symbol.lexeme)) return left
            def precedence := binaryPrecedence(symbol.lexeme)
            if (precedence == 0) {
                cursor.fail("C2003", #"Unsupported operator '{symbol.lexeme}'")
                left::delete
                return null
            }
            if (precedence < minimumPrecedence) return left
            cursor.advance()
            def rightPrecedence := if (symbol.lexeme == Operators.MUL_MUL) precedence else precedence + 1
            def<Expression?> right := parseExpression(rightPrecedence)
            if (right == null) {
                left::delete
                return null
            }
            left = Expression::new(symbol, [left, right])
        }
    }

    mt<Expression?> parsePrefix() {
        def token := cursor.peek()
        if (cursor.atOperator(Operators.PLUS) || cursor.atOperator(Operators.MINUS)) {
            cursor.advance()
            def<Expression?> operand := parseExpression(powerPrecedence)
            if (operand == null) return null
            return Expression::new(token, [operand])
        }
        if (cursor.atOperator(Operators.PAREN_OPEN)) {
            cursor.advance()
            def<Expression?> expression := parseExpression(0)
            if (expression == null) return null
            if (cursor.expectOperator(Operators.PAREN_CLOSE) == null) {
                expression::delete
                return null
            }
            return expression
        }
        if (token.type == TokenType.Identifier || token.type == TokenType.IntegerLiteral || token.type == TokenType.FloatingPointLiteral) {
            cursor.advance()
            return Expression::new(token, [])
        }
        cursor.fail("C2006", #"Expected a number, binding name, or '{Operators.PAREN_OPEN::str}', got {cursor.found()}")
        return null
    }
}
