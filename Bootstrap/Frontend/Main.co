using lexer.Lexer: *
using source.SourceFile: SourceFile

pub fn<isize> main (string[] args) {
    println("Cloth Dogfooding")
    def input := if (args::size == 0) { "pub fn main(string[] args) { }" } else { args[0] }
    def source := SourceFile::new("<string>", input)
    def lexer := Lexer::new(input, source)

    def status := lexer.lexTokens()
    lexer::delete
    source::delete

    exit(25)
    return status
}
