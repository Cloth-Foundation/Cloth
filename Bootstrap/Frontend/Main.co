using lexer.Lexer: *
using source.SourceFile: SourceFile

pub fn<isize> main (string[] args) {
    println("Cloth Dogfooding")

    def<string?> userInput = input("Input your code: \n")

    if (userInput == "") userInput = null

    // shouldn't ever crash, as EOF is placed manually.
    def input := if (args::size == 0) { userInput ?: exit(1, "Input is null") } else { args[0] }
    def source := SourceFile::new("<string>", input)
    def lexer := Lexer::new(input, source)

    def status := lexer.lexTokens()

    lexer::delete
    source::delete

    return status
}
