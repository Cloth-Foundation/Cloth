import frontend.source::SourceRange;
import frontend.syntax.tree::TypeSyntax;
import semantic.model::FileId;
import semantic.model::SemanticOwner;
import semantic.resolution::TypeBinding;

class {
  final SemanticOwner owner;
  final TypeBinding?[] bindings;

  _TypeBindingSequence(SemanticOwner owner, TypeBinding?[] bindings) {
    self.owner = owner;
    self.bindings = bindings;
  }

  static func Build(
      SemanticOwner owner,
      TypeBinding?[] input): TypeBindingSequence throws StateError {
    final TypeBinding?[] bindings = TypeBinding?[:input::length];
    for (int32 index = 0; index < input::length; index++) {
      final TypeBinding? binding = input[index];
      if (binding == null || !binding.GetFile().BelongsTo(owner) ||
          !binding.GetType().BelongsTo(owner)) {
        throw StateError("declared type binding contains a foreign handle");
      }
      bindings[index] = binding;
    }
    final TypeBinding?[] sorted = sort(bindings);
    for (int32 index = 1; index < sorted::length; index++) {
      if (compare(get(sorted, index - 1), get(sorted, index)) == 0) {
        throw StateError("declared type syntax was bound more than once");
      }
    }
    return TypeBindingSequence(owner, sorted);
  }

  func GetCount(): int32 { return self.bindings::length; }

  func Get(int32 index): TypeBinding throws StateError {
    if (index < 0 || index >= self.bindings::length) {
      throw StateError("declared type binding index is out of bounds");
    }
    return get(self.bindings, index);
  }

  func Find(FileId file, TypeSyntax syntax): TypeBinding? throws StateError {
    if (!file.BelongsTo(self.owner)) {
      throw StateError("declared type lookup uses a foreign file handle");
    }
    int32 begin = 0;
    int32 end = self.bindings::length;
    while (begin < end) {
      final int32 middle = begin + (end - begin) / 2;
      final TypeBinding binding = get(self.bindings, middle);
      final int32 order = compareKey(file, syntax, binding);
      if (order > 0) {
        begin = middle + 1;
      } else {
        if (order < 0) { end = middle; } else { return binding; }
      }
    }
    return null;
  }

  static func compareKey(FileId file, TypeSyntax syntax,
                         TypeBinding binding): int32 {
    if (file.GetIndex() < binding.GetFile().GetIndex()) { return -1; }
    if (file.GetIndex() > binding.GetFile().GetIndex()) { return 1; }
    return compareRange(syntax.GetRange(), binding.GetSyntax().GetRange());
  }

  static func compare(TypeBinding left, TypeBinding right): int32 {
    if (left.GetFile().GetIndex() < right.GetFile().GetIndex()) { return -1; }
    if (left.GetFile().GetIndex() > right.GetFile().GetIndex()) { return 1; }
    return compareRange(left.GetSyntax().GetRange(),
                        right.GetSyntax().GetRange());
  }

  static func compareRange(SourceRange left, SourceRange right): int32 {
    if (left.GetBegin().GetOffset() < right.GetBegin().GetOffset()) {
      return -1;
    }
    if (left.GetBegin().GetOffset() > right.GetBegin().GetOffset()) {
      return 1;
    }
    if (left.GetEnd().GetOffset() < right.GetEnd().GetOffset()) { return -1; }
    if (left.GetEnd().GetOffset() > right.GetEnd().GetOffset()) { return 1; }
    return 0;
  }

  static func sort(TypeBinding?[] values): TypeBinding?[] throws StateError {
    final int32 count = values::length;
    TypeBinding?[] input = values;
    TypeBinding?[] output = TypeBinding?[:count];
    int32 width = 1;
    while (width < count) {
      int32 begin = 0;
      while (begin < count) {
        final int32 middle = boundedAdd(begin, width, count);
        final int32 end = boundedAdd(middle, width, count);
        merge(input, output, begin, middle, end);
        begin = end;
      }
      final TypeBinding?[] swap = input;
      input = output;
      output = swap;
      if (width > count / 2) { width = count; } else { width *= 2; }
    }
    return input;
  }

  static func merge(
      TypeBinding?[] input, TypeBinding?[] output,
      int32 begin, int32 middle, int32 end): void throws StateError {
    int32 left = begin;
    int32 right = middle;
    for (int32 destination = begin; destination < end; destination++) {
      if (right >= end ||
          (left < middle && compare(get(input, left),
                                    get(input, right)) <= 0)) {
        output[destination] = get(input, left);
        left++;
      } else {
        output[destination] = get(input, right);
        right++;
      }
    }
  }

  static func get(TypeBinding?[] values,
                  int32 index): TypeBinding throws StateError {
    final TypeBinding? value = values[index];
    if (value == null) {
      throw StateError("declared type binding sorting lost a value");
    }
    return value;
  }

  static func boundedAdd(int32 value, int32 amount, int32 limit): int32 {
    if (amount > limit - value) { return limit; }
    return value + amount;
  }
}
