import semantic.model::SemanticOwner;

struct {
  final SemanticOwner owner;
  final int32 index;

  _SymbolId(SemanticOwner owner, int32 index) {
    self.owner = owner;
    self.index = index;
  }

  static func Build(SemanticOwner owner,
                    int32 index): SymbolId throws StateError {
    if (index < 0) { throw StateError("symbol id is negative"); }
    return SymbolId(owner, index);
  }

  func BelongsTo(SemanticOwner candidate): bool {
    return self.owner == candidate;
  }
  func GetIndex(): int32 { return self.index; }
}
