import frontend.package::PackageIdentity;
import frontend.syntax.tree::FileTypeKind;
import semantic.identity::NominalIdentity;
import semantic.package::DependencyPreludeValidator;
import semantic.package::DependencyType;

class {
  final PackageIdentity identity;
  final DependencyType?[] types;

  _DependencyTypeView(PackageIdentity identity, DependencyType?[] types) {
    self.identity = identity;
    self.types = types;
  }

  static func Build(
      PackageIdentity identity,
      DependencyType?[] input): DependencyTypeView throws StateError {
    if (identity.IsStandalone()) {
      throw StateError("dependency package cannot be standalone");
    }
    final DependencyType?[] types = DependencyType?[:input::length];
    for (int32 index = 0; index < input::length; index++) {
      if (input[index] == null) {
        throw StateError("dependency type view contains null");
      }
      final DependencyType value = input[index]!;
      final PackageIdentity owner = value.GetIdentity().GetPackage();
      if (owner.GetName() != identity.GetName() ||
          owner.GetVersion() != identity.GetVersion()) {
        throw StateError("dependency type has a foreign package owner");
      }
      types[index] = value;
    }
    final DependencyType?[] sorted = sort(types);
    for (int32 index = 1; index < sorted::length; index++) {
      final NominalIdentity previous =
          get(sorted, index - 1).GetIdentity();
      final NominalIdentity current = get(sorted, index).GetIdentity();
      if (sameDeclaration(previous, current)) {
        throw StateError("dependency type declaration is duplicated");
      }
    }
    for (int32 index = 0; index < sorted::length; index++) {
      final DependencyType value = get(sorted, index);
      final NominalIdentity nominal = value.GetIdentity();
      if (identity.GetName() == "cloth" &&
          identity.GetVersion() == "0.6.0" &&
          nominal.GetSourcePackage() == "lang" &&
          nominal.GetName() == "Object" &&
          value.GetFileTypeKind() != FileTypeKind.kClass) {
        throw StateError("canonical dependency Object must be a class");
      }
    }
    DependencyPreludeValidator.Validate(identity, sorted);
    return DependencyTypeView(identity, sorted);
  }

  func GetIdentity(): PackageIdentity { return self.identity; }
  func GetTypeCount(): int32 { return self.types::length; }

  func GetType(int32 index): DependencyType throws StateError {
    if (index < 0 || index >= self.types::length) {
      throw StateError("dependency type index is out of bounds");
    }
    return self.types[index]!;
  }

  static func sort(DependencyType?[] values): DependencyType?[]
      throws StateError {
    final int32 count = values::length;
    DependencyType?[] input = values;
    DependencyType?[] output = DependencyType?[:count];
    int32 width = 1;
    while (width < count) {
      int32 begin = 0;
      while (begin < count) {
        final int32 middle = boundedAdd(begin, width, count);
        final int32 end = boundedAdd(middle, width, count);
        merge(input, output, begin, middle, end);
        begin = end;
      }
      final DependencyType?[] swap = input;
      input = output;
      output = swap;
      if (width > count / 2) { width = count; } else { width *= 2; }
    }
    return input;
  }

  static func merge(DependencyType?[] input, DependencyType?[] output,
                    int32 begin, int32 middle,
                    int32 end): void throws StateError {
    int32 left = begin;
    int32 right = middle;
    for (int32 destination = begin; destination < end; destination++) {
      if (right >= end ||
          (left < middle &&
           NominalIdentity.Compare(get(input, left).GetIdentity(),
                                   get(input, right).GetIdentity()) <= 0)) {
        output[destination] = get(input, left);
        left++;
      } else {
        output[destination] = get(input, right);
        right++;
      }
    }
  }

  static func get(DependencyType?[] values,
                  int32 index): DependencyType throws StateError {
    final DependencyType? value = values[index];
    if (value == null) {
      throw StateError("dependency type sorting lost a value");
    }
    return value;
  }

  static func boundedAdd(int32 value, int32 amount, int32 limit): int32 {
    if (amount > limit - value) { return limit; }
    return value + amount;
  }

  static func sameDeclaration(NominalIdentity left,
                              NominalIdentity right): bool {
    return left.GetPackage().GetName() == right.GetPackage().GetName() &&
           left.GetPackage().GetVersion() == right.GetPackage().GetVersion() &&
           left.GetSourcePackage() == right.GetSourcePackage() &&
           left.GetName() == right.GetName();
  }
}
