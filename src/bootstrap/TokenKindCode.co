import frontend.token::TokenKind;

class {
  static func Get(TokenKind kind): int32 {
    switch (kind) {
      case TokenKind.kEof: { return 0; }
      case TokenKind.kIdentifier: { return 1; }
      case TokenKind.kIntegerLiteral: { return 2; }
      case TokenKind.kFloatLiteral: { return 3; }
      case TokenKind.kStringLiteral: { return 4; }
      case TokenKind.kCharacterLiteral: { return 5; }
      case TokenKind.kLeftParen: { return 6; }
      case TokenKind.kRightParen: { return 7; }
      case TokenKind.kLeftBrace: { return 8; }
      case TokenKind.kRightBrace: { return 9; }
      case TokenKind.kLeftBracket: { return 10; }
      case TokenKind.kRightBracket: { return 11; }
      case TokenKind.kComma: { return 12; }
      case TokenKind.kSemicolon: { return 13; }
      case TokenKind.kColon: { return 14; }
      case TokenKind.kColonColon: { return 15; }
      case TokenKind.kDot: { return 16; }
      case TokenKind.kQuestion: { return 17; }
      case TokenKind.kQuestionDot: { return 18; }
      case TokenKind.kQuestionQuestion: { return 19; }
      case TokenKind.kPlus: { return 20; }
      case TokenKind.kMinus: { return 21; }
      case TokenKind.kStar: { return 22; }
      case TokenKind.kSlash: { return 23; }
      case TokenKind.kPercent: { return 24; }
      case TokenKind.kEqual: { return 25; }
      case TokenKind.kEqualEqual: { return 26; }
      case TokenKind.kBangEqual: { return 27; }
      case TokenKind.kLess: { return 28; }
      case TokenKind.kLessEqual: { return 29; }
      case TokenKind.kGreater: { return 30; }
      case TokenKind.kGreaterEqual: { return 31; }
      case TokenKind.kAmpersandAmpersand: { return 32; }
      case TokenKind.kPipePipe: { return 33; }
      case TokenKind.kBang: { return 34; }
      case TokenKind.kAmpersand: { return 35; }
      case TokenKind.kPipe: { return 36; }
      case TokenKind.kCaret: { return 37; }
      case TokenKind.kTilde: { return 38; }
      case TokenKind.kPlusPlus: { return 39; }
      case TokenKind.kMinusMinus: { return 40; }
      case TokenKind.kPlusEqual: { return 41; }
      case TokenKind.kMinusEqual: { return 42; }
      case TokenKind.kStarEqual: { return 43; }
      case TokenKind.kSlashEqual: { return 44; }
      case TokenKind.kPercentEqual: { return 45; }
      case TokenKind.kShiftLeft: { return 46; }
      case TokenKind.kShiftRight: { return 47; }
      case TokenKind.kShiftLeftEqual: { return 48; }
      case TokenKind.kShiftRightEqual: { return 49; }
      case TokenKind.kAmpersandEqual: { return 50; }
      case TokenKind.kPipeEqual: { return 51; }
      case TokenKind.kCaretEqual: { return 52; }
      case TokenKind.kKwFunc: { return 53; }
      case TokenKind.kKwReturn: { return 54; }
      case TokenKind.kKwIf: { return 55; }
      case TokenKind.kKwElse: { return 56; }
      case TokenKind.kKwWhile: { return 57; }
      case TokenKind.kKwFor: { return 58; }
      case TokenKind.kKwIn: { return 59; }
      case TokenKind.kKwBreak: { return 60; }
      case TokenKind.kKwContinue: { return 61; }
      case TokenKind.kKwSwitch: { return 62; }
      case TokenKind.kKwCase: { return 63; }
      case TokenKind.kKwDefault: { return 64; }
      case TokenKind.kKwStruct: { return 65; }
      case TokenKind.kKwClass: { return 66; }
      case TokenKind.kKwInterface: { return 67; }
      case TokenKind.kKwAbstract: { return 68; }
      case TokenKind.kKwSealed: { return 69; }
      case TokenKind.kKwEnum: { return 70; }
      case TokenKind.kKwError: { return 71; }
      case TokenKind.kKwThrow: { return 72; }
      case TokenKind.kKwThrows: { return 73; }
      case TokenKind.kKwTrait: { return 74; }
      case TokenKind.kKwLet: { return 75; }
      case TokenKind.kKwVar: { return 76; }
      case TokenKind.kKwConst: { return 77; }
      case TokenKind.kKwFinal: { return 78; }
      case TokenKind.kKwStatic: { return 79; }
      case TokenKind.kKwOverride: { return 80; }
      case TokenKind.kKwSuper: { return 81; }
      case TokenKind.kKwTrue: { return 82; }
      case TokenKind.kKwFalse: { return 83; }
      case TokenKind.kKwNull: { return 84; }
      case TokenKind.kKwExtern: { return 85; }
      case TokenKind.kKwUnsafe: { return 86; }
      case TokenKind.kKwImport: { return 87; }
      case TokenKind.kKwIs: { return 88; }
      case TokenKind.kKwAs: { return 89; }
      case TokenKind.kKwMatch: { return 90; }
      case TokenKind.kKwInt: { return 91; }
      case TokenKind.kKwInt8: { return 92; }
      case TokenKind.kKwInt16: { return 93; }
      case TokenKind.kKwInt32: { return 94; }
      case TokenKind.kKwInt64: { return 95; }
      case TokenKind.kKwUint: { return 96; }
      case TokenKind.kKwUint8: { return 97; }
      case TokenKind.kKwUint16: { return 98; }
      case TokenKind.kKwUint32: { return 99; }
      case TokenKind.kKwUint64: { return 100; }
      case TokenKind.kKwFloat: { return 101; }
      case TokenKind.kKwFloat32: { return 102; }
      case TokenKind.kKwFloat64: { return 103; }
      case TokenKind.kKwBool: { return 104; }
      case TokenKind.kKwChar: { return 105; }
      case TokenKind.kKwByte: { return 106; }
      case TokenKind.kKwVoid: { return 107; }
      case TokenKind.kKwObject: { return 108; }
    }
  }
}
