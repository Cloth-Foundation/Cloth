import frontend.source::SourceFile;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax::ExpressionId;
import frontend.syntax::ExpressionIdSequence;
import frontend.syntax::ExpressionSyntax;
import frontend.syntax.expression::ArrayConstructionExpressionSyntax;
import frontend.syntax.expression::ArrayLiteralExpressionSyntax;
import frontend.syntax.expression::AssignmentExpressionSyntax;
import frontend.syntax.expression::BinaryExpressionSyntax;
import frontend.syntax.expression::CallExpressionSyntax;
import frontend.syntax.expression::CheckedCastExpressionSyntax;
import frontend.syntax.expression::IdentifierExpressionSyntax;
import frontend.syntax.expression::IndexExpressionSyntax;
import frontend.syntax.expression::IntegerConversionExpressionSyntax;
import frontend.syntax.expression::InvalidExpressionSyntax;
import frontend.syntax.expression::LiteralExpressionSyntax;
import frontend.syntax.expression::LiteralKind;
import frontend.syntax.expression::MemberAccessExpressionSyntax;
import frontend.syntax.expression::MetaAccessExpressionSyntax;
import frontend.syntax.expression::NullAssertExpressionSyntax;
import frontend.syntax.expression::NullCoalesceExpressionSyntax;
import frontend.syntax.expression::NumericConversionExpressionSyntax;
import frontend.syntax.expression::ParenthesizedExpressionSyntax;
import frontend.syntax.expression::SafeMemberAccessExpressionSyntax;
import frontend.syntax.expression::SafeMetaAccessExpressionSyntax;
import frontend.syntax.expression::SuperExpressionSyntax;
import frontend.syntax.expression::ThrowExpressionSyntax;
import frontend.syntax.expression::TypeTestExpressionSyntax;
import frontend.syntax.expression::UnaryExpressionSyntax;
import frontend.syntax.expression::UpdateExpressionSyntax;
import frontend.syntax.storage::ExpressionIdBuilder;
import frontend.syntax.storage::SyntaxStorage;
import frontend.syntax.tree::TypeSyntax;
import frontend.token::TokenKind;

class {
  final ExpressionIdSequence expressions;

  _SyntaxExpressionFixture(ExpressionIdSequence expressions) {
    self.expressions = expressions;
  }

  static func Build(SyntaxStorage storage, SourceFile source,
                    SourceRange range,
                    TypeSyntax type): SyntaxExpressionFixture throws StateError {
    final var ids = ExpressionIdBuilder();
    final ExpressionId invalid = add(
        storage, ids, InvalidExpressionSyntax(range));
    final ExpressionId identifier = add(storage, ids,
        IdentifierExpressionSyntax(span(source, 1, 2), range, true));
    final ExpressionId literal = add(storage, ids,
        LiteralExpressionSyntax(LiteralKind.kInteger, span(source, 2, 3),
                                range, true));
    final ExpressionId superValue = add(
        storage, ids, SuperExpressionSyntax(range, true));
    final ExpressionId thrown = add(
        storage, ids, ThrowExpressionSyntax(identifier, range, true));
    final ExpressionId unary = add(storage, ids,
        UnaryExpressionSyntax(TokenKind.kMinus, literal, range, true));
    final ExpressionId update = add(storage, ids,
        UpdateExpressionSyntax(TokenKind.kPlusPlus, identifier, true, range,
                               true));
    final ExpressionId binary = add(storage, ids,
        BinaryExpressionSyntax(identifier, TokenKind.kPlus, literal, range,
                               true));
    final ExpressionId typeTest = add(
        storage, ids, TypeTestExpressionSyntax(identifier, type, range, true));
    final ExpressionId cast = add(storage, ids,
        CheckedCastExpressionSyntax(identifier, type, range, true));
    final ExpressionId numeric = add(storage, ids,
        NumericConversionExpressionSyntax(type, literal, range, true));
    final ExpressionId integer = add(storage, ids,
        IntegerConversionExpressionSyntax(type, span(source, 3, 7), literal,
                                          range, true));
    final ExpressionId assignment = add(storage, ids,
        AssignmentExpressionSyntax(identifier, TokenKind.kEqual, literal,
                                   range, true));
    final ExpressionId member = add(storage, ids,
        MemberAccessExpressionSyntax(identifier, span(source, 7, 8), range,
                                     true));
    final ExpressionId meta = add(storage, ids,
        MetaAccessExpressionSyntax(identifier, span(source, 8, 9), range,
                                   true));
    final ExpressionId safeMember = add(storage, ids,
        SafeMemberAccessExpressionSyntax(identifier, span(source, 9, 10),
                                         range, true));
    final ExpressionId safeMeta = add(storage, ids,
        SafeMetaAccessExpressionSyntax(identifier, span(source, 10, 11),
                                       range, true));
    final ExpressionId coalesce = add(storage, ids,
        NullCoalesceExpressionSyntax(safeMember, literal, range, true));
    final ExpressionId asserted = add(storage, ids,
        NullAssertExpressionSyntax(coalesce, range, true));
    final ExpressionId call = add(storage, ids,
        CallExpressionSyntax(member, pair(identifier, literal), range, true));
    final ExpressionId array = add(storage, ids,
        ArrayLiteralExpressionSyntax(pair(literal, identifier), range, true));
    final ExpressionId construction = add(storage, ids,
        ArrayConstructionExpressionSyntax(type, literal, range, true));
    final ExpressionId indexed = add(storage, ids,
        IndexExpressionSyntax(array, literal, range, true));
    final ExpressionId grouped = add(storage, ids,
        ParenthesizedExpressionSyntax(binary, range, true));

    if (invalid.GetOrdinal() != 0 || superValue.GetOrdinal() != 3 ||
        thrown.GetOrdinal() != 4 || unary.GetOrdinal() != 5 ||
        update.GetOrdinal() != 6 || typeTest.GetOrdinal() != 8 ||
        cast.GetOrdinal() != 9 || numeric.GetOrdinal() != 10 ||
        integer.GetOrdinal() != 11 || assignment.GetOrdinal() != 12 ||
        meta.GetOrdinal() != 14 || safeMeta.GetOrdinal() != 16 ||
        asserted.GetOrdinal() != 18 || call.GetOrdinal() != 19 ||
        construction.GetOrdinal() != 21 || indexed.GetOrdinal() != 22 ||
        grouped.GetOrdinal() != 23) {
      throw StateError("syntax expression fixture order is inconsistent");
    }
    return SyntaxExpressionFixture(ids.Finish());
  }

  func GetExpressions(): ExpressionIdSequence { return self.expressions; }

  static func add(SyntaxStorage storage, ExpressionIdBuilder ids,
                  ExpressionSyntax value): ExpressionId throws StateError {
    final ExpressionId id = storage.AddExpression(value);
    ids.Add(id);
    return id;
  }

  static func pair(ExpressionId first,
                   ExpressionId second): ExpressionIdSequence throws StateError {
    final var values = ExpressionIdBuilder();
    values.Add(first);
    values.Add(second);
    return values.Finish();
  }

  static func span(SourceFile source, int32 begin,
                   int32 end): SourceSpan throws StateError {
    return SourceSpan(source, begin, end);
  }
}
