import bootstrap::BlockStorageProbe;
import bootstrap::ExpressionStorageProbe;
import bootstrap::StatementStorageProbe;
import frontend.source::SourceFile;
import frontend.source::SourceLocation;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax::BlockId;
import frontend.syntax::ExpressionId;
import frontend.syntax::StatementId;
import frontend.syntax.declaration::DeclarationSyntax;
import frontend.syntax.declaration::DeclarationSyntaxSequence;
import frontend.syntax.declaration::FunctionSyntax;
import frontend.syntax.declaration::ParameterSyntax;
import frontend.syntax.declaration::ParameterSyntaxSequence;
import frontend.syntax.expression::IdentifierExpressionSyntax;
import frontend.syntax.statement::BlockNodeSyntax;
import frontend.syntax.statement::ExpressionStatementSyntax;
import frontend.syntax.statement::InvalidStatementSyntax;
import frontend.syntax.storage::StatementIdBuilder;
import frontend.syntax.storage::SyntaxStorage;
import frontend.syntax.tree::EnumCaseSyntax;
import frontend.syntax.tree::EnumCaseSyntaxSequence;
import frontend.syntax.tree::FileSyntax;
import frontend.syntax.tree::FileTypeKind;
import frontend.syntax.tree::ImportKind;
import frontend.syntax.tree::ImportSyntax;
import frontend.syntax.tree::ImportSyntaxSequence;
import frontend.syntax.tree::TypeSyntax;
import frontend.syntax.tree::TypeSyntaxSequence;
import frontend.syntax.tree::VerifiedSyntaxTree;
import frontend.syntax.tree::Visibility;

class {
  static func Run(string mode): int32 throws StateError {
    if (mode == "range") { return rangeFailure(); }
    if (mode == "foreign-child") { return foreignChild(); }
    if (mode == "foreign-statement") { return foreignStatement(); }
    if (mode == "foreign-block") { return foreignBlock(); }
    if (mode == "kind-mismatch") { return kindMismatch(); }
    if (mode == "statement-kind") { return statementKindMismatch(); }
    if (mode == "block-kind") { return blockKindMismatch(); }
    if (mode == "validity") { return validityFailure(); }
    if (mode == "span-source") { return spanSourceFailure(); }
    if (mode == "type-flags") { return typeFlagsFailure(); }
    return 2;
  }

  static func rangeFailure(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 8);
    final SourceRange importRange = range(source, 0, 16);
    final ImportSyntax?[] importValues = ImportSyntax?[:1];
    importValues[0] = ImportSyntax(
        ImportKind.kType, null, SourceSpan(source, 0, 1), null,
        importRange, true);
    final var storage = SyntaxStorage();
    storage.Seal();
    VerifiedSyntaxTree.Build(buildRoot(
        source, rootRange, storage, ImportSyntaxSequence.Build(importValues),
        emptyDeclarations(), null, true));
    return 0;
  }

  static func foreignChild(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final var other = SyntaxStorage();
    final ExpressionId expression = other.AddExpression(
        IdentifierExpressionSyntax(SourceSpan(source, 0, 1), rootRange, true));
    final BlockId body = expressionBody(storage, expression, rootRange, true);
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, true, true));
    return 0;
  }

  static func kindMismatch(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final ExpressionId expression = storage.AddExpression(
        ExpressionStorageProbe(0, rootRange));
    final BlockId body = expressionBody(storage, expression, rootRange, true);
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, true, true));
    return 0;
  }

  static func foreignStatement(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final var other = SyntaxStorage();
    final StatementId statement =
        other.AddStatement(InvalidStatementSyntax(rootRange));
    final var statements = StatementIdBuilder();
    statements.Add(statement);
    final BlockId body = storage.AddBlock(
        BlockNodeSyntax(statements.Finish(), rootRange, false));
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, false, false));
    return 0;
  }

  static func foreignBlock(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final var other = SyntaxStorage();
    final var statements = StatementIdBuilder();
    final BlockId body = other.AddBlock(
        BlockNodeSyntax(statements.Finish(), rootRange, true));
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, true, true));
    return 0;
  }

  static func statementKindMismatch(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final StatementId statement = storage.AddStatement(
        StatementStorageProbe(0, rootRange));
    final var statements = StatementIdBuilder();
    statements.Add(statement);
    final BlockId body = storage.AddBlock(
        BlockNodeSyntax(statements.Finish(), rootRange, true));
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, true, true));
    return 0;
  }

  static func blockKindMismatch(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final BlockId body = storage.AddBlock(BlockStorageProbe(0, rootRange));
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, true, true));
    return 0;
  }

  static func validityFailure(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final StatementId invalid =
        storage.AddStatement(InvalidStatementSyntax(rootRange));
    final var statements = StatementIdBuilder();
    statements.Add(invalid);
    final BlockId body = storage.AddBlock(
        BlockNodeSyntax(statements.Finish(), rootRange, true));
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, true, true));
    return 0;
  }

  static func spanSourceFailure(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceFile otherSource = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    final ExpressionId expression = storage.AddExpression(
        IdentifierExpressionSyntax(
            SourceSpan(otherSource, 0, 1), rootRange, true));
    final BlockId body = expressionBody(storage, expression, rootRange, true);
    storage.Seal();
    VerifiedSyntaxTree.Build(buildFunctionRoot(
        source, rootRange, storage, body, true, true));
    return 0;
  }

  static func typeFlagsFailure(): int32 throws StateError {
    final SourceFile source = checkSource();
    final SourceRange rootRange = range(source, 0, 16);
    final var storage = SyntaxStorage();
    storage.Seal();
    final var type = TypeSyntax(SourceSpan(source, 0, 1), rootRange, true,
                               false, false, false, true);
    VerifiedSyntaxTree.Build(buildRoot(
        source, rootRange, storage, emptyImports(), emptyDeclarations(), type,
        true));
    return 0;
  }

  static func expressionBody(
      SyntaxStorage storage, ExpressionId expression, SourceRange rootRange,
      bool valid): BlockId throws StateError {
    final StatementId statement = storage.AddStatement(
        ExpressionStatementSyntax(expression, rootRange, valid));
    final var statements = StatementIdBuilder();
    statements.Add(statement);
    return storage.AddBlock(
        BlockNodeSyntax(statements.Finish(), rootRange, valid));
  }

  static func buildFunctionRoot(
      SourceFile source, SourceRange rootRange, SyntaxStorage storage,
      BlockId body, bool functionValid,
      bool fileValid): FileSyntax throws StateError {
    final ParameterSyntax?[] parameterValues = ParameterSyntax?[:0];
    final TypeSyntax?[] typeValues = TypeSyntax?[:0];
    final DeclarationSyntax?[] declarations = DeclarationSyntax?[:1];
    declarations[0] = FunctionSyntax(
        SourceSpan(source, 0, 1), Visibility.kPublic,
        ParameterSyntaxSequence.Build(parameterValues), null, body,
        TypeSyntaxSequence.Build(typeValues), false, true, false, false, false,
        rootRange, functionValid);
    return buildRoot(
        source, rootRange, storage, emptyImports(),
        DeclarationSyntaxSequence.Build(declarations), null, fileValid);
  }

  static func buildRoot(
      SourceFile source, SourceRange rootRange, SyntaxStorage storage,
      ImportSyntaxSequence imports, DeclarationSyntaxSequence declarations,
      TypeSyntax? baseClass, bool valid): FileSyntax throws StateError {
    final TypeSyntax?[] typeValues = TypeSyntax?[:0];
    final EnumCaseSyntax?[] caseValues = EnumCaseSyntax?[:0];
    return FileSyntax.Build(
        source, "Fixture", "", "Fixture", Visibility.kPublic, imports,
        storage, declarations, baseClass,
        TypeSyntaxSequence.Build(typeValues),
        EnumCaseSyntaxSequence.Build(caseValues), FileTypeKind.kClass, false,
        false, false, rootRange, valid);
  }

  static func emptyImports(): ImportSyntaxSequence throws StateError {
    final ImportSyntax?[] values = ImportSyntax?[:0];
    return ImportSyntaxSequence.Build(values);
  }

  static func emptyDeclarations(): DeclarationSyntaxSequence throws StateError {
    final DeclarationSyntax?[] values = DeclarationSyntax?[:0];
    return DeclarationSyntaxSequence.Build(values);
  }

  static func checkSource(): SourceFile {
    return SourceFile.FromBytes("syntax-tree-failure", byte[:16]);
  }

  static func range(SourceFile source, int32 begin,
                    int32 end): SourceRange {
    final var first = SourceLocation(source.GetPath(), begin, 1, 1);
    final var last = SourceLocation(source.GetPath(), end, 1, 1);
    return SourceRange(first, last);
  }
}
