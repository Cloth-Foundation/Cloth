import bootstrap::ParseDiagnosticKindCode;
import frontend.diagnostic::ParseDiagnostic;
import frontend.lexer::Lexer;
import frontend.lexer::LexerResult;
import frontend.parser::DeclarationOutline;
import frontend.parser::DeclarationParser;
import frontend.parser::DeclarationResult;
import frontend.parser::TokenIndexRange;
import frontend.source::SourceFile;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax.declaration::DeclarationKind;
import frontend.syntax.declaration::ParameterSyntax;
import frontend.syntax.tree::EnumCaseSyntax;
import frontend.syntax.tree::FileTypeKind;
import frontend.syntax.tree::ImportKind;
import frontend.syntax.tree::ImportSyntax;
import frontend.syntax.tree::TypeSyntax;
import frontend.syntax.tree::Visibility;

class {
  static func Run(string path,
                  string fileName): int32 throws IoError, StateError {
    final SourceFile source = SourceFile.Load(path);
    final LexerResult lexer = Lexer.Lex(source);
    if (lexer.GetDiagnostics().GetCount() != 0) {
      throw StateError("declaration record input has lexical diagnostics");
    }
    final DeclarationResult result = DeclarationParser.Parse(
        source, lexer.GetTokens(), fileName, "parity");
    writeFile(result);
    writeImports(result);
    writeFileTypes(result);
    writeEnumCases(result);
    writeMembers(result);
    writeDiagnostics(result);
    return 0;
  }

  static func writeFile(DeclarationResult result) throws StateError {
    print("F|");
    writeFlag(result.IsValid());
    print("|");
    writeFlag(result.GetFile().HasExplicitDeclaration());
    print("|");
    print(fileTypeCode(result.GetFile().GetFileTypeKind()));
    print("|");
    writeFlag(result.GetFile().IsAbstract());
    print("|");
    writeFlag(result.GetFile().IsSealed());
    print("|");
    print(visibilityCode(result.GetFile().GetVisibility()));
    print("|");
    writeRange(result.GetFile().GetRange());
    println();
  }

  static func writeImports(DeclarationResult result) throws StateError {
    for (int32 index = 0;
         index < result.GetFile().GetImports().GetCount(); index++) {
      final ImportSyntax value = result.GetFile().GetImports().Get(index);
      print("I|");
      print(index);
      print("|");
      print(importKindCode(value.GetKind()));
      print("|");
      writeFlag(value.IsValid());
      print("|");
      writeRange(value.GetRange());
      print("|");
      writeSpan(value.GetPackageName());
      print("|");
      writeSpan(value.GetTypeName());
      print("|");
      final SourceSpan? alias = value.GetAlias();
      if (alias != null) {
        writeSpan(alias);
      } else {
        writeSpan(value.GetTypeName());
      }
      println();
    }
  }

  static func writeFileTypes(DeclarationResult result) throws StateError {
    final TypeSyntax? baseClass = result.GetFile().GetBaseClass();
    if (baseClass != null) { writeType("B", 0, baseClass); }
    for (int32 index = 0;
         index < result.GetFile().GetInterfaces().GetCount(); index++) {
      writeType("N", index, result.GetFile().GetInterfaces().Get(index));
    }
  }

  static func writeEnumCases(DeclarationResult result) throws StateError {
    for (int32 index = 0;
         index < result.GetFile().GetEnumCases().GetCount(); index++) {
      final EnumCaseSyntax value = result.GetFile().GetEnumCases().Get(index);
      print("E|");
      print(index);
      print("|");
      writeFlag(value.IsValid());
      print("|");
      writeRange(value.GetRange());
      print("|");
      writeSpan(value.GetName());
      println();
    }
  }

  static func writeMembers(DeclarationResult result) throws StateError {
    for (int32 index = 0; index < result.GetMembers().GetCount(); index++) {
      final DeclarationOutline value = result.GetMembers().Get(index);
      print("M|");
      print(index);
      print("|");
      print(declarationKindCode(value.GetKind()));
      print("|");
      writeFlag(value.IsValid());
      print("|");
      print(visibilityCode(value.GetVisibility()));
      print("|");
      writeFlag(value.IsStatic());
      print("|");
      writeFlag(value.IsFinal());
      print("|");
      writeFlag(value.IsOverride());
      print("|");
      writeFlag(value.IsAbstract());
      print("|");
      writeFlag(value.HasExplicitThrows());
      print("|");
      print(value.GetBeginToken());
      print("|");
      writeRange(value.GetRange());
      print("|");
      writeSpan(value.GetName());
      print("|");
      writeInterval(value.GetFieldInitializerTokens());
      print("|");
      writeInterval(value.GetConstructorInitializerTokens());
      print("|");
      writeInterval(value.GetBodyTokens());
      println();

      final TypeSyntax? declaredType = value.GetDeclaredType();
      if (declaredType != null) { writeType("R", index, declaredType); }
      for (int32 parameterIndex = 0;
           parameterIndex < value.GetParameters().GetCount();
           parameterIndex++) {
        writeParameter(index, parameterIndex,
                       value.GetParameters().Get(parameterIndex));
      }
      for (int32 throwIndex = 0;
           throwIndex < value.GetThrowsTypes().GetCount(); throwIndex++) {
        writeMemberType("H", index, throwIndex,
                        value.GetThrowsTypes().Get(throwIndex));
      }
    }
  }

  static func writeParameter(int32 memberIndex, int32 parameterIndex,
                             ParameterSyntax value) throws StateError {
    print("P|");
    print(memberIndex);
    print("|");
    print(parameterIndex);
    print("|");
    writeFlag(value.IsFinal());
    print("|");
    writeRange(value.GetRange());
    print("|");
    writeSpan(value.GetName());
    print("|");
    writeTypeValue(value.GetType());
    println();
  }

  static func writeType(string category, int32 index,
                        TypeSyntax value) throws StateError {
    print(category);
    print("|");
    print(index);
    print("|");
    writeTypeValue(value);
    println();
  }

  static func writeMemberType(string category, int32 memberIndex,
                              int32 index,
                              TypeSyntax value) throws StateError {
    print(category);
    print("|");
    print(memberIndex);
    print("|");
    print(index);
    print("|");
    writeTypeValue(value);
    println();
  }

  static func writeTypeValue(TypeSyntax value) throws StateError {
    writeFlag(value.IsPrimitive());
    print("|");
    writeFlag(value.IsArray());
    print("|");
    writeFlag(value.IsNullable());
    print("|");
    writeFlag(value.IsElementNullable());
    print("|");
    writeRange(value.GetRange());
    print("|");
    writeSpan(value.GetName());
  }

  static func writeDiagnostics(DeclarationResult result) throws StateError {
    for (int32 index = 0; index < result.GetDiagnostics().GetCount(); index++) {
      final ParseDiagnostic value = result.GetDiagnostics().Get(index);
      print("D|");
      print(index);
      print("|");
      print(ParseDiagnosticKindCode.Get(value.GetKind()));
      print("|");
      writeRange(value.GetRange());
      print("|");
      final SourceRange? related = value.GetRelatedRange();
      if (related == null) {
        print("-");
      } else {
        writeRange(related);
      }
      println();
    }
  }

  static func writeRange(SourceRange value) {
    print(value.GetBegin().GetOffset());
    print(",");
    print(value.GetBegin().GetLine());
    print(",");
    print(value.GetBegin().GetColumn());
    print(",");
    print(value.GetEnd().GetOffset());
    print(",");
    print(value.GetEnd().GetLine());
    print(",");
    print(value.GetEnd().GetColumn());
  }

  static func writeSpan(SourceSpan? optional) throws StateError {
    if (optional == null) {
      print("-");
      return;
    }
    final SourceSpan value = optional;
    for (int32 index = 0; index < value.GetLength(); index++) {
      if (index != 0) { print(","); }
      print(value.GetByte(index));
    }
  }

  static func writeInterval(TokenIndexRange? optional) {
    if (optional == null) {
      print("-");
      return;
    }
    final TokenIndexRange value = optional;
    print(value.GetBegin());
    print(",");
    print(value.GetEnd());
  }

  static func writeFlag(bool value) {
    if (value) {
      print(1);
    } else {
      print(0);
    }
  }

  static func declarationKindCode(DeclarationKind kind): int32 {
    if (kind == DeclarationKind.kField) { return 0; }
    if (kind == DeclarationKind.kFunction) { return 1; }
    return 2;
  }

  static func fileTypeCode(FileTypeKind kind): int32 {
    if (kind == FileTypeKind.kClass) { return 0; }
    if (kind == FileTypeKind.kInterface) { return 1; }
    if (kind == FileTypeKind.kEnum) { return 2; }
    if (kind == FileTypeKind.kStruct) { return 3; }
    return 4;
  }

  static func importKindCode(ImportKind kind): int32 {
    if (kind == ImportKind.kType) { return 0; }
    return 1;
  }

  static func visibilityCode(Visibility visibility): int32 {
    if (visibility == Visibility.kPrivate) { return 0; }
    return 1;
  }
}
