import bootstrap::DeclarationSubstrateFixture;
import frontend.diagnostic::ParseDiagnostic;
import frontend.diagnostic::ParseDiagnosticBuilder;
import frontend.diagnostic::ParseDiagnosticKind;
import frontend.parser::DeclarationOutline;
import frontend.parser::DeclarationResult;
import frontend.parser::MemberOutlineBuilder;
import frontend.parser::TokenCursor;
import frontend.parser::TokenIndexRange;
import frontend.parser.storage::EnumCaseSyntaxBuilder;
import frontend.parser.storage::ImportSyntaxBuilder;
import frontend.parser.storage::ParameterSyntaxBuilder;
import frontend.parser.storage::TypeSyntaxBuilder;
import frontend.source::SourceFile;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax.declaration::ParameterSyntax;
import frontend.syntax.tree::EnumCaseSyntax;
import frontend.syntax.tree::ImportKind;
import frontend.syntax.tree::ImportSyntax;
import frontend.syntax.tree::TypeSyntax;
import frontend.token::TokenKind;

class {
  static func Run(): int32 throws StateError {
    final DeclarationSubstrateFixture fixture =
        DeclarationSubstrateFixture.Build();
    final int32 resultStatus = checkResult(fixture);
    if (resultStatus != 0) { return resultStatus; }
    final int32 cursorStatus = checkCursor(fixture);
    if (cursorStatus != 0) { return cursorStatus; }
    return checkBuilders(fixture);
  }

  static func checkResult(
      DeclarationSubstrateFixture fixture): int32 throws StateError {
    final DeclarationResult result = fixture.GetResult();
    final TokenIndexRange? body =
        result.GetMembers().Get(0).GetBodyTokens();
    if (result.GetSource() != fixture.GetSource() ||
        result.GetTokens() != fixture.GetTokens() || !result.IsValid() ||
        result.GetDiagnostics().GetCount() != 0 ||
        result.GetMembers().GetCount() != 1 ||
        body == null || body.GetBegin() != 4 || body.GetEnd() != 6) {
      return 460;
    }
    if (result.GetFile().GetName() != "Fixture" ||
        result.GetFile().GetPackageName() != "bootstrap" ||
        result.GetFile().GetQualifiedName() != "bootstrap.Fixture" ||
        result.GetFile().HasExplicitDeclaration()) {
      return 461;
    }
    final var diagnostics = ParseDiagnosticBuilder();
    diagnostics.Add(ParseDiagnostic(
        ParseDiagnosticKind.kExpectedDeclaration,
        DeclarationSubstrateFixture.NameRange(fixture.GetSource()), null));
    final DeclarationResult invalid = DeclarationResult.Build(
        result.GetSource(), result.GetTokens(), result.GetFile(),
        result.GetMembers(), diagnostics.Finish(), false);
    if (invalid.IsValid() || invalid.GetDiagnostics().GetCount() != 1) {
      return 472;
    }
    return 0;
  }

  static func checkCursor(
      DeclarationSubstrateFixture fixture): int32 throws StateError {
    final var cursor = TokenCursor.Build(
        fixture.GetSource(), fixture.GetTokens());
    if (cursor.GetBegin() != 0 || cursor.GetIndex() != 0 ||
        cursor.GetLimit() != 6 || cursor.AtEnd() ||
        cursor.Current().GetKind() != TokenKind.kKwFunc ||
        cursor.Peek(2147483647).GetKind() != TokenKind.kEof) {
      return 462;
    }
    final int32 checkpoint = cursor.GetIndex();
    if (!cursor.Match(TokenKind.kKwFunc)) { return 463; }
    cursor.RequireProgress(checkpoint);
    if (cursor.GetIndex() != 1 ||
        cursor.Current().GetKind() != TokenKind.kIdentifier) {
      return 464;
    }

    final var slice = cursor.Slice(TokenIndexRange(2, 4));
    if (slice.GetBegin() != 2 || slice.GetLimit() != 4 || slice.AtEnd() ||
        slice.Advance().GetKind() != TokenKind.kLeftParen ||
        slice.Advance().GetKind() != TokenKind.kRightParen ||
        !slice.AtEnd() || slice.Current().GetKind() != TokenKind.kEof ||
        slice.Advance().GetKind() != TokenKind.kEof ||
        slice.GetIndex() != 4) {
      return 465;
    }

    final TokenIndexRange emptyRange = TokenIndexRange(2, 2);
    final var empty = cursor.Slice(emptyRange);
    if (!emptyRange.IsEmpty() || emptyRange.GetLength() != 0 ||
        !empty.AtEnd() || empty.Current().GetKind() != TokenKind.kEof) {
      return 466;
    }
    final TokenIndexRange one = TokenIndexRange(2, 3);
    if (one.IsEmpty() || one.GetLength() != 1) { return 467; }
    return 0;
  }

  static func checkBuilders(
      DeclarationSubstrateFixture fixture): int32 throws StateError {
    final SourceFile source = fixture.GetSource();
    final SourceSpan name = DeclarationSubstrateFixture.NameSpan(source);
    final SourceRange range = DeclarationSubstrateFixture.NameRange(source);
    final var importValue = ImportSyntax(
        ImportKind.kType, null, name, null, range, true);
    final var typeValue = TypeSyntax(
        name, range, true, false, false, false, false);
    final var parameterValue = ParameterSyntax(
        typeValue, name, true, range, true);
    final var enumValue = EnumCaseSyntax(name, range, true);
    final var diagnosticValue = ParseDiagnostic(
        ParseDiagnosticKind.kExpectedDeclaration, range, null);
    final DeclarationOutline member = fixture.GetResult().GetMembers().Get(0);

    final var imports = ImportSyntaxBuilder();
    final var types = TypeSyntaxBuilder();
    final var parameters = ParameterSyntaxBuilder();
    final var enumCases = EnumCaseSyntaxBuilder();
    final var diagnostics = ParseDiagnosticBuilder();
    final var members = MemberOutlineBuilder();
    for (int32 index = 0; index < 65; index++) {
      imports.Add(importValue);
      types.Add(typeValue);
      parameters.Add(parameterValue);
      enumCases.Add(enumValue);
      diagnostics.Add(diagnosticValue);
      members.Add(member);
    }

    final var importValues = imports.Finish();
    final var typeValues = types.Finish();
    final var parameterValues = parameters.Finish();
    final var enumValues = enumCases.Finish();
    final var diagnosticValues = diagnostics.Finish();
    final var memberValues = members.Finish();
    if (!imports.IsFinished() || !types.IsFinished() ||
        !parameters.IsFinished() || !enumCases.IsFinished() ||
        !diagnostics.IsFinished() || !members.IsFinished()) {
      return 468;
    }
    if (importValues.GetCount() != 65 || typeValues.GetCount() != 65 ||
        parameterValues.GetCount() != 65 || enumValues.GetCount() != 65 ||
        diagnosticValues.GetCount() != 65 ||
        memberValues.GetCount() != 65) {
      return 469;
    }
    if (importValues.Get(64) != importValue ||
        typeValues.Get(64) != typeValue ||
        parameterValues.Get(64) != parameterValue ||
        enumValues.Get(64) != enumValue ||
        diagnosticValues.Get(64) != diagnosticValue ||
        memberValues.Get(64) != member) {
      return 470;
    }
    return 0;
  }
}
