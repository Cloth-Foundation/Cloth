import frontend.diagnostic::LexDiagnosticKind;

class {
  static func Get(LexDiagnosticKind kind): int32 {
    switch (kind) {
      case LexDiagnosticKind.kUnexpectedByte: { return 0; }
      case LexDiagnosticKind.kUnterminatedBlockComment: { return 1; }
      case LexDiagnosticKind.kInvalidNumericCore: { return 2; }
      case LexDiagnosticKind.kInvalidNumericSuffix: { return 3; }
      case LexDiagnosticKind.kIntegerSuffixOnFloatingCore: { return 4; }
      case LexDiagnosticKind.kMissingBaseDigits: { return 5; }
      case LexDiagnosticKind.kInvalidBaseDigit: { return 6; }
      case LexDiagnosticKind.kInvalidBasePrefix: { return 7; }
      case LexDiagnosticKind.kUnknownBasePrefix: { return 8; }
      case LexDiagnosticKind.kInvalidDigitSeparator: { return 9; }
      case LexDiagnosticKind.kMissingExponentDigits: { return 10; }
      case LexDiagnosticKind.kFloatingSuffixOnNonDecimalCore: { return 11; }
      case LexDiagnosticKind.kUnterminatedStringLiteral: { return 12; }
      case LexDiagnosticKind.kUnterminatedCharacterLiteral: { return 13; }
      case LexDiagnosticKind.kMalformedStringLiteral: { return 14; }
      case LexDiagnosticKind.kMalformedCharacterLiteral: { return 15; }
      case LexDiagnosticKind.kInvalidUtf8: { return 16; }
      case LexDiagnosticKind.kUnknownEscape: { return 17; }
      case LexDiagnosticKind.kInvalidUnicodeEscape: { return 18; }
      case LexDiagnosticKind.kInvalidUnicodeScalar: { return 19; }
      case LexDiagnosticKind.kEmptyCharacterLiteral: { return 20; }
      case LexDiagnosticKind.kMultipleCharacterLiteral: { return 21; }
    }
  }
}
