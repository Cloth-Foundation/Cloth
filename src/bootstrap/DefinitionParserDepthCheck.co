import frontend.lexer::Lexer;
import frontend.lexer::LexerResult;
import frontend.parser::DeclarationParser;
import frontend.parser::DeclarationResult;
import frontend.parser::DefinitionParser;
import frontend.parser::DefinitionResult;
import frontend.source::SourceFile;

class {
  static func Run(): int32 throws StateError {
    final int32 depth = 4096;
    final SourceFile source = SourceFile.FromBytes(
        "definition-depth", nestedBlocks(depth));
    final LexerResult lexer = Lexer.Lex(source);
    if (lexer.GetDiagnostics().GetCount() != 0) { return 570; }
    final DeclarationResult declaration = DeclarationParser.Parse(
        source, lexer.GetTokens(), "Depth", "bootstrap.parser");
    if (!declaration.IsValid()) { return 571; }
    final DefinitionResult definition =
        DefinitionParser.Parse(declaration, null);
    if (!definition.IsValid() ||
        definition.GetTree().GetFile().GetStorage().GetNodeCount() !=
            depth * 2 + 1) {
      return 572;
    }
    return 0;
  }

  static func nestedBlocks(int32 depth): byte[] {
    final byte[] bytes = byte[:depth * 2 + 19];
    bytes[0] = byte(102);
    bytes[1] = byte(117);
    bytes[2] = byte(110);
    bytes[3] = byte(99);
    bytes[4] = byte(32);
    bytes[5] = byte(82);
    bytes[6] = byte(117);
    bytes[7] = byte(110);
    bytes[8] = byte(40);
    bytes[9] = byte(41);
    bytes[10] = byte(58);
    bytes[11] = byte(32);
    bytes[12] = byte(118);
    bytes[13] = byte(111);
    bytes[14] = byte(105);
    bytes[15] = byte(100);
    bytes[16] = byte(32);
    bytes[17] = byte(123);
    for (int32 index = 0; index < depth; index++) {
      bytes[18 + index] = byte(123);
      bytes[18 + depth + index] = byte(125);
    }
    bytes[bytes::length - 1] = byte(125);
    return bytes;
  }
}
