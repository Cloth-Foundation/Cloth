import frontend.diagnostic::ParseDiagnosticKind;
import frontend.lexer::Lexer;
import frontend.lexer::LexerResult;
import frontend.parser::DeclarationParser;
import frontend.parser::DeclarationResult;
import frontend.parser::DefinitionParser;
import frontend.parser::DefinitionResult;
import frontend.source::SourceFile;
import frontend.syntax::BlockId;
import frontend.syntax::StatementId;
import frontend.syntax.declaration::ConstructorSyntax;
import frontend.syntax.declaration::DeclarationKind;
import frontend.syntax.declaration::FunctionSyntax;
import frontend.syntax.statement::BlockNodeSyntax;
import frontend.syntax.statement::ForEachStatementSyntax;
import frontend.syntax.statement::ForStatementSyntax;
import frontend.syntax.statement::IfStatementSyntax;
import frontend.syntax.statement::StatementKind;
import frontend.syntax.statement::SwitchStatementSyntax;
import frontend.syntax.statement::WhileStatementSyntax;
import frontend.syntax.storage::SyntaxStorage;
import frontend.syntax.tree::FileSyntax;

class {
  static func Run(): int32 throws IoError, StateError {
    final DefinitionResult valid = parse(
        "testdata/parser/DefinitionValid.co", "DefinitionValid");
    if (!valid.IsValid() || valid.GetDiagnostics().GetCount() != 0) {
      return 560;
    }
    final FileSyntax file = valid.GetTree().GetFile();
    if (!file.GetStorage().IsSealed() ||
        file.GetDeclarations().GetCount() != 3 ||
        file.GetDeclarations().Get(0).GetDeclarationKind() !=
            DeclarationKind.kField ||
        file.GetDeclarations().Get(1).GetDeclarationKind() !=
            DeclarationKind.kFunction ||
        file.GetDeclarations().Get(2).GetDeclarationKind() !=
            DeclarationKind.kConstructor) {
      return 561;
    }
    final FunctionSyntax? function =
        file.GetDeclarations().Get(1) as FunctionSyntax?;
    if (function == null || !checkStatements(file.GetStorage(),
                                              function.GetBody())) {
      return 562;
    }
    final ConstructorSyntax? constructor =
        file.GetDeclarations().Get(2) as ConstructorSyntax?;
    if (constructor == null || constructor.GetInitializer() == null ||
        constructor.GetInitializer()!.GetArguments().GetCount() != 1) {
      return 563;
    }

    final DefinitionResult abstractFile = parse(
        "testdata/parser/explicit.co", "Explicit");
    final FunctionSyntax? abstractFunction = abstractFile.GetTree()
        .GetFile().GetDeclarations().Get(0) as FunctionSyntax?;
    if (!abstractFile.IsValid() || abstractFunction == null ||
        !abstractFunction.IsAbstract() ||
        !abstractFile.GetTree().GetFile().GetStorage()
            .GetBlock(abstractFunction.GetBody()).IsValid() ||
        abstractFile.GetTree().GetFile().GetStorage()
            .GetBlock(abstractFunction.GetBody()).GetRange()
            .GetBegin().GetOffset() != abstractFunction.GetRange()
            .GetEnd().GetOffset()) {
      return 564;
    }

    final DefinitionResult interfaceFile = parse(
        "testdata/parser/interface.co", "Contract");
    if (!interfaceFile.IsValid() ||
        interfaceFile.GetTree().GetFile().GetDeclarations().GetCount() != 1) {
      return 565;
    }

    final DefinitionResult declarationFailure = parse(
        "testdata/parser/enum_duplicate.co", "Color");
    if (declarationFailure.IsValid() ||
        declarationFailure.GetDiagnostics().GetCount() != 1 ||
        declarationFailure.GetDiagnostics().Get(0).GetKind() !=
            ParseDiagnosticKind.kDuplicateEnumCase ||
        declarationFailure.GetDiagnostics().Get(0) !=
            declarationFailure.GetDeclaration().GetDiagnostics().Get(0)) {
      return 566;
    }

    final DefinitionResult recovery = parse(
        "testdata/parser/definition_recovery.co", "DefinitionRecovery");
    if (recovery.IsValid() || recovery.GetDiagnostics().GetCount() < 2 ||
        recovery.GetTree().GetFile().GetDeclarations().GetCount() != 2 ||
        recovery.GetTree().GetFile().GetDeclarations().Get(1).IsValid() ==
            false) {
      return 567;
    }
    return 0;
  }

  static func checkStatements(SyntaxStorage storage,
                              BlockId body): bool throws StateError {
    final BlockNodeSyntax? block =
        storage.GetBlock(body) as BlockNodeSyntax?;
    if (block == null || block.GetStatements().GetCount() != 9) {
      return false;
    }
    if (kind(storage, block.GetStatements().Get(0)) !=
            StatementKind.kLocalVariable ||
        kind(storage, block.GetStatements().Get(1)) !=
            StatementKind.kLocalVariable ||
        kind(storage, block.GetStatements().Get(2)) !=
            StatementKind.kNestedBlock ||
        !(storage.GetStatement(block.GetStatements().Get(3)) is
          IfStatementSyntax) ||
        !(storage.GetStatement(block.GetStatements().Get(4)) is
          WhileStatementSyntax) ||
        !(storage.GetStatement(block.GetStatements().Get(5)) is
          ForEachStatementSyntax) ||
        !(storage.GetStatement(block.GetStatements().Get(6)) is
          ForStatementSyntax) ||
        !(storage.GetStatement(block.GetStatements().Get(7)) is
          SwitchStatementSyntax) ||
        kind(storage, block.GetStatements().Get(8)) !=
            StatementKind.kReturn) {
      return false;
    }
    return true;
  }

  static func kind(SyntaxStorage storage,
                   StatementId id): StatementKind throws StateError {
    return storage.GetStatement(id).GetStatementKind();
  }

  static func parse(string path,
                    string name): DefinitionResult throws IoError, StateError {
    final SourceFile source = SourceFile.Load(path);
    final LexerResult lexer = Lexer.Lex(source);
    if (lexer.GetDiagnostics().GetCount() != 0) {
      throw StateError("definition parser fixture has lexical diagnostics");
    }
    final DeclarationResult declaration = DeclarationParser.Parse(
        source, lexer.GetTokens(), name, "bootstrap.parser");
    return DefinitionParser.Parse(declaration, null);
  }
}
