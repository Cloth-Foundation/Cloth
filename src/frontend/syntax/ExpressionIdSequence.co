import frontend.syntax::ExpressionId;
import frontend.syntax.storage::SyntaxHandleSequence;

class {
  final SyntaxHandleSequence values;

  ExpressionIdSequence(SyntaxHandleSequence values) {
    self.values = values;
  }

  func Get(int32 index): ExpressionId throws StateError {
    final ExpressionId? value = self.values.Get(index) as ExpressionId?;
    if (value == null) {
      throw StateError("syntax child is not an expression handle");
    }
    return value;
  }

  func GetCount(): int32 {
    return self.values.GetCount();
  }
}
