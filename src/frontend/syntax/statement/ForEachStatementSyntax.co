import frontend.source::SourceRange;
import frontend.syntax::BlockId;
import frontend.syntax::ExpressionId;
import frontend.syntax::StatementSyntax;
import frontend.syntax::SyntaxNodeData;
import frontend.syntax.statement::ForVariableSyntax;
import frontend.syntax.statement::StatementKind;

class is StatementSyntax {
  final SyntaxNodeData node;
  final ForVariableSyntax variable;
  final ExpressionId iterable;
  final BlockId body;

  ForEachStatementSyntax(ForVariableSyntax variable, ExpressionId iterable,
                         BlockId body, SourceRange range,
                         bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.variable = variable;
    self.iterable = iterable;
    self.body = body;
  }

  func GetVariable(): ForVariableSyntax { return self.variable; }
  func GetIterable(): ExpressionId { return self.iterable; }
  func GetBody(): BlockId { return self.body; }
  override func GetStatementKind(): StatementKind {
    return StatementKind.kForEach;
  }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
