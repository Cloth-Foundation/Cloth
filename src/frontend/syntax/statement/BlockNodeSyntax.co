import frontend.source::SourceRange;
import frontend.syntax::BlockSyntax;
import frontend.syntax::StatementIdSequence;
import frontend.syntax::SyntaxNodeData;

class is BlockSyntax {
  final SyntaxNodeData node;
  final StatementIdSequence statements;

  BlockNodeSyntax(StatementIdSequence statements, SourceRange range,
                  bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.statements = statements;
  }

  func GetStatements(): StatementIdSequence { return self.statements; }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
