import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax::ExpressionId;
import frontend.syntax::StatementSyntax;
import frontend.syntax::SyntaxNodeData;
import frontend.syntax.statement::StatementKind;
import frontend.syntax.tree::TypeSyntax;

class is StatementSyntax {
  final SyntaxNodeData node;
  final TypeSyntax? type;
  final SourceSpan name;
  final ExpressionId? initializer;
  final bool finalBinding;

  LocalVariableStatementSyntax(TypeSyntax? type, SourceSpan name,
                               ExpressionId? initializer, bool finalBinding,
                               SourceRange range,
                               bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.type = type;
    self.name = name;
    self.initializer = initializer;
    self.finalBinding = finalBinding;
  }

  func GetType(): TypeSyntax? { return self.type; }
  func GetName(): SourceSpan { return self.name; }
  func GetInitializer(): ExpressionId? { return self.initializer; }
  func IsFinal(): bool { return self.finalBinding; }
  override func GetStatementKind(): StatementKind {
    return StatementKind.kLocalVariable;
  }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
