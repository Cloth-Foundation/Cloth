import frontend.source::SourceRange;
import frontend.syntax::BlockId;
import frontend.syntax::ExpressionId;
import frontend.syntax::StatementSyntax;
import frontend.syntax::SyntaxNodeData;
import frontend.syntax.statement::StatementKind;

class is StatementSyntax {
  final SyntaxNodeData node;
  final ExpressionId condition;
  final BlockId thenBlock;
  final BlockId? elseBlock;

  IfStatementSyntax(ExpressionId condition, BlockId thenBlock,
                    BlockId? elseBlock, SourceRange range,
                    bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.condition = condition;
    self.thenBlock = thenBlock;
    self.elseBlock = elseBlock;
  }

  func GetCondition(): ExpressionId { return self.condition; }
  func GetThenBlock(): BlockId { return self.thenBlock; }
  func GetElseBlock(): BlockId? { return self.elseBlock; }
  override func GetStatementKind(): StatementKind {
    return StatementKind.kIf;
  }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
