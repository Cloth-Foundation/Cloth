import frontend.source::SourceRange;
import frontend.syntax::BlockId;
import frontend.syntax::BlockSyntax;
import frontend.syntax::ExpressionId;
import frontend.syntax::ExpressionIdSequence;
import frontend.syntax::StatementId;
import frontend.syntax::StatementSyntax;
import frontend.syntax::SyntaxNode;
import frontend.syntax.expression::SyntaxExpressionVerifier;
import frontend.syntax.statement::BlockNodeSyntax;
import frontend.syntax.statement::BreakStatementSyntax;
import frontend.syntax.statement::ContinueStatementSyntax;
import frontend.syntax.statement::ExpressionStatementSyntax;
import frontend.syntax.statement::ForEachStatementSyntax;
import frontend.syntax.statement::ForStatementSyntax;
import frontend.syntax.statement::ForVariableSyntax;
import frontend.syntax.statement::IfStatementSyntax;
import frontend.syntax.statement::InvalidStatementSyntax;
import frontend.syntax.statement::LocalVariableStatementSyntax;
import frontend.syntax.statement::NestedBlockStatementSyntax;
import frontend.syntax.statement::ReturnStatementSyntax;
import frontend.syntax.statement::StatementKind;
import frontend.syntax.statement::StatementVerificationFrame;
import frontend.syntax.statement::StatementVerificationFrameKind;
import frontend.syntax.statement::SwitchArmSyntax;
import frontend.syntax.statement::SwitchArmSyntaxSequence;
import frontend.syntax.statement::SwitchStatementSyntax;
import frontend.syntax.statement::WhileStatementSyntax;
import frontend.syntax.tree::SyntaxVerificationContext;
import frontend.syntax.tree::TypeSyntax;

class {
  final SyntaxVerificationContext context;
  final SyntaxExpressionVerifier expressions;
  StatementVerificationFrame? top;

  SyntaxStatementVerifier(SyntaxVerificationContext context,
                          SyntaxExpressionVerifier expressions) {
    self.context = context;
    self.expressions = expressions;
    self.top = null;
  }

  func VerifyStatement(StatementId id,
                       SourceRange parent): bool throws StateError {
    self.requireIdle();
    self.top = StatementVerificationFrame.Statement(
        null, id, parent, false);
    self.run();
    return self.context.GetStorage().GetStatement(id).IsValid();
  }

  func VerifyBlock(BlockId id, SourceRange parent,
                   bool parentValid): bool throws StateError {
    self.requireIdle();
    self.top = StatementVerificationFrame.Block(
        null, id, parent, parentValid);
    self.run();
    return self.context.GetStorage().GetBlock(id).IsValid();
  }

  func run(): void throws StateError {
    while (self.top != null) {
      final StatementVerificationFrame frame = self.top!;
      self.top = frame.GetPrevious();
      if (frame.GetKind() == StatementVerificationFrameKind.kBlock) {
        self.verifyBlock(frame);
      } else {
        self.verifyStatement(frame);
      }
    }
  }

  func verifyBlock(StatementVerificationFrame frame): void throws StateError {
    final BlockId id = self.requireBlock(frame);
    final bool fresh = self.context.BeginBlock(id);
    final BlockSyntax block = self.context.GetStorage().GetBlock(id);
    if (frame.IsParentValid() && block.IsValid()) {
      self.context.VerifyRange(block.GetRange(), frame.GetParent());
    } else {
      self.context.VerifySourceRange(block.GetRange());
    }
    self.context.VerifyChildValidity(frame.IsParentValid(), block.IsValid());
    final BlockNodeSyntax? value = block as BlockNodeSyntax?;
    if (value == null) {
      throw StateError("block handle does not contain a block node");
    }
    if (!fresh) { return; }
    for (int32 index = value.GetStatements().GetCount() - 1;
         index >= 0; index--) {
      self.pushStatement(value.GetStatements().Get(index), block.GetRange(),
                         block.IsValid());
    }
  }

  func verifyStatement(
      StatementVerificationFrame frame): void throws StateError {
    final StatementId id = self.requireStatement(frame);
    final bool fresh = self.context.BeginStatement(id);
    final StatementSyntax statement =
        self.context.GetStorage().GetStatement(id);
    if (frame.IsParentValid() && statement.IsValid()) {
      self.context.VerifyRange(statement.GetRange(), frame.GetParent());
    } else {
      self.context.VerifySourceRange(statement.GetRange());
    }
    self.context.VerifyChildValidity(frame.IsParentValid(),
                                     statement.IsValid());
    if (!fresh) { return; }

    switch (statement.GetStatementKind()) {
      case StatementKind.kInvalid: {
        if (!(statement is InvalidStatementSyntax) || statement.IsValid()) {
          self.kindMismatch();
        }
      }
      case StatementKind.kLocalVariable: { self.verifyLocal(statement); }
      case StatementKind.kReturn: {
        final ReturnStatementSyntax? value =
            statement as ReturnStatementSyntax?;
        if (value == null) { self.kindMismatch(); return; }
        final ExpressionId? result = value.GetValue();
        if (result != null) { self.verifyExpression(statement, result); }
      }
      case StatementKind.kExpression: {
        final ExpressionStatementSyntax? value =
            statement as ExpressionStatementSyntax?;
        if (value == null) { self.kindMismatch(); return; }
        self.verifyExpression(statement, value.GetExpression());
      }
      case StatementKind.kIf: {
        final IfStatementSyntax? value = statement as IfStatementSyntax?;
        if (value == null) { self.kindMismatch(); return; }
        self.verifyExpression(statement, value.GetCondition());
        final BlockId? alternative = value.GetElseBlock();
        if (alternative != null) {
          self.pushBlock(alternative, statement.GetRange(),
                         statement.IsValid());
        }
        self.pushBlock(value.GetThenBlock(), statement.GetRange(),
                       statement.IsValid());
      }
      case StatementKind.kWhile: {
        final WhileStatementSyntax? value = statement as WhileStatementSyntax?;
        if (value == null) { self.kindMismatch(); return; }
        self.verifyExpression(statement, value.GetCondition());
        self.pushBlock(value.GetBody(), statement.GetRange(),
                       statement.IsValid());
      }
      case StatementKind.kForEach: { self.verifyForEach(statement); }
      case StatementKind.kFor: { self.verifyFor(statement); }
      case StatementKind.kSwitch: { self.verifySwitch(statement); }
      case StatementKind.kBreak: {
        if (!(statement is BreakStatementSyntax)) { self.kindMismatch(); }
      }
      case StatementKind.kContinue: {
        if (!(statement is ContinueStatementSyntax)) { self.kindMismatch(); }
      }
      case StatementKind.kNestedBlock: {
        final NestedBlockStatementSyntax? value =
            statement as NestedBlockStatementSyntax?;
        if (value == null) { self.kindMismatch(); return; }
        self.pushBlock(value.GetBlock(), statement.GetRange(),
                       statement.IsValid());
      }
    }
  }

  func verifyLocal(StatementSyntax statement): void throws StateError {
    final LocalVariableStatementSyntax? value =
        statement as LocalVariableStatementSyntax?;
    if (value == null) { self.kindMismatch(); return; }
    self.context.VerifySpan(value.GetName(), statement.GetRange(),
                            !statement.IsValid());
    final TypeSyntax? type = value.GetType();
    if (type != null) { self.verifyType(statement, type); }
    final ExpressionId? initializer = value.GetInitializer();
    if (initializer != null) {
      self.verifyExpression(statement, initializer);
    }
  }

  func verifyForEach(StatementSyntax statement): void throws StateError {
    final ForEachStatementSyntax? value =
        statement as ForEachStatementSyntax?;
    if (value == null) { self.kindMismatch(); return; }
    final ForVariableSyntax variable = value.GetVariable();
    self.context.VerifyRange(variable.GetRange(), statement.GetRange());
    self.context.VerifySpan(variable.GetName(), variable.GetRange(),
                            !variable.IsValid());
    final TypeSyntax? type = variable.GetType();
    if (type != null) {
      final bool valid = self.context.VerifyType(type, variable.GetRange());
      self.context.VerifyChildValidity(variable.IsValid(), valid);
    }
    self.context.VerifyChildValidity(statement.IsValid(), variable.IsValid());
    self.verifyExpression(statement, value.GetIterable());
    self.pushBlock(value.GetBody(), statement.GetRange(), statement.IsValid());
  }

  func verifyFor(StatementSyntax statement): void throws StateError {
    final ForStatementSyntax? value = statement as ForStatementSyntax?;
    if (value == null) { self.kindMismatch(); return; }
    final StatementId? initializer = value.GetInitializer();
    if (initializer != null) {
      final StatementKind kind = self.context.GetStorage()
          .GetStatement(initializer).GetStatementKind();
      if (kind != StatementKind.kLocalVariable &&
          kind != StatementKind.kExpression) {
        throw StateError("for initializer has an invalid statement kind");
      }
      self.pushStatement(initializer, statement.GetRange(),
                         statement.IsValid());
    }
    final ExpressionId? condition = value.GetCondition();
    if (condition != null) { self.verifyExpression(statement, condition); }
    self.verifyExpressions(statement, value.GetUpdates());
    self.pushBlock(value.GetBody(), statement.GetRange(), statement.IsValid());
  }

  func verifySwitch(StatementSyntax statement): void throws StateError {
    final SwitchStatementSyntax? value =
        statement as SwitchStatementSyntax?;
    if (value == null) { self.kindMismatch(); return; }
    self.verifyExpression(statement, value.GetSelector());
    final SwitchArmSyntaxSequence arms = value.GetArms();
    int32 defaults = 0;
    for (int32 index = 0; index < arms.GetCount(); index++) {
      final SwitchArmSyntax arm = arms.Get(index);
      self.context.VerifyRange(arm.GetRange(), statement.GetRange());
      if (arm.IsDefault()) { defaults++; }
      self.verifyExpressions(arm, arm.GetLabels());
      self.context.VerifyChildValidity(statement.IsValid(), arm.IsValid());
    }
    if (defaults > 1 && statement.IsValid()) {
      throw StateError("switch syntax contains multiple default arms");
    }
    for (int32 index = arms.GetCount() - 1; index >= 0; index--) {
      final SwitchArmSyntax arm = arms.Get(index);
      self.pushBlock(arm.GetBody(), arm.GetRange(), arm.IsValid());
    }
  }

  func verifyExpressions(SyntaxNode parent,
                         ExpressionIdSequence values): void throws StateError {
    for (int32 index = 0; index < values.GetCount(); index++) {
      final bool valid = self.expressions.Verify(
          values.Get(index), parent.GetRange());
      self.context.VerifyChildValidity(parent.IsValid(), valid);
    }
  }

  func verifyExpression(StatementSyntax parent,
                        ExpressionId id): void throws StateError {
    final bool valid = self.expressions.Verify(id, parent.GetRange());
    self.context.VerifyChildValidity(parent.IsValid(), valid);
  }

  func verifyType(StatementSyntax parent,
                  TypeSyntax type): void throws StateError {
    final bool valid = self.context.VerifyType(type, parent.GetRange());
    self.context.VerifyChildValidity(parent.IsValid(), valid);
  }

  func pushStatement(StatementId id, SourceRange parent,
                     bool parentValid): void {
    self.top = StatementVerificationFrame.Statement(
        self.top, id, parent, parentValid);
  }

  func pushBlock(BlockId id, SourceRange parent, bool parentValid): void {
    self.top = StatementVerificationFrame.Block(
        self.top, id, parent, parentValid);
  }

  func requireIdle(): void throws StateError {
    if (self.top != null) {
      throw StateError("statement verifier is already active");
    }
  }

  func requireStatement(
      StatementVerificationFrame frame): StatementId throws StateError {
    final StatementId? value = frame.GetStatement();
    if (value == null) {
      throw StateError("statement verification frame has no statement");
    }
    return value;
  }

  func requireBlock(
      StatementVerificationFrame frame): BlockId throws StateError {
    final BlockId? value = frame.GetBlock();
    if (value == null) {
      throw StateError("statement verification frame has no block");
    }
    return value;
  }

  func kindMismatch(): void throws StateError {
    throw StateError("statement kind does not match its node type");
  }
}
