import frontend.source::SourceRange;
import frontend.source::SourceSpan;

struct {
  final SourceRange range;
  final bool valid;

  SyntaxNodeData(SourceRange range, bool valid) {
    self.range = range;
    self.valid = valid;
  }

  func Contains(SourceSpan span): bool {
    return span.GetSource().GetPath() == self.range.GetBegin().GetFile() &&
        span.GetBeginOffset() >= self.range.GetBegin().GetOffset() &&
        span.GetEndOffset() <= self.range.GetEnd().GetOffset();
  }

  func GetRange(): SourceRange { return self.range; }
  func IsValid(): bool { return self.valid; }
}
