import frontend.source::SourceRange;
import frontend.syntax::ExpressionId;
import frontend.syntax::ExpressionSyntax;
import frontend.syntax.expression::ArrayConstructionExpressionSyntax;
import frontend.syntax.expression::ArrayLiteralExpressionSyntax;
import frontend.syntax.expression::AssignmentExpressionSyntax;
import frontend.syntax.expression::BinaryExpressionSyntax;
import frontend.syntax.expression::CallExpressionSyntax;
import frontend.syntax.expression::CheckedCastExpressionSyntax;
import frontend.syntax.expression::ExpressionKind;
import frontend.syntax.expression::ExpressionVerificationFrame;
import frontend.syntax.expression::IdentifierExpressionSyntax;
import frontend.syntax.expression::IndexExpressionSyntax;
import frontend.syntax.expression::IntegerConversionExpressionSyntax;
import frontend.syntax.expression::InvalidExpressionSyntax;
import frontend.syntax.expression::LiteralExpressionSyntax;
import frontend.syntax.expression::MemberAccessExpressionSyntax;
import frontend.syntax.expression::MetaAccessExpressionSyntax;
import frontend.syntax.expression::NullAssertExpressionSyntax;
import frontend.syntax.expression::NullCoalesceExpressionSyntax;
import frontend.syntax.expression::NumericConversionExpressionSyntax;
import frontend.syntax.expression::ParenthesizedExpressionSyntax;
import frontend.syntax.expression::SafeMemberAccessExpressionSyntax;
import frontend.syntax.expression::SafeMetaAccessExpressionSyntax;
import frontend.syntax.expression::SuperExpressionSyntax;
import frontend.syntax.expression::ThrowExpressionSyntax;
import frontend.syntax.expression::TypeTestExpressionSyntax;
import frontend.syntax.expression::UnaryExpressionSyntax;
import frontend.syntax.expression::UpdateExpressionSyntax;
import frontend.syntax.tree::SyntaxVerificationContext;
import frontend.syntax.tree::TypeSyntax;

class {
  final SyntaxVerificationContext context;

  SyntaxExpressionVerifier(SyntaxVerificationContext context) {
    self.context = context;
  }

  func Verify(ExpressionId id,
              SourceRange parent): bool throws StateError {
    ExpressionVerificationFrame? top =
        ExpressionVerificationFrame(id, parent, null);
    bool completed = false;
    bool completedValid = false;
    while (top != null) {
      final ExpressionVerificationFrame frame = top;
      if (frame.GetState() == 0) {
        final bool fresh = self.context.BeginExpression(frame.GetId());
        final ExpressionSyntax expression =
            self.context.GetStorage().GetExpression(frame.GetId());
        if (expression.IsValid()) {
          self.context.VerifyRange(expression.GetRange(),
                                   frame.GetParentRange());
        } else {
          self.context.VerifySourceRange(expression.GetRange());
        }
        frame.SetExpression(expression);
        if (!fresh) {
          top = frame.GetPrevious();
          completed = true;
          completedValid = expression.IsValid();
          continue;
        }
        self.verifyPayload(expression);
        frame.SetChildCount(self.childCount(expression));
        frame.SetState(1);
        continue;
      }
      final ExpressionSyntax expression = self.requireExpression(frame);
      if (frame.GetState() == 1) {
        if (frame.GetChildIndex() >= frame.GetChildCount()) {
          top = frame.GetPrevious();
          completed = true;
          completedValid = expression.IsValid();
          continue;
        }
        final ExpressionId child =
            self.childAt(expression, frame.GetChildIndex());
        frame.AdvanceChild();
        frame.SetState(2);
        top = ExpressionVerificationFrame(child, expression.GetRange(), frame);
        continue;
      }
      if (!completed) {
        throw StateError("expression verifier has no child result");
      }
      self.context.VerifyChildValidity(expression.IsValid(), completedValid);
      completed = false;
      frame.SetState(1);
    }
    if (!completed) {
      throw StateError("expression verifier produced no result");
    }
    return completedValid;
  }

  func verifyPayload(ExpressionSyntax expression): void throws StateError {
    final ExpressionKind kind = expression.GetExpressionKind();
    if (kind == ExpressionKind.kInvalid) {
      if (!(expression is InvalidExpressionSyntax) || expression.IsValid()) {
        self.kindMismatch();
      }
      return;
    }
    if (kind == ExpressionKind.kIdentifier) {
      final IdentifierExpressionSyntax? value =
          expression as IdentifierExpressionSyntax?;
      if (value == null) { self.kindMismatch(); return; }
      self.context.VerifySpan(value.GetName(), expression.GetRange(),
                              !expression.IsValid());
      return;
    }
    if (kind == ExpressionKind.kLiteral) {
      final LiteralExpressionSyntax? value =
          expression as LiteralExpressionSyntax?;
      if (value == null) { self.kindMismatch(); return; }
      self.context.VerifySpan(value.GetLexeme(), expression.GetRange(),
                              !expression.IsValid());
      return;
    }
    if (kind == ExpressionKind.kSuper) {
      if (!(expression is SuperExpressionSyntax)) { self.kindMismatch(); }
      return;
    }
    if (kind == ExpressionKind.kThrow) {
      self.requireThrow(expression);
      return;
    }
    if (kind == ExpressionKind.kUnary) {
      self.requireUnary(expression);
      return;
    }
    if (kind == ExpressionKind.kUpdate) {
      self.requireUpdate(expression);
      return;
    }
    if (kind == ExpressionKind.kBinary) {
      self.requireBinary(expression);
      return;
    }
    if (kind == ExpressionKind.kTypeTest) {
      self.verifyType(expression, self.requireTypeTest(expression).GetTarget());
      return;
    }
    if (kind == ExpressionKind.kCheckedCast) {
      self.verifyType(expression,
                      self.requireCheckedCast(expression).GetTarget());
      return;
    }
    if (kind == ExpressionKind.kNumericConversion) {
      self.verifyType(expression,
                      self.requireNumericConversion(expression).GetTarget());
      return;
    }
    if (kind == ExpressionKind.kIntegerConversion) {
      final IntegerConversionExpressionSyntax value =
          self.requireIntegerConversion(expression);
      self.verifyType(expression, value.GetTarget());
      self.context.VerifySpan(value.GetOperation(), expression.GetRange(),
                              !expression.IsValid());
      return;
    }
    if (kind == ExpressionKind.kAssignment) {
      self.requireAssignment(expression);
      return;
    }
    if (kind == ExpressionKind.kMemberAccess) {
      final MemberAccessExpressionSyntax value = self.requireMember(expression);
      self.context.VerifySpan(value.GetMember(), expression.GetRange(),
                              !expression.IsValid());
      return;
    }
    if (kind == ExpressionKind.kMetaAccess) {
      final MetaAccessExpressionSyntax value = self.requireMeta(expression);
      self.context.VerifySpan(value.GetMeta(), expression.GetRange(),
                              !expression.IsValid());
      return;
    }
    if (kind == ExpressionKind.kSafeMemberAccess) {
      final SafeMemberAccessExpressionSyntax value =
          self.requireSafeMember(expression);
      self.context.VerifySpan(value.GetMember(), expression.GetRange(),
                              !expression.IsValid());
      return;
    }
    if (kind == ExpressionKind.kSafeMetaAccess) {
      final SafeMetaAccessExpressionSyntax value =
          self.requireSafeMeta(expression);
      self.context.VerifySpan(value.GetMeta(), expression.GetRange(),
                              !expression.IsValid());
      return;
    }
    if (kind == ExpressionKind.kNullCoalesce) {
      self.requireCoalesce(expression);
      return;
    }
    if (kind == ExpressionKind.kNullAssert) {
      self.requireAssert(expression);
      return;
    }
    if (kind == ExpressionKind.kCall) { self.requireCall(expression); return; }
    if (kind == ExpressionKind.kArrayLiteral) {
      self.requireArray(expression);
      return;
    }
    if (kind == ExpressionKind.kArrayConstruction) {
      self.verifyType(expression,
                      self.requireArrayConstruction(expression)
                          .GetElementType());
      return;
    }
    if (kind == ExpressionKind.kIndex) {
      self.requireIndex(expression);
      return;
    }
    if (kind == ExpressionKind.kParenthesized) {
      self.requireGrouped(expression);
      return;
    }
    self.kindMismatch();
  }

  func childCount(ExpressionSyntax expression): int32 throws StateError {
    final ExpressionKind kind = expression.GetExpressionKind();
    if (kind == ExpressionKind.kInvalid ||
        kind == ExpressionKind.kIdentifier ||
        kind == ExpressionKind.kLiteral || kind == ExpressionKind.kSuper) {
      return 0;
    }
    if (kind == ExpressionKind.kBinary ||
        kind == ExpressionKind.kAssignment ||
        kind == ExpressionKind.kNullCoalesce ||
        kind == ExpressionKind.kIndex) {
      return 2;
    }
    if (kind == ExpressionKind.kCall) {
      return self.requireCall(expression).GetArguments().GetCount() + 1;
    }
    if (kind == ExpressionKind.kArrayLiteral) {
      return self.requireArray(expression).GetElements().GetCount();
    }
    return 1;
  }

  func childAt(ExpressionSyntax expression,
               int32 index): ExpressionId throws StateError {
    final ExpressionKind kind = expression.GetExpressionKind();
    if (kind == ExpressionKind.kThrow) {
      return self.requireThrow(expression).GetOperand();
    }
    if (kind == ExpressionKind.kUnary) {
      return self.requireUnary(expression).GetOperand();
    }
    if (kind == ExpressionKind.kUpdate) {
      return self.requireUpdate(expression).GetOperand();
    }
    if (kind == ExpressionKind.kBinary) {
      final BinaryExpressionSyntax value = self.requireBinary(expression);
      if (index == 0) { return value.GetLeft(); }
      return value.GetRight();
    }
    if (kind == ExpressionKind.kTypeTest) {
      return self.requireTypeTest(expression).GetValue();
    }
    if (kind == ExpressionKind.kCheckedCast) {
      return self.requireCheckedCast(expression).GetValue();
    }
    if (kind == ExpressionKind.kNumericConversion) {
      return self.requireNumericConversion(expression).GetValue();
    }
    if (kind == ExpressionKind.kIntegerConversion) {
      return self.requireIntegerConversion(expression).GetValue();
    }
    if (kind == ExpressionKind.kAssignment) {
      final AssignmentExpressionSyntax value =
          self.requireAssignment(expression);
      if (index == 0) { return value.GetTarget(); }
      return value.GetValue();
    }
    if (kind == ExpressionKind.kMemberAccess) {
      return self.requireMember(expression).GetObject();
    }
    if (kind == ExpressionKind.kMetaAccess) {
      return self.requireMeta(expression).GetObject();
    }
    if (kind == ExpressionKind.kSafeMemberAccess) {
      return self.requireSafeMember(expression).GetObject();
    }
    if (kind == ExpressionKind.kSafeMetaAccess) {
      return self.requireSafeMeta(expression).GetObject();
    }
    if (kind == ExpressionKind.kNullCoalesce) {
      final NullCoalesceExpressionSyntax value =
          self.requireCoalesce(expression);
      if (index == 0) { return value.GetNullable(); }
      return value.GetFallback();
    }
    if (kind == ExpressionKind.kNullAssert) {
      return self.requireAssert(expression).GetOperand();
    }
    if (kind == ExpressionKind.kCall) {
      final CallExpressionSyntax value = self.requireCall(expression);
      if (index == 0) { return value.GetCallee(); }
      return value.GetArguments().Get(index - 1);
    }
    if (kind == ExpressionKind.kArrayLiteral) {
      return self.requireArray(expression).GetElements().Get(index);
    }
    if (kind == ExpressionKind.kArrayConstruction) {
      return self.requireArrayConstruction(expression).GetLength();
    }
    if (kind == ExpressionKind.kIndex) {
      final IndexExpressionSyntax value = self.requireIndex(expression);
      if (index == 0) { return value.GetObject(); }
      return value.GetIndex();
    }
    if (kind == ExpressionKind.kParenthesized) {
      return self.requireGrouped(expression).GetExpression();
    }
    throw StateError("expression verifier child index is invalid");
  }

  func verifyType(ExpressionSyntax parent,
                  TypeSyntax type): void throws StateError {
    final bool valid = self.context.VerifyType(type, parent.GetRange());
    self.context.VerifyChildValidity(parent.IsValid(), valid);
  }

  func requireExpression(
      ExpressionVerificationFrame frame): ExpressionSyntax throws StateError {
    final ExpressionSyntax? value = frame.GetExpression();
    if (value == null) {
      throw StateError("expression verification frame is empty");
    }
    return value;
  }

  func requireThrow(
      ExpressionSyntax value): ThrowExpressionSyntax throws StateError {
    final ThrowExpressionSyntax? result = value as ThrowExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireUnary(
      ExpressionSyntax value): UnaryExpressionSyntax throws StateError {
    final UnaryExpressionSyntax? result = value as UnaryExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireUpdate(
      ExpressionSyntax value): UpdateExpressionSyntax throws StateError {
    final UpdateExpressionSyntax? result = value as UpdateExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireBinary(
      ExpressionSyntax value): BinaryExpressionSyntax throws StateError {
    final BinaryExpressionSyntax? result = value as BinaryExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireTypeTest(
      ExpressionSyntax value): TypeTestExpressionSyntax throws StateError {
    final TypeTestExpressionSyntax? result = value as TypeTestExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireCheckedCast(
      ExpressionSyntax value): CheckedCastExpressionSyntax throws StateError {
    final CheckedCastExpressionSyntax? result =
        value as CheckedCastExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireNumericConversion(ExpressionSyntax value):
      NumericConversionExpressionSyntax throws StateError {
    final NumericConversionExpressionSyntax? result =
        value as NumericConversionExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireIntegerConversion(ExpressionSyntax value):
      IntegerConversionExpressionSyntax throws StateError {
    final IntegerConversionExpressionSyntax? result =
        value as IntegerConversionExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireAssignment(
      ExpressionSyntax value): AssignmentExpressionSyntax throws StateError {
    final AssignmentExpressionSyntax? result =
        value as AssignmentExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireMember(
      ExpressionSyntax value): MemberAccessExpressionSyntax throws StateError {
    final MemberAccessExpressionSyntax? result =
        value as MemberAccessExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireMeta(
      ExpressionSyntax value): MetaAccessExpressionSyntax throws StateError {
    final MetaAccessExpressionSyntax? result =
        value as MetaAccessExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireSafeMember(ExpressionSyntax value):
      SafeMemberAccessExpressionSyntax throws StateError {
    final SafeMemberAccessExpressionSyntax? result =
        value as SafeMemberAccessExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireSafeMeta(
      ExpressionSyntax value): SafeMetaAccessExpressionSyntax
      throws StateError {
    final SafeMetaAccessExpressionSyntax? result =
        value as SafeMetaAccessExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireCoalesce(
      ExpressionSyntax value): NullCoalesceExpressionSyntax throws StateError {
    final NullCoalesceExpressionSyntax? result =
        value as NullCoalesceExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireAssert(
      ExpressionSyntax value): NullAssertExpressionSyntax throws StateError {
    final NullAssertExpressionSyntax? result =
        value as NullAssertExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireCall(
      ExpressionSyntax value): CallExpressionSyntax throws StateError {
    final CallExpressionSyntax? result = value as CallExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireArray(
      ExpressionSyntax value): ArrayLiteralExpressionSyntax throws StateError {
    final ArrayLiteralExpressionSyntax? result =
        value as ArrayLiteralExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireArrayConstruction(ExpressionSyntax value):
      ArrayConstructionExpressionSyntax throws StateError {
    final ArrayConstructionExpressionSyntax? result =
        value as ArrayConstructionExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireIndex(
      ExpressionSyntax value): IndexExpressionSyntax throws StateError {
    final IndexExpressionSyntax? result = value as IndexExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }
  func requireGrouped(ExpressionSyntax value):
      ParenthesizedExpressionSyntax throws StateError {
    final ParenthesizedExpressionSyntax? result =
        value as ParenthesizedExpressionSyntax?;
    if (result == null) { self.kindMismatch(); }
    return result!;
  }

  func kindMismatch(): void throws StateError {
    throw StateError("expression kind does not match its node type");
  }
}
