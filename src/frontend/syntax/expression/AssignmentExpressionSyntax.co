import frontend.source::SourceRange;
import frontend.syntax::ExpressionId;
import frontend.syntax::ExpressionSyntax;
import frontend.syntax::SyntaxNodeData;
import frontend.syntax.expression::ExpressionKind;
import frontend.token::TokenKind;

class is ExpressionSyntax {
  final SyntaxNodeData node;
  final ExpressionId target;
  final TokenKind operation;
  final ExpressionId value;

  AssignmentExpressionSyntax(ExpressionId target, TokenKind operation,
                             ExpressionId value, SourceRange range,
                             bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.target = target;
    self.operation = operation;
    self.value = value;
  }

  func GetTarget(): ExpressionId { return self.target; }
  func GetOperation(): TokenKind { return self.operation; }
  func GetValue(): ExpressionId { return self.value; }
  override func GetExpressionKind(): ExpressionKind {
    return ExpressionKind.kAssignment;
  }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
