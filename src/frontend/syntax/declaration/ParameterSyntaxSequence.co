import frontend.syntax.declaration::ParameterSyntax;

class {
  final ParameterSyntax?[] values;

  _ParameterSyntaxSequence(ParameterSyntax?[] values) {
    self.values = values;
  }

  static func Build(
      ParameterSyntax?[] input): ParameterSyntaxSequence throws StateError {
    final ParameterSyntax?[] values = ParameterSyntax?[:input::length];
    for (int32 index = 0; index < input::length; index++) {
      if (input[index] == null) {
        throw StateError("parameter syntax sequence contains null");
      }
      values[index] = input[index];
    }
    return ParameterSyntaxSequence(values);
  }

  func Get(int32 index): ParameterSyntax throws StateError {
    if (index < 0 || index >= self.values::length) {
      throw StateError("parameter syntax sequence index is out of bounds");
    }
    return self.values[index]!;
  }

  func GetCount(): int32 { return self.values::length; }
}
