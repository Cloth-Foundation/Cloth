import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax::BlockId;
import frontend.syntax::SyntaxNodeData;
import frontend.syntax.declaration::ConstructorInitializerSyntax;
import frontend.syntax.declaration::DeclarationKind;
import frontend.syntax.declaration::DeclarationSyntax;
import frontend.syntax.declaration::ParameterSyntaxSequence;
import frontend.syntax.tree::TypeSyntaxSequence;
import frontend.syntax.tree::Visibility;

class is DeclarationSyntax {
  final SyntaxNodeData node;
  final SourceSpan name;
  final Visibility visibility;
  final ParameterSyntaxSequence parameters;
  final ConstructorInitializerSyntax? initializer;
  final BlockId body;
  final TypeSyntaxSequence throwsTypes;
  final bool explicitThrows;

  ConstructorSyntax(SourceSpan name, Visibility visibility,
                    ParameterSyntaxSequence parameters,
                    ConstructorInitializerSyntax? initializer, BlockId body,
                    TypeSyntaxSequence throwsTypes, bool explicitThrows,
                    SourceRange range, bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.name = name;
    self.visibility = visibility;
    self.parameters = parameters;
    self.initializer = initializer;
    self.body = body;
    self.throwsTypes = throwsTypes;
    self.explicitThrows = explicitThrows;
  }

  func GetName(): SourceSpan { return self.name; }
  func GetVisibility(): Visibility { return self.visibility; }
  func GetParameters(): ParameterSyntaxSequence { return self.parameters; }
  func GetInitializer(): ConstructorInitializerSyntax? {
    return self.initializer;
  }
  func GetBody(): BlockId { return self.body; }
  func GetThrowsTypes(): TypeSyntaxSequence { return self.throwsTypes; }
  func HasExplicitThrows(): bool { return self.explicitThrows; }
  override func GetDeclarationKind(): DeclarationKind {
    return DeclarationKind.kConstructor;
  }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
