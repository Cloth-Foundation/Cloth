import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax::SyntaxNode;
import frontend.syntax::SyntaxNodeData;
import frontend.syntax.tree::ImportKind;

class is SyntaxNode {
  final SyntaxNodeData node;
  final ImportKind kind;
  final SourceSpan? packageName;
  final SourceSpan? typeName;
  final SourceSpan? alias;

  ImportSyntax(ImportKind kind, SourceSpan? packageName,
               SourceSpan? typeName, SourceSpan? alias, SourceRange range,
               bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.kind = kind;
    self.packageName = packageName;
    self.typeName = typeName;
    self.alias = alias;
  }

  func GetKind(): ImportKind { return self.kind; }
  func GetPackageName(): SourceSpan? { return self.packageName; }
  func GetTypeName(): SourceSpan? { return self.typeName; }
  func GetAlias(): SourceSpan? { return self.alias; }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
