import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax::SyntaxNode;
import frontend.syntax::SyntaxNodeData;

class is SyntaxNode {
  final SyntaxNodeData node;
  final SourceSpan name;

  EnumCaseSyntax(SourceSpan name, SourceRange range,
                 bool valid) {
    self.node = SyntaxNodeData(range, valid);
    self.name = name;
  }

  func GetName(): SourceSpan { return self.name; }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
