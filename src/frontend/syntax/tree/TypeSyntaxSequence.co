import frontend.syntax.tree::TypeSyntax;

class {
  final TypeSyntax?[] values;

  _TypeSyntaxSequence(TypeSyntax?[] values) {
    self.values = values;
  }

  static func Build(TypeSyntax?[] input): TypeSyntaxSequence throws StateError {
    final TypeSyntax?[] values = TypeSyntax?[:input::length];
    for (int32 index = 0; index < input::length; index++) {
      if (input[index] == null) {
        throw StateError("type syntax sequence contains null");
      }
      values[index] = input[index];
    }
    return TypeSyntaxSequence(values);
  }

  func Get(int32 index): TypeSyntax throws StateError {
    if (index < 0 || index >= self.values::length) {
      throw StateError("type syntax sequence index is out of bounds");
    }
    return self.values[index]!;
  }

  func GetCount(): int32 { return self.values::length; }
}
