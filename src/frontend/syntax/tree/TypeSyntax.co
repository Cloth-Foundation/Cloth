import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax::SyntaxNode;
import frontend.syntax::SyntaxNodeData;

class is SyntaxNode {
  final SyntaxNodeData node;
  final SourceSpan name;
  final bool primitive;
  final bool array;
  final bool nullable;
  final bool elementNullable;

  TypeSyntax(SourceSpan name, SourceRange range, bool valid, bool primitive,
             bool array, bool nullable,
             bool elementNullable) {
    self.node = SyntaxNodeData(range, valid);
    self.name = name;
    self.primitive = primitive;
    self.array = array;
    self.nullable = nullable;
    self.elementNullable = elementNullable;
  }

  func GetName(): SourceSpan { return self.name; }
  func IsPrimitive(): bool { return self.primitive; }
  func IsArray(): bool { return self.array; }
  func IsNullable(): bool { return self.nullable; }
  func IsElementNullable(): bool { return self.elementNullable; }
  override func GetRange(): SourceRange { return self.node.GetRange(); }
  override func IsValid(): bool { return self.node.IsValid(); }
}
