import frontend.syntax.storage::SyntaxHandle;

class {
  static final int32 pageCapacity = 64;

  final SyntaxHandle?[] values;
  int32 count;
  SyntaxHandlePage? next;
  bool frozen;

  SyntaxHandlePage() {
    self.values = SyntaxHandle?[:pageCapacity];
    self.count = 0;
    self.next = null;
    self.frozen = false;
  }

  func Add(SyntaxHandle value): void throws StateError {
    if (self.frozen) { throw StateError("syntax child page is sealed"); }
    if (self.count >= self.values::length) {
      throw StateError("syntax child page is full");
    }
    self.values[self.count] = value;
    self.count++;
  }

  func Get(int32 index): SyntaxHandle throws StateError {
    if (index < 0 || index >= self.count) {
      throw StateError("syntax child page index is out of bounds");
    }
    return self.values[index]!;
  }

  func Link(SyntaxHandlePage next): void throws StateError {
    if (self.frozen) { throw StateError("syntax child page is sealed"); }
    if (self.next != null) {
      throw StateError("syntax child page is already linked");
    }
    self.next = next;
  }

  func Seal(): void throws StateError {
    if (self.frozen) {
      throw StateError("syntax child page is already sealed");
    }
    self.frozen = true;
  }

  func IsFull(): bool { return self.count == self.values::length; }
  func GetCount(): int32 { return self.count; }
  func GetNext(): SyntaxHandlePage? { return self.next; }
}
