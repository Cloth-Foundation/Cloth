import frontend.diagnostic::ParseDiagnostic;
import frontend.diagnostic::ParseDiagnosticKind;
import frontend.parser::ConstantParseBudget;
import frontend.parser::ConstructorInitializerParseResult;
import frontend.parser::ExpressionParser;
import frontend.parser::ParseDiagnosticCollector;
import frontend.parser::ParserFacts;
import frontend.parser::TokenCursor;
import frontend.parser::TokenIndexRange;
import frontend.source::SourceFile;
import frontend.source::SourceLocation;
import frontend.source::SourceRange;
import frontend.syntax::ExpressionId;
import frontend.syntax.declaration::ConstructorInitializerSyntax;
import frontend.syntax.storage::ExpressionIdBuilder;
import frontend.syntax.storage::SyntaxStorage;
import frontend.syntax.tree::TypeSyntax;
import frontend.token::Token;
import frontend.token::TokenBuffer;
import frontend.token::TokenKind;

class {
  static func Parse(SourceFile source, TokenBuffer tokens,
                    TokenIndexRange range, SyntaxStorage storage,
                    ParseDiagnosticCollector diagnostics,
                    ConstantParseBudget? constantBudget):
      ConstructorInitializerParseResult throws StateError {
    final TokenCursor cursor = TokenCursor.Build(source, tokens).Slice(range);
    final int32 diagnosticBase = diagnostics.GetCount();
    final SourceLocation begin = cursor.Current().GetRange().GetBegin();
    final TypeSyntax type = parseType(cursor, diagnostics);
    final var arguments = ExpressionIdBuilder();
    bool valid = type.IsValid();

    if (!cursor.Match(TokenKind.kLeftParen)) {
      add(diagnostics,
          ParseDiagnosticKind.kExpectedConstructorInitializerOpen,
          cursor.Current().GetRange());
      valid = false;
    } else {
      final var parser = ExpressionParser(cursor, storage, diagnostics, false,
                                          constantBudget);
      while (!cursor.AtEnd() &&
             cursor.Current().GetKind() != TokenKind.kRightParen) {
        final ExpressionId argument = parser.ParseOne();
        arguments.Add(argument);
        if (!storage.GetExpression(argument).IsValid()) { valid = false; }
        if (cursor.Match(TokenKind.kComma)) {
          if (cursor.Current().GetKind() == TokenKind.kRightParen) {
            add(diagnostics,
                ParseDiagnosticKind.kExpectedConstructorInitializerArgument,
                cursor.Current().GetRange());
            valid = false;
          }
          continue;
        }
        if (cursor.Current().GetKind() != TokenKind.kRightParen) {
          add(diagnostics,
              ParseDiagnosticKind.kExpectedConstructorInitializerSeparator,
              cursor.Current().GetRange());
          valid = false;
          synchronize(cursor);
          cursor.Match(TokenKind.kComma);
        }
      }
    }

    SourceLocation end = begin;
    if (cursor.GetIndex() > range.GetBegin()) {
      end = tokens.Get(cursor.GetIndex() - 1).GetRange().GetEnd();
    }
    if (cursor.Match(TokenKind.kRightParen)) {
      end = tokens.Get(cursor.GetIndex() - 1).GetRange().GetEnd();
    } else {
      add(diagnostics,
          ParseDiagnosticKind.kExpectedConstructorInitializerClose,
          cursor.Current().GetRange());
      valid = false;
    }
    if (!cursor.AtEnd()) {
      add(diagnostics, ParseDiagnosticKind.kUnexpectedExpressionToken,
          cursor.Current().GetRange());
      valid = false;
      while (!cursor.AtEnd()) { cursor.Advance(); }
    }
    valid = valid && diagnostics.GetCount() == diagnosticBase;
    final ConstructorInitializerSyntax initializer =
        ConstructorInitializerSyntax(type, arguments.Finish(),
                                     SourceRange(begin, end), valid);
    return ConstructorInitializerParseResult(initializer, cursor.GetIndex(),
                                             valid);
  }

  static func parseType(TokenCursor cursor,
                        ParseDiagnosticCollector diagnostics): TypeSyntax
      throws StateError {
    final Token token = cursor.Current();
    if (cursor.AtEnd() || !ParserFacts.CanStartType(token.GetKind())) {
      add(diagnostics,
          ParseDiagnosticKind.kExpectedConstructorInitializerType,
          token.GetRange());
      return TypeSyntax(token.GetSpan(), token.GetRange(), false, false, false,
                        false, false);
    }
    cursor.Advance();
    SourceLocation end = token.GetRange().GetEnd();
    bool valid = true;
    bool innerNullable = false;
    while (!cursor.AtEnd() &&
           (cursor.Current().GetKind() == TokenKind.kQuestion ||
            cursor.Current().GetKind() == TokenKind.kQuestionQuestion)) {
      final Token suffix = cursor.Advance();
      if (innerNullable || suffix.GetKind() == TokenKind.kQuestionQuestion) {
        add(diagnostics, ParseDiagnosticKind.kRepeatedNullability,
            suffix.GetRange());
        valid = false;
      }
      innerNullable = true;
      end = suffix.GetRange().GetEnd();
    }
    bool array = false;
    while (!cursor.AtEnd() &&
           cursor.Current().GetKind() == TokenKind.kLeftBracket) {
      final Token open = cursor.Advance();
      if (array) {
        add(diagnostics, ParseDiagnosticKind.kMultidimensionalArray,
            open.GetRange());
        valid = false;
      }
      array = true;
      if (cursor.Match(TokenKind.kRightBracket)) {
        end = cursor.GetTokens().Get(cursor.GetIndex() - 1).GetRange().GetEnd();
      } else {
        add(diagnostics, ParseDiagnosticKind.kExpectedArrayClose,
            cursor.Current().GetRange());
        valid = false;
        break;
      }
    }
    bool outerNullable = false;
    if (array) {
      while (!cursor.AtEnd() &&
             (cursor.Current().GetKind() == TokenKind.kQuestion ||
              cursor.Current().GetKind() == TokenKind.kQuestionQuestion)) {
        final Token suffix = cursor.Advance();
        if (outerNullable ||
            suffix.GetKind() == TokenKind.kQuestionQuestion) {
          add(diagnostics, ParseDiagnosticKind.kRepeatedNullability,
              suffix.GetRange());
          valid = false;
        }
        outerNullable = true;
        end = suffix.GetRange().GetEnd();
      }
    }
    bool nullable = innerNullable;
    if (array) { nullable = outerNullable; }
    return TypeSyntax(token.GetSpan(),
                      SourceRange(token.GetRange().GetBegin(), end), valid,
                      ParserFacts.IsPrimitiveType(token.GetKind()), array,
                      nullable, array && innerNullable);
  }

  static func synchronize(TokenCursor cursor): void throws StateError {
    while (!cursor.AtEnd() &&
           cursor.Current().GetKind() != TokenKind.kComma &&
           cursor.Current().GetKind() != TokenKind.kRightParen) {
      cursor.Advance();
    }
  }

  static func add(ParseDiagnosticCollector diagnostics,
                  ParseDiagnosticKind kind,
                  SourceRange range): void throws StateError {
    diagnostics.Add(ParseDiagnostic(kind, range, null));
  }
}
