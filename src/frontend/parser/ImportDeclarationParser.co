import frontend.diagnostic::ParseDiagnosticKind;
import frontend.parser::DeclarationParseState;
import frontend.parser::SourceText;
import frontend.source::SourceLocation;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax.tree::ImportKind;
import frontend.syntax.tree::ImportSyntax;
import frontend.token::Token;
import frontend.token::TokenKind;

class {
  static func Parse(DeclarationParseState state) throws StateError {
    final int32 diagnosticCount = state.GetDiagnosticCount();
    final Token keyword = state.Advance();
    SourceSpan? packageName = null;
    SourceSpan? typeName = null;
    SourceSpan? alias = null;
    SourceSpan? firstSegment = null;
    SourceRange rootRange = keyword.GetRange();
    ImportKind kind = ImportKind.kType;

    if (state.Current().GetKind() != TokenKind.kIdentifier) {
      state.AddDiagnostic(ParseDiagnosticKind.kExpectedImportName,
                          state.Current().GetRange(), null);
    } else {
      final Token first = state.Advance();
      firstSegment = first.GetSpan();
      rootRange = first.GetRange();
      if (state.Match(TokenKind.kColonColon)) {
        packageName = first.GetSpan();
        if (state.Current().GetKind() == TokenKind.kIdentifier) {
          typeName = state.Advance().GetSpan();
        } else {
          state.AddDiagnostic(ParseDiagnosticKind.kExpectedImportType,
                              state.Current().GetRange(), null);
        }
      } else {
        if (state.Match(TokenKind.kDot)) {
          final int32 packageBegin = first.GetSpan().GetBeginOffset();
          int32 packageEnd = first.GetSpan().GetEndOffset();
          bool complete = false;
          while (!state.AtEnd() && !complete) {
            if (state.Match(TokenKind.kStar)) {
              kind = ImportKind.kWildcard;
              complete = true;
              continue;
            }
            if (state.Current().GetKind() != TokenKind.kIdentifier) {
              state.AddDiagnostic(
                  ParseDiagnosticKind.kExpectedImportPathContinuation,
                  state.Current().GetRange(), null);
              complete = true;
              continue;
            }
            final Token segment = state.Advance();
            packageEnd = segment.GetSpan().GetEndOffset();
            if (state.Match(TokenKind.kColonColon)) {
              if (state.Current().GetKind() == TokenKind.kIdentifier) {
                typeName = state.Advance().GetSpan();
              } else {
                state.AddDiagnostic(ParseDiagnosticKind.kExpectedImportType,
                                    state.Current().GetRange(), null);
              }
              complete = true;
              continue;
            }
            if (!state.Match(TokenKind.kDot)) {
              state.AddDiagnostic(
                  ParseDiagnosticKind.kExpectedImportPathContinuation,
                  state.Current().GetRange(), null);
              complete = true;
            }
          }
          packageName = SourceSpan(
              state.GetSource(), packageBegin, packageEnd);
        } else {
          typeName = first.GetSpan();
        }
      }
    }

    if (kind == ImportKind.kType && state.Match(TokenKind.kKwAs)) {
      if (state.Current().GetKind() == TokenKind.kIdentifier) {
        final Token aliasToken = state.Advance();
        alias = aliasToken.GetSpan();
        if (SourceText.EqualsIgnoreCaseAscii(aliasToken.GetSpan(), "cloth")) {
          state.AddDiagnostic(ParseDiagnosticKind.kReservedImportAlias,
                              aliasToken.GetRange(), null);
        }
      } else {
        state.AddDiagnostic(ParseDiagnosticKind.kExpectedImportAlias,
                            state.Current().GetRange(), null);
      }
    } else {
      if (kind == ImportKind.kWildcard &&
          state.Current().GetKind() == TokenKind.kKwAs) {
        state.AddDiagnostic(ParseDiagnosticKind.kWildcardImportAlias,
                            state.Current().GetRange(), null);
        state.Advance();
        if (state.Current().GetKind() == TokenKind.kIdentifier) {
          state.Advance();
        }
      }
    }

    SourceLocation end = state.Current().GetRange().GetBegin();
    if (state.Match(TokenKind.kSemicolon)) {
      end = state.GetTokens()
                .Get(state.GetIndex() - 1)
                .GetRange()
                .GetEnd();
    } else {
      state.AddDiagnostic(ParseDiagnosticKind.kExpectedImportTerminator,
                          state.Current().GetRange(), null);
      while (!state.AtEnd() && !state.Match(TokenKind.kSemicolon)) {
        state.Advance();
      }
      if (state.GetIndex() != 0) {
        end = state.GetTokens()
                  .Get(state.GetIndex() - 1)
                  .GetRange()
                  .GetEnd();
      }
    }

    if (packageName != null && firstSegment != null &&
        SourceText.EqualsIgnoreCaseAscii(firstSegment, "cloth") &&
        !SourceText.Equals(firstSegment, "cloth")) {
      state.AddDiagnostic(ParseDiagnosticKind.kReservedStandardLibraryRoot,
                          rootRange, null);
    }
    final bool valid =
        state.GetDiagnosticCount() == diagnosticCount &&
        (kind == ImportKind.kWildcard || typeName != null);
    state.AddImport(ImportSyntax(
        kind, packageName, typeName, alias,
        SourceRange(keyword.GetRange().GetBegin(), end), valid));
  }

}
