import frontend.parser::DeclarationOutline;
import frontend.parser::MemberOutlineSequence;
import frontend.parser.storage::MemberOutlinePage;

class {
  MemberOutlinePage? first;
  MemberOutlinePage? last;
  int32 count;
  int32 lastOffset;
  bool finished;

  MemberOutlineBuilder() {
    self.first = null;
    self.last = null;
    self.count = 0;
    self.lastOffset = -1;
    self.finished = false;
  }

  func Add(DeclarationOutline value): void throws StateError {
    if (self.finished) {
      throw StateError("member outline builder is already finished");
    }
    final int32 offset = value.GetRange().GetBegin().GetOffset();
    if (offset < self.lastOffset) {
      throw StateError("member outlines must be added in source order");
    }
    if (self.count == 2147483647) {
      throw StateError("member outline count overflow");
    }
    if (self.last == null || self.last!.IsFull()) {
      final MemberOutlinePage page = MemberOutlinePage();
      if (self.last == null) {
        self.first = page;
      } else {
        self.last!.Link(page);
      }
      self.last = page;
    }
    self.last!.Add(value);
    self.count++;
    self.lastOffset = offset;
  }

  func Finish(): MemberOutlineSequence throws StateError {
    if (self.finished) {
      throw StateError("member outline builder is already finished");
    }
    self.finished = true;
    return MemberOutlineSequence.Build(self.first, self.count);
  }

  func GetCount(): int32 { return self.count; }
  func IsFinished(): bool { return self.finished; }
}
