import frontend.diagnostic::ParseDiagnostic;
import frontend.diagnostic::ParseDiagnosticKind;
import frontend.parser::ExpressionParser;
import frontend.parser::ParseDiagnosticCollector;
import frontend.parser::ParserFacts;
import frontend.parser::StatementParseFrame;
import frontend.parser::StatementParseFrameKind;
import frontend.parser::TokenCursor;
import frontend.parser.storage::SwitchArmSyntaxBuilder;
import frontend.source::SourceLocation;
import frontend.source::SourceRange;
import frontend.syntax::BlockId;
import frontend.syntax::ExpressionId;
import frontend.syntax::StatementId;
import frontend.syntax::StatementSyntax;
import frontend.syntax.expression::InvalidExpressionSyntax;
import frontend.syntax.statement::BlockNodeSyntax;
import frontend.syntax.statement::BreakStatementSyntax;
import frontend.syntax.statement::ContinueStatementSyntax;
import frontend.syntax.statement::ExpressionStatementSyntax;
import frontend.syntax.statement::ForEachStatementSyntax;
import frontend.syntax.statement::ForStatementSyntax;
import frontend.syntax.statement::ForVariableSyntax;
import frontend.syntax.statement::IfStatementSyntax;
import frontend.syntax.statement::InvalidStatementSyntax;
import frontend.syntax.statement::LocalVariableStatementSyntax;
import frontend.syntax.statement::NestedBlockStatementSyntax;
import frontend.syntax.statement::ReturnStatementSyntax;
import frontend.syntax.statement::SwitchArmSyntax;
import frontend.syntax.statement::SwitchStatementSyntax;
import frontend.syntax.statement::WhileStatementSyntax;
import frontend.syntax.storage::ExpressionIdBuilder;
import frontend.syntax.storage::StatementIdBuilder;
import frontend.syntax.storage::SyntaxStorage;
import frontend.syntax.tree::TypeSyntax;
import frontend.token::Token;
import frontend.token::TokenKind;

class {
  final TokenCursor cursor;
  final SyntaxStorage storage;
  final ParseDiagnosticCollector diagnostics;
  StatementParseFrame? top;
  BlockId? completedBlock;
  StatementId? completedStatement;

  StatementParser(TokenCursor cursor, SyntaxStorage storage,
                  ParseDiagnosticCollector diagnostics) {
    self.cursor = cursor;
    self.storage = storage;
    self.diagnostics = diagnostics;
    self.top = null;
    self.completedBlock = null;
    self.completedStatement = null;
  }

  func ParseBlock(): BlockId throws StateError {
    if (self.top != null || self.completedBlock != null ||
        self.completedStatement != null) {
      throw StateError("statement parser is already active");
    }
    self.start(StatementParseFrameKind.kBlock, null);
    while (self.top != null) {
      final StatementParseFrame frame = self.top!;
      switch (frame.GetKind()) {
        case StatementParseFrameKind.kBlock: { self.stepBlock(frame); }
        case StatementParseFrameKind.kIf: { self.stepIf(frame); }
        case StatementParseFrameKind.kWhile: { self.stepWhile(frame); }
        case StatementParseFrameKind.kFor: { self.stepFor(frame); }
        case StatementParseFrameKind.kSwitch: { self.stepSwitch(frame); }
      }
    }
    final BlockId? result = self.completedBlock;
    self.completedBlock = null;
    if (result == null) {
      throw StateError("statement parser produced no block");
    }
    return result;
  }

  func GetCursor(): TokenCursor { return self.cursor; }

  func stepBlock(StatementParseFrame frame): void throws StateError {
    if (frame.GetState() == 0) {
      frame.SetStatements(StatementIdBuilder());
      if (!self.cursor.Match(TokenKind.kLeftBrace)) {
        self.addDiagnostic(ParseDiagnosticKind.kExpectedBlockOpen,
                           self.cursor.Current().GetRange());
        self.finishBlock(frame, self.emptyBlock(
            self.cursor.Current().GetRange().GetBegin(), false));
        return;
      }
      frame.SetKeyword(self.previousToken());
      frame.SetState(1);
      return;
    }
    if (frame.GetState() == 2) {
      final BlockId child = self.takeBlock();
      final bool valid = self.storage.GetBlock(child).IsValid();
      final StatementId nested = self.storage.AddStatement(
          NestedBlockStatementSyntax(child,
                                     self.storage.GetBlock(child).GetRange(),
                                     valid));
      self.requireStatements(frame).Add(nested);
      frame.SetState(1);
      return;
    }
    if (frame.GetState() == 3) {
      self.requireStatements(frame).Add(self.takeStatement());
      frame.SetState(1);
      return;
    }
    if (self.cursor.AtEnd() ||
        self.cursor.Current().GetKind() == TokenKind.kRightBrace) {
      final Token open = self.requireKeyword(frame);
      SourceLocation end = self.cursor.Current().GetRange().GetBegin();
      bool close = false;
      if (self.cursor.Match(TokenKind.kRightBrace)) {
        end = self.previousToken().GetRange().GetEnd();
        close = true;
      }
      final bool valid = close && self.nodeValid(frame);
      self.finishBlock(frame, self.storage.AddBlock(BlockNodeSyntax(
          self.requireStatements(frame).Finish(),
          SourceRange(open.GetRange().GetBegin(), end), valid)));
      return;
    }

    final int32 before = self.cursor.GetIndex();
    final TokenKind kind = self.cursor.Current().GetKind();
    if (kind == TokenKind.kKwCase || kind == TokenKind.kKwDefault) {
      final SourceRange range = self.cursor.Advance().GetRange();
      self.addDiagnostic(ParseDiagnosticKind.kSwitchLabelOutsideSwitch,
                         range);
      self.synchronizeStatement();
      self.requireStatements(frame).Add(
          self.storage.AddStatement(InvalidStatementSyntax(range)));
    } else {
      if (kind == TokenKind.kLeftBrace) {
        frame.SetState(2);
        self.start(StatementParseFrameKind.kBlock, frame);
      } else {
        if (kind == TokenKind.kKwIf || kind == TokenKind.kKwWhile ||
            kind == TokenKind.kKwFor || kind == TokenKind.kKwSwitch) {
          frame.SetState(3);
          StatementParseFrameKind childKind = StatementParseFrameKind.kIf;
          if (kind == TokenKind.kKwWhile) {
            childKind = StatementParseFrameKind.kWhile;
          }
          if (kind == TokenKind.kKwFor) {
            childKind = StatementParseFrameKind.kFor;
          }
          if (kind == TokenKind.kKwSwitch) {
            childKind = StatementParseFrameKind.kSwitch;
          }
          self.start(childKind, frame);
        } else {
          self.requireStatements(frame).Add(self.parseSimpleStatement());
        }
      }
    }
    if (self.top == frame && self.cursor.GetIndex() == before &&
        !self.cursor.AtEnd()) {
      self.cursor.Advance();
    }
  }

  func stepIf(StatementParseFrame frame): void throws StateError {
    if (frame.GetState() == 0) {
      frame.SetKeyword(self.cursor.Advance());
      self.expect(TokenKind.kLeftParen, ParseDiagnosticKind.kExpectedIfOpen,
                  frame);
      frame.SetExpression(self.parseExpression());
      self.expect(TokenKind.kRightParen, ParseDiagnosticKind.kExpectedIfClose,
                  frame);
      if (self.cursor.Current().GetKind() == TokenKind.kLeftBrace) {
        frame.SetState(1);
        self.start(StatementParseFrameKind.kBlock, frame);
        return;
      }
      self.addDiagnostic(ParseDiagnosticKind.kExpectedIfBody,
                         self.cursor.Current().GetRange());
      frame.MarkInvalid();
      frame.SetBlock(self.emptyBlock(
          self.cursor.Current().GetRange().GetBegin(), false));
      frame.SetState(2);
      return;
    }
    if (frame.GetState() == 1) {
      frame.SetBlock(self.takeBlock());
      frame.SetState(2);
      return;
    }
    if (frame.GetState() == 3) {
      frame.SetAlternative(self.takeBlock());
      self.finishIf(frame);
      return;
    }
    if (self.cursor.Match(TokenKind.kKwElse)) {
      if (self.cursor.Current().GetKind() == TokenKind.kLeftBrace) {
        frame.SetState(3);
        self.start(StatementParseFrameKind.kBlock, frame);
        return;
      }
      self.addDiagnostic(ParseDiagnosticKind.kExpectedElseBody,
                         self.cursor.Current().GetRange());
      frame.MarkInvalid();
    }
    self.finishIf(frame);
  }

  func finishIf(StatementParseFrame frame): void throws StateError {
    final BlockId body = self.requireBlock(frame);
    final BlockId? alternative = frame.GetAlternative();
    SourceLocation end = self.storage.GetBlock(body).GetRange().GetEnd();
    bool valid = frame.IsValid() && self.nodeValid(frame) &&
                 self.isValid(self.requireExpression(frame)) &&
                 self.storage.GetBlock(body).IsValid();
    if (alternative != null) {
      end = self.storage.GetBlock(alternative).GetRange().GetEnd();
      valid = valid && self.storage.GetBlock(alternative).IsValid();
    }
    self.finishStatement(frame, self.storage.AddStatement(IfStatementSyntax(
        self.requireExpression(frame), body, alternative,
        SourceRange(self.requireKeyword(frame).GetRange().GetBegin(), end),
        valid)));
  }

  func stepWhile(StatementParseFrame frame): void throws StateError {
    if (frame.GetState() == 0) {
      frame.SetKeyword(self.cursor.Advance());
      self.expect(TokenKind.kLeftParen,
                  ParseDiagnosticKind.kExpectedWhileOpen, frame);
      frame.SetExpression(self.parseExpression());
      self.expect(TokenKind.kRightParen,
                  ParseDiagnosticKind.kExpectedWhileClose, frame);
      if (self.cursor.Current().GetKind() == TokenKind.kLeftBrace) {
        frame.SetState(1);
        self.start(StatementParseFrameKind.kBlock, frame);
        return;
      }
      self.addDiagnostic(ParseDiagnosticKind.kExpectedWhileBody,
                         self.cursor.Current().GetRange());
      frame.MarkInvalid();
      frame.SetBlock(self.emptyBlock(
          self.cursor.Current().GetRange().GetBegin(), false));
      frame.SetState(2);
      return;
    }
    if (frame.GetState() == 1) { frame.SetBlock(self.takeBlock()); }
    final BlockId body = self.requireBlock(frame);
    final bool valid = frame.IsValid() && self.nodeValid(frame) &&
                       self.isValid(self.requireExpression(frame)) &&
                       self.storage.GetBlock(body).IsValid();
    self.finishStatement(frame, self.storage.AddStatement(
        WhileStatementSyntax(
            self.requireExpression(frame), body,
            SourceRange(self.requireKeyword(frame).GetRange().GetBegin(),
                        self.storage.GetBlock(body).GetRange().GetEnd()),
            valid)));
  }

  func stepFor(StatementParseFrame frame): void throws StateError {
    if (frame.GetState() == 0) {
      frame.SetKeyword(self.cursor.Advance());
      self.expect(TokenKind.kLeftParen, ParseDiagnosticKind.kExpectedForOpen,
                  frame);
      frame.SetExpressions(ExpressionIdBuilder());
      if (self.isLocalVariableStart()) {
        final ForVariableSyntax variable = self.parseForVariable();
        if (self.cursor.Match(TokenKind.kKwIn)) {
          frame.SetVariable(variable);
          frame.SetExpression(self.parseExpression());
          self.expect(TokenKind.kRightParen,
                      ParseDiagnosticKind.kExpectedForClose, frame);
          self.startForBody(frame, 2);
          return;
        }
        frame.SetStatement(self.parseForLocalInitializer(variable));
      } else {
        if (!self.cursor.Match(TokenKind.kSemicolon)) {
          final int32 base = self.diagnostics.GetCount();
          final ExpressionId value = self.parseExpression();
          SourceLocation end = self.rangeOf(value).GetEnd();
          if (self.cursor.Match(TokenKind.kSemicolon)) {
            end = self.previousToken().GetRange().GetEnd();
          } else {
            self.addDiagnostic(
                ParseDiagnosticKind.kExpectedForInitializerTerminator,
                self.cursor.Current().GetRange());
          }
          frame.SetStatement(self.storage.AddStatement(
              ExpressionStatementSyntax(
                  value,
                  SourceRange(self.rangeOf(value).GetBegin(), end),
                  self.diagnostics.GetCount() == base &&
                      self.isValid(value))));
        }
      }
      if (self.cursor.Current().GetKind() != TokenKind.kSemicolon) {
        frame.SetExpression(self.parseExpression());
      }
      self.expect(TokenKind.kSemicolon,
                  ParseDiagnosticKind.kExpectedForConditionTerminator,
                  frame);
      while (!self.cursor.AtEnd() &&
             self.cursor.Current().GetKind() != TokenKind.kRightParen) {
        self.requireExpressions(frame).Add(self.parseExpression());
        if (!self.cursor.Match(TokenKind.kComma)) { break; }
      }
      self.expect(TokenKind.kRightParen,
                  ParseDiagnosticKind.kExpectedForClose, frame);
      self.startForBody(frame, 1);
      return;
    }
    final BlockId body = self.takeBlock();
    final SourceRange range = SourceRange(
        self.requireKeyword(frame).GetRange().GetBegin(),
        self.storage.GetBlock(body).GetRange().GetEnd());
    bool valid = frame.IsValid() && self.nodeValid(frame) &&
                 self.storage.GetBlock(body).IsValid();
    if (frame.GetState() == 2) {
      final ForVariableSyntax variable = self.requireVariable(frame);
      valid = valid && variable.IsValid() &&
              self.isValid(self.requireExpression(frame));
      self.finishStatement(frame, self.storage.AddStatement(
          ForEachStatementSyntax(variable, self.requireExpression(frame),
                                 body, range, valid)));
      return;
    }
    final StatementId? initializer = frame.GetStatement();
    final ExpressionId? condition = frame.GetExpression();
    if (initializer != null) {
      valid = valid && self.storage.GetStatement(initializer).IsValid();
    }
    if (condition != null) { valid = valid && self.isValid(condition); }
    self.finishStatement(frame, self.storage.AddStatement(ForStatementSyntax(
        initializer, condition, self.requireExpressions(frame).Finish(), body,
        range, valid)));
  }

  func startForBody(StatementParseFrame frame,
                    int32 nextState): void throws StateError {
    frame.SetState(nextState);
    if (self.cursor.Current().GetKind() == TokenKind.kLeftBrace) {
      self.start(StatementParseFrameKind.kBlock, frame);
      return;
    }
    self.addDiagnostic(ParseDiagnosticKind.kExpectedForBody,
                       self.cursor.Current().GetRange());
    frame.MarkInvalid();
    self.completedBlock = self.emptyBlock(
        self.cursor.Current().GetRange().GetBegin(), false);
  }

  func stepSwitch(StatementParseFrame frame): void throws StateError {
    if (frame.GetState() == 0) {
      frame.SetKeyword(self.cursor.Advance());
      frame.SetArms(SwitchArmSyntaxBuilder());
      self.expect(TokenKind.kLeftParen,
                  ParseDiagnosticKind.kExpectedSwitchOpen, frame);
      frame.SetExpression(self.parseExpression());
      self.expect(TokenKind.kRightParen,
                  ParseDiagnosticKind.kExpectedSwitchClose, frame);
      if (!self.cursor.Match(TokenKind.kLeftBrace)) {
        self.addDiagnostic(ParseDiagnosticKind.kExpectedSwitchBody,
                           self.cursor.Current().GetRange());
        frame.MarkInvalid();
        self.finishSwitch(frame,
                          self.cursor.Current().GetRange().GetBegin());
        return;
      }
      frame.SetState(1);
      return;
    }
    if (frame.GetState() == 2) {
      final BlockId body = self.takeBlock();
      final Token keyword = self.requireArmKeyword(frame);
      final bool valid = self.diagnostics.GetCount() ==
                             frame.GetArmDiagnosticBase() &&
                         self.storage.GetBlock(body).IsValid();
      if (self.requireArms(frame).GetCount() >= 65537) {
        self.addDiagnostic(ParseDiagnosticKind.kSwitchArmLimit,
                           keyword.GetRange());
        frame.MarkInvalid();
      } else {
        self.requireArms(frame).Add(SwitchArmSyntax(
            self.requireLabels(frame).Finish(), body,
            SourceRange(keyword.GetRange().GetBegin(),
                        self.storage.GetBlock(body).GetRange().GetEnd()),
            valid));
      }
      frame.SetState(1);
      return;
    }
    if (self.cursor.AtEnd() ||
        self.cursor.Current().GetKind() == TokenKind.kRightBrace) {
      SourceLocation end = self.cursor.Current().GetRange().GetBegin();
      if (self.cursor.Match(TokenKind.kRightBrace)) {
        end = self.previousToken().GetRange().GetEnd();
      } else {
        self.addDiagnostic(ParseDiagnosticKind.kExpectedSwitchClose,
                           self.cursor.Current().GetRange());
        frame.MarkInvalid();
      }
      self.finishSwitch(frame, end);
      return;
    }

    final Token keyword = self.cursor.Current();
    if (keyword.GetKind() != TokenKind.kKwCase &&
        keyword.GetKind() != TokenKind.kKwDefault) {
      self.addDiagnostic(ParseDiagnosticKind.kExpectedSwitchArm,
                         keyword.GetRange());
      frame.MarkInvalid();
      self.synchronizeSwitchArm();
      return;
    }
    self.cursor.Advance();
    frame.SetArmKeyword(keyword);
    frame.SetArmDiagnosticBase(self.diagnostics.GetCount());
    if (frame.HasDefault()) {
      ParseDiagnosticKind kind = ParseDiagnosticKind.kSwitchDefaultNotLast;
      if (keyword.GetKind() == TokenKind.kKwDefault) {
        kind = ParseDiagnosticKind.kSwitchDefaultRepeated;
      }
      self.addDiagnostic(kind, keyword.GetRange());
      frame.MarkInvalid();
    }
    final var labels = ExpressionIdBuilder();
    frame.SetLabels(labels);
    if (keyword.GetKind() == TokenKind.kKwCase) {
      while (true) {
        if (self.cursor.AtEnd() ||
            self.cursor.Current().GetKind() == TokenKind.kColon ||
            self.cursor.Current().GetKind() == TokenKind.kKwCase ||
            self.cursor.Current().GetKind() == TokenKind.kKwDefault) {
          self.addDiagnostic(ParseDiagnosticKind.kExpectedSwitchLabel,
                             self.cursor.Current().GetRange());
          frame.MarkInvalid();
          break;
        }
        if (!frame.AddLabel()) {
          self.addDiagnostic(ParseDiagnosticKind.kSwitchLabelLimit,
                             self.cursor.Current().GetRange());
          frame.MarkInvalid();
          self.consumeSwitchRemainder();
          SourceLocation end = self.cursor.Current().GetRange().GetBegin();
          if (self.cursor.Match(TokenKind.kRightBrace)) {
            end = self.previousToken().GetRange().GetEnd();
          }
          self.finishSwitch(frame, end);
          return;
        }
        labels.Add(self.parseExpression());
        if (!self.cursor.Match(TokenKind.kComma)) { break; }
      }
    } else {
      frame.MarkDefault();
    }
    self.expect(TokenKind.kColon, ParseDiagnosticKind.kExpectedSwitchColon,
                frame);
    if (self.cursor.Current().GetKind() != TokenKind.kLeftBrace) {
      self.addDiagnostic(ParseDiagnosticKind.kExpectedSwitchArmBody,
                         self.cursor.Current().GetRange());
      frame.MarkInvalid();
      self.synchronizeSwitchArm();
      return;
    }
    frame.SetState(2);
    self.start(StatementParseFrameKind.kBlock, frame);
  }

  func finishSwitch(StatementParseFrame frame,
                    SourceLocation end): void throws StateError {
    if (self.requireArms(frame).GetCount() == 0) {
      self.addDiagnostic(ParseDiagnosticKind.kEmptySwitch,
                         SourceRange.PointRange(
                             self.requireKeyword(frame).GetRange().GetBegin()));
      frame.MarkInvalid();
    }
    final bool valid = frame.IsValid() && self.nodeValid(frame) &&
                       self.isValid(self.requireExpression(frame));
    self.finishStatement(frame, self.storage.AddStatement(
        SwitchStatementSyntax(
            self.requireExpression(frame), self.requireArms(frame).Finish(),
            SourceRange(self.requireKeyword(frame).GetRange().GetBegin(), end),
            valid)));
  }

  func parseSimpleStatement(): StatementId throws StateError {
    final TokenKind kind = self.cursor.Current().GetKind();
    if (kind == TokenKind.kKwReturn) { return self.parseReturn(); }
    if (kind == TokenKind.kKwBreak || kind == TokenKind.kKwContinue) {
      return self.parseLoopControl();
    }
    if (self.isLocalVariableStart()) {
      return self.parseLocal(ParseDiagnosticKind.kExpectedLocalTerminator);
    }
    return self.parseExpressionStatement();
  }

  func parseLocal(ParseDiagnosticKind terminator): StatementId
      throws StateError {
    final int32 base = self.diagnostics.GetCount();
    final SourceLocation begin = self.cursor.Current().GetRange().GetBegin();
    final bool finalBinding = self.cursor.Match(TokenKind.kKwFinal);
    TypeSyntax? type = null;
    if (!self.cursor.Match(TokenKind.kKwVar)) { type = self.parseType(); }
    final Token name = self.cursor.Current();
    bool valid = name.GetKind() == TokenKind.kIdentifier;
    if (valid) {
      self.cursor.Advance();
    } else {
      self.addDiagnostic(ParseDiagnosticKind.kExpectedLocalName,
                         name.GetRange());
    }
    ExpressionId? initializer = null;
    if (self.cursor.Match(TokenKind.kEqual)) {
      initializer = self.parseExpression();
    }
    SourceLocation end = name.GetRange().GetEnd();
    if (initializer != null) { end = self.rangeOf(initializer).GetEnd(); }
    if (self.cursor.Match(TokenKind.kSemicolon)) {
      end = self.previousToken().GetRange().GetEnd();
    } else {
      self.addDiagnostic(terminator, self.cursor.Current().GetRange());
      valid = false;
    }
    if (type != null) { valid = valid && type.IsValid(); }
    if (initializer != null) { valid = valid && self.isValid(initializer); }
    valid = valid && self.diagnostics.GetCount() == base;
    return self.storage.AddStatement(LocalVariableStatementSyntax(
        type, name.GetSpan(), initializer, finalBinding,
        SourceRange(begin, end), valid));
  }

  func parseReturn(): StatementId throws StateError {
    final int32 base = self.diagnostics.GetCount();
    final Token keyword = self.cursor.Advance();
    ExpressionId? value = null;
    if (!self.cursor.AtEnd() &&
        self.cursor.Current().GetKind() != TokenKind.kSemicolon &&
        self.cursor.Current().GetKind() != TokenKind.kRightBrace) {
      value = self.parseExpression();
    }
    SourceLocation end = keyword.GetRange().GetEnd();
    if (value != null) { end = self.rangeOf(value).GetEnd(); }
    if (self.cursor.Match(TokenKind.kSemicolon)) {
      end = self.previousToken().GetRange().GetEnd();
    } else {
      self.addDiagnostic(ParseDiagnosticKind.kExpectedReturnTerminator,
                         self.cursor.Current().GetRange());
    }
    bool valid = self.diagnostics.GetCount() == base;
    if (value != null) { valid = valid && self.isValid(value); }
    return self.storage.AddStatement(ReturnStatementSyntax(
        value, SourceRange(keyword.GetRange().GetBegin(), end), valid));
  }

  func parseLoopControl(): StatementId throws StateError {
    final int32 base = self.diagnostics.GetCount();
    final Token keyword = self.cursor.Advance();
    SourceLocation end = keyword.GetRange().GetEnd();
    if (self.cursor.Match(TokenKind.kSemicolon)) {
      end = self.previousToken().GetRange().GetEnd();
    } else {
      self.addDiagnostic(
          ParseDiagnosticKind.kExpectedLoopControlTerminator,
          self.cursor.Current().GetRange());
    }
    final SourceRange range = SourceRange(keyword.GetRange().GetBegin(), end);
    final bool valid = self.diagnostics.GetCount() == base;
    if (keyword.GetKind() == TokenKind.kKwBreak) {
      return self.storage.AddStatement(BreakStatementSyntax(range, valid));
    }
    return self.storage.AddStatement(ContinueStatementSyntax(range, valid));
  }

  func parseExpressionStatement(): StatementId throws StateError {
    final int32 base = self.diagnostics.GetCount();
    final SourceLocation begin = self.cursor.Current().GetRange().GetBegin();
    final ExpressionId expression = self.parseExpression();
    SourceLocation end = self.rangeOf(expression).GetEnd();
    if (self.cursor.Match(TokenKind.kSemicolon)) {
      end = self.previousToken().GetRange().GetEnd();
    } else {
      self.addDiagnostic(ParseDiagnosticKind.kExpectedExpressionTerminator,
                         self.cursor.Current().GetRange());
      self.synchronizeStatement();
    }
    return self.storage.AddStatement(ExpressionStatementSyntax(
        expression, SourceRange(begin, end),
        self.diagnostics.GetCount() == base && self.isValid(expression)));
  }

  func parseForVariable(): ForVariableSyntax throws StateError {
    final int32 base = self.diagnostics.GetCount();
    final SourceLocation begin = self.cursor.Current().GetRange().GetBegin();
    final bool finalBinding = self.cursor.Match(TokenKind.kKwFinal);
    TypeSyntax? type = null;
    if (!self.cursor.Match(TokenKind.kKwVar)) { type = self.parseType(); }
    final Token name = self.cursor.Current();
    if (name.GetKind() == TokenKind.kIdentifier) {
      self.cursor.Advance();
    } else {
      self.addDiagnostic(ParseDiagnosticKind.kExpectedLocalName,
                         name.GetRange());
    }
    bool valid = name.GetKind() == TokenKind.kIdentifier &&
                 self.diagnostics.GetCount() == base;
    if (type != null) { valid = valid && type.IsValid(); }
    return ForVariableSyntax(type, name.GetSpan(), finalBinding,
                             SourceRange(begin, name.GetRange().GetEnd()),
                             valid);
  }

  func parseForLocalInitializer(ForVariableSyntax variable): StatementId
      throws StateError {
    final int32 base = self.diagnostics.GetCount();
    ExpressionId? value = null;
    if (self.cursor.Match(TokenKind.kEqual)) { value = self.parseExpression(); }
    SourceLocation end = variable.GetRange().GetEnd();
    if (value != null) { end = self.rangeOf(value).GetEnd(); }
    if (self.cursor.Match(TokenKind.kSemicolon)) {
      end = self.previousToken().GetRange().GetEnd();
    } else {
      self.addDiagnostic(
          ParseDiagnosticKind.kExpectedForInitializerTerminator,
          self.cursor.Current().GetRange());
    }
    bool valid = variable.IsValid() && self.diagnostics.GetCount() == base;
    if (value != null) { valid = valid && self.isValid(value); }
    return self.storage.AddStatement(LocalVariableStatementSyntax(
        variable.GetType(), variable.GetName(), value, variable.IsFinal(),
        SourceRange(variable.GetRange().GetBegin(), end), valid));
  }

  func parseExpression(): ExpressionId throws StateError {
    final var parser = ExpressionParser(self.cursor, self.storage,
                                        self.diagnostics, false, null);
    return parser.ParseOne();
  }

  func parseType(): TypeSyntax throws StateError {
    final Token token = self.cursor.Current();
    if (self.cursor.AtEnd() ||
        !ParserFacts.CanStartType(token.GetKind())) {
      self.addDiagnostic(ParseDiagnosticKind.kExpectedType, token.GetRange());
      return TypeSyntax(token.GetSpan(), token.GetRange(), false, false,
                        false, false, false);
    }
    self.cursor.Advance();
    SourceLocation end = token.GetRange().GetEnd();
    bool valid = true;
    bool innerNullable = false;
    while (!self.cursor.AtEnd() &&
           (self.cursor.Current().GetKind() == TokenKind.kQuestion ||
            self.cursor.Current().GetKind() == TokenKind.kQuestionQuestion)) {
      final Token suffix = self.cursor.Advance();
      if (innerNullable ||
          suffix.GetKind() == TokenKind.kQuestionQuestion) {
        self.addDiagnostic(ParseDiagnosticKind.kRepeatedNullability,
                           suffix.GetRange());
        valid = false;
      }
      innerNullable = true;
      end = suffix.GetRange().GetEnd();
    }
    bool array = false;
    while (!self.cursor.AtEnd() &&
           self.cursor.Current().GetKind() == TokenKind.kLeftBracket) {
      final Token open = self.cursor.Advance();
      if (array) {
        self.addDiagnostic(ParseDiagnosticKind.kMultidimensionalArray,
                           open.GetRange());
        valid = false;
      }
      array = true;
      if (self.cursor.Match(TokenKind.kRightBracket)) {
        end = self.previousToken().GetRange().GetEnd();
      } else {
        self.addDiagnostic(ParseDiagnosticKind.kExpectedArrayClose,
                           self.cursor.Current().GetRange());
        valid = false;
        break;
      }
    }
    bool outerNullable = false;
    if (array) {
      while (!self.cursor.AtEnd() &&
             (self.cursor.Current().GetKind() == TokenKind.kQuestion ||
              self.cursor.Current().GetKind() ==
                  TokenKind.kQuestionQuestion)) {
        final Token suffix = self.cursor.Advance();
        if (outerNullable ||
            suffix.GetKind() == TokenKind.kQuestionQuestion) {
          self.addDiagnostic(ParseDiagnosticKind.kRepeatedNullability,
                             suffix.GetRange());
          valid = false;
        }
        outerNullable = true;
        end = suffix.GetRange().GetEnd();
      }
    }
    bool nullable = innerNullable;
    if (array) { nullable = outerNullable; }
    return TypeSyntax(token.GetSpan(),
                      SourceRange(token.GetRange().GetBegin(), end), valid,
                      ParserFacts.IsPrimitiveType(token.GetKind()), array,
                      nullable, array && innerNullable);
  }

  func isLocalVariableStart(): bool throws StateError {
    int32 lookahead = 0;
    if (self.cursor.Peek(lookahead).GetKind() == TokenKind.kKwFinal) {
      lookahead++;
    }
    if (self.cursor.Peek(lookahead).GetKind() == TokenKind.kKwVar) {
      return self.cursor.Peek(lookahead + 1).GetKind() ==
             TokenKind.kIdentifier;
    }
    if (!ParserFacts.CanStartType(
            self.cursor.Peek(lookahead).GetKind())) {
      return false;
    }
    lookahead++;
    while (self.cursor.Peek(lookahead).GetKind() == TokenKind.kQuestion ||
           self.cursor.Peek(lookahead).GetKind() ==
               TokenKind.kQuestionQuestion) {
      lookahead++;
    }
    if (self.cursor.Peek(lookahead).GetKind() == TokenKind.kLeftBracket &&
        self.cursor.Peek(lookahead + 1).GetKind() ==
            TokenKind.kRightBracket) {
      lookahead += 2;
      while (self.cursor.Peek(lookahead).GetKind() == TokenKind.kQuestion ||
             self.cursor.Peek(lookahead).GetKind() ==
                 TokenKind.kQuestionQuestion) {
        lookahead++;
      }
    }
    return self.cursor.Peek(lookahead).GetKind() == TokenKind.kIdentifier;
  }

  func synchronizeStatement(): void throws StateError {
    while (!self.cursor.AtEnd() &&
           self.cursor.Current().GetKind() != TokenKind.kRightBrace) {
      if (self.cursor.Match(TokenKind.kSemicolon)) { return; }
      final TokenKind kind = self.cursor.Current().GetKind();
      if (kind == TokenKind.kKwReturn || kind == TokenKind.kKwIf ||
          kind == TokenKind.kKwWhile || kind == TokenKind.kKwFor ||
          kind == TokenKind.kKwSwitch || kind == TokenKind.kKwCase ||
          kind == TokenKind.kKwDefault || kind == TokenKind.kKwBreak ||
          kind == TokenKind.kKwContinue ||
          kind == TokenKind.kLeftBrace || self.isLocalVariableStart()) {
        return;
      }
      self.cursor.Advance();
    }
  }

  func synchronizeSwitchArm(): void throws StateError {
    int32 depth = 0;
    while (!self.cursor.AtEnd()) {
      final TokenKind kind = self.cursor.Current().GetKind();
      if (depth == 0 &&
          (kind == TokenKind.kKwCase || kind == TokenKind.kKwDefault ||
           kind == TokenKind.kRightBrace)) {
        return;
      }
      if (kind == TokenKind.kLeftBrace) { depth++; }
      if (kind == TokenKind.kRightBrace) { depth--; }
      self.cursor.Advance();
    }
  }

  func consumeSwitchRemainder(): void throws StateError {
    int32 depth = 0;
    while (!self.cursor.AtEnd()) {
      final TokenKind kind = self.cursor.Current().GetKind();
      if (kind == TokenKind.kRightBrace && depth == 0) { return; }
      if (kind == TokenKind.kLeftBrace) { depth++; }
      if (kind == TokenKind.kRightBrace) { depth--; }
      self.cursor.Advance();
    }
  }

  func expect(TokenKind kind, ParseDiagnosticKind diagnostic,
              StatementParseFrame frame): void throws StateError {
    if (self.cursor.Match(kind)) { return; }
    self.addDiagnostic(diagnostic, self.cursor.Current().GetRange());
    frame.MarkInvalid();
  }

  func start(StatementParseFrameKind kind,
             StatementParseFrame? previous): void {
    self.top = StatementParseFrame(kind, previous,
                                   self.diagnostics.GetCount());
  }

  func finishBlock(StatementParseFrame frame, BlockId value): void {
    self.completedBlock = value;
    self.top = frame.GetPrevious();
  }

  func finishStatement(StatementParseFrame frame,
                       StatementId value): void {
    self.completedStatement = value;
    self.top = frame.GetPrevious();
  }

  func takeBlock(): BlockId throws StateError {
    final BlockId? value = self.completedBlock;
    self.completedBlock = null;
    if (value == null) { throw StateError("statement frame has no block"); }
    return value;
  }

  func takeStatement(): StatementId throws StateError {
    final StatementId? value = self.completedStatement;
    self.completedStatement = null;
    if (value == null) {
      throw StateError("statement frame has no statement");
    }
    return value;
  }

  func emptyBlock(SourceLocation point,
                  bool valid): BlockId throws StateError {
    final var statements = StatementIdBuilder();
    return self.storage.AddBlock(BlockNodeSyntax(
        statements.Finish(), SourceRange.PointRange(point), valid));
  }

  func nodeValid(StatementParseFrame frame): bool {
    return self.diagnostics.GetCount() == frame.GetDiagnosticBase();
  }

  func rangeOf(ExpressionId value): SourceRange throws StateError {
    return self.storage.GetExpression(value).GetRange();
  }

  func isValid(ExpressionId value): bool throws StateError {
    return self.storage.GetExpression(value).IsValid();
  }

  func previousToken(): Token throws StateError {
    if (self.cursor.GetIndex() <= self.cursor.GetBegin()) {
      throw StateError("statement cursor has no previous token");
    }
    return self.cursor.GetTokens().Get(self.cursor.GetIndex() - 1);
  }

  func addDiagnostic(ParseDiagnosticKind kind,
                     SourceRange range): void throws StateError {
    self.diagnostics.Add(ParseDiagnostic(kind, range, null));
  }

  func requireKeyword(
      StatementParseFrame frame): Token throws StateError {
    final Token? value = frame.GetKeyword();
    if (value == null) { throw StateError("statement frame has no keyword"); }
    return value;
  }

  func requireArmKeyword(
      StatementParseFrame frame): Token throws StateError {
    final Token? value = frame.GetArmKeyword();
    if (value == null) {
      throw StateError("switch frame has no arm keyword");
    }
    return value;
  }

  func requireStatements(
      StatementParseFrame frame): StatementIdBuilder throws StateError {
    final StatementIdBuilder? value = frame.GetStatements();
    if (value == null) {
      throw StateError("block frame has no statement builder");
    }
    return value;
  }

  func requireExpression(
      StatementParseFrame frame): ExpressionId throws StateError {
    final ExpressionId? value = frame.GetExpression();
    if (value == null) {
      throw StateError("statement frame has no expression");
    }
    return value;
  }

  func requireBlock(
      StatementParseFrame frame): BlockId throws StateError {
    final BlockId? value = frame.GetBlock();
    if (value == null) { throw StateError("statement frame has no block"); }
    return value;
  }

  func requireVariable(
      StatementParseFrame frame): ForVariableSyntax throws StateError {
    final ForVariableSyntax? value = frame.GetVariable();
    if (value == null) { throw StateError("for frame has no variable"); }
    return value;
  }

  func requireExpressions(
      StatementParseFrame frame): ExpressionIdBuilder throws StateError {
    final ExpressionIdBuilder? value = frame.GetExpressions();
    if (value == null) {
      throw StateError("statement frame has no expression builder");
    }
    return value;
  }

  func requireArms(
      StatementParseFrame frame): SwitchArmSyntaxBuilder throws StateError {
    final SwitchArmSyntaxBuilder? value = frame.GetArms();
    if (value == null) {
      throw StateError("switch frame has no arm builder");
    }
    return value;
  }

  func requireLabels(
      StatementParseFrame frame): ExpressionIdBuilder throws StateError {
    final ExpressionIdBuilder? value = frame.GetLabels();
    if (value == null) {
      throw StateError("switch frame has no label builder");
    }
    return value;
  }
}
