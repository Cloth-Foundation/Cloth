import frontend.diagnostic::ParseDiagnosticKind;
import frontend.parser.declaration::DeclarationParseState;
import frontend.parser.support::ParserFacts;
import frontend.parser.declaration::ThrowsClauseResult;
import frontend.parser.support::TypeParser;
import frontend.parser.storage::TypeSyntaxBuilder;
import frontend.syntax.tree::TypeSyntax;
import frontend.token::TokenKind;

class {
  static func Parse(DeclarationParseState state): ThrowsClauseResult
      throws StateError {
    final var types = TypeSyntaxBuilder();
    if (!state.Match(TokenKind.kKwThrows)) {
      return ThrowsClauseResult(types.Finish(), false);
    }
    if (!ParserFacts.CanStartType(state.Current().GetKind())) {
      state.AddDiagnostic(ParseDiagnosticKind.kExpectedThrowsType,
                          state.Current().GetRange(), null);
      return ThrowsClauseResult(types.Finish(), true);
    }
    while (!state.AtEnd()) {
      final TypeSyntax? type = TypeParser.Parse(state);
      if (type != null) { types.Add(type); }
      if (!state.Match(TokenKind.kComma)) { break; }
      if (!ParserFacts.CanStartType(state.Current().GetKind())) {
        state.AddDiagnostic(
            ParseDiagnosticKind.kExpectedThrowsSeparatorType,
            state.Current().GetRange(), null);
        break;
      }
    }
    return ThrowsClauseResult(types.Finish(), true);
  }
}
