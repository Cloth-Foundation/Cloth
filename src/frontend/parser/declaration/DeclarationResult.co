import frontend.diagnostic::ParseDiagnosticSequence;
import frontend.parser.declaration::DeclarationResultVerifier;
import frontend.parser.declaration::FileDeclarationOutline;
import frontend.parser.declaration::MemberOutlineSequence;
import frontend.source::SourceFile;
import frontend.token::TokenBuffer;

class {
  final SourceFile source;
  final TokenBuffer tokens;
  final FileDeclarationOutline file;
  final MemberOutlineSequence members;
  final ParseDiagnosticSequence diagnostics;
  final bool valid;

  _DeclarationResult(SourceFile source, TokenBuffer tokens,
                     FileDeclarationOutline file,
                     MemberOutlineSequence members,
                     ParseDiagnosticSequence diagnostics, bool valid) {
    self.source = source;
    self.tokens = tokens;
    self.file = file;
    self.members = members;
    self.diagnostics = diagnostics;
    self.valid = valid;
  }

  static func Build(
      SourceFile source, TokenBuffer tokens, FileDeclarationOutline file,
      MemberOutlineSequence members, ParseDiagnosticSequence diagnostics,
      bool valid): DeclarationResult throws StateError {
    DeclarationResultVerifier.Verify(source, tokens, file, members,
                                     diagnostics, valid);
    return DeclarationResult(source, tokens, file, members, diagnostics,
                             valid);
  }

  func GetSource(): SourceFile { return self.source; }
  func GetTokens(): TokenBuffer { return self.tokens; }
  func GetFile(): FileDeclarationOutline { return self.file; }
  func GetMembers(): MemberOutlineSequence { return self.members; }
  func GetDiagnostics(): ParseDiagnosticSequence { return self.diagnostics; }
  func IsValid(): bool { return self.valid; }
}
