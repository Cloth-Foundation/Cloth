import frontend.source::SourceRange;
import frontend.syntax.tree::EnumCaseSyntaxSequence;
import frontend.syntax.tree::FileTypeKind;
import frontend.syntax.tree::ImportSyntaxSequence;
import frontend.syntax.tree::TypeSyntax;
import frontend.syntax.tree::TypeSyntaxSequence;
import frontend.syntax.tree::Visibility;

class {
  final string name;
  final string packageName;
  final string qualifiedName;
  final Visibility visibility;
  final ImportSyntaxSequence imports;
  final TypeSyntax? baseClass;
  final TypeSyntaxSequence interfaces;
  final EnumCaseSyntaxSequence enumCases;
  final FileTypeKind kind;
  final bool explicitDeclaration;
  final bool abstractType;
  final bool sealedType;
  final SourceRange range;
  final bool valid;

  FileDeclarationOutline(
      string name, string packageName, string qualifiedName,
      Visibility visibility, ImportSyntaxSequence imports,
      TypeSyntax? baseClass, TypeSyntaxSequence interfaces,
      EnumCaseSyntaxSequence enumCases, FileTypeKind kind,
      bool explicitDeclaration, bool abstractType, bool sealedType,
      SourceRange range, bool valid) {
    self.name = name;
    self.packageName = packageName;
    self.qualifiedName = qualifiedName;
    self.visibility = visibility;
    self.imports = imports;
    self.baseClass = baseClass;
    self.interfaces = interfaces;
    self.enumCases = enumCases;
    self.kind = kind;
    self.explicitDeclaration = explicitDeclaration;
    self.abstractType = abstractType;
    self.sealedType = sealedType;
    self.range = range;
    self.valid = valid;
  }

  func GetName(): string { return self.name; }
  func GetPackageName(): string { return self.packageName; }
  func GetQualifiedName(): string { return self.qualifiedName; }
  func GetVisibility(): Visibility { return self.visibility; }
  func GetImports(): ImportSyntaxSequence { return self.imports; }
  func GetBaseClass(): TypeSyntax? { return self.baseClass; }
  func GetInterfaces(): TypeSyntaxSequence { return self.interfaces; }
  func GetEnumCases(): EnumCaseSyntaxSequence { return self.enumCases; }
  func GetFileTypeKind(): FileTypeKind { return self.kind; }
  func HasExplicitDeclaration(): bool { return self.explicitDeclaration; }
  func IsAbstract(): bool { return self.abstractType; }
  func IsSealed(): bool { return self.sealedType; }
  func GetRange(): SourceRange { return self.range; }
  func IsValid(): bool { return self.valid; }
}
