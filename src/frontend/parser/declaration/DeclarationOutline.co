import frontend.parser.support::TokenIndexRange;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;
import frontend.syntax.declaration::DeclarationKind;
import frontend.syntax.declaration::ParameterSyntaxSequence;
import frontend.syntax.tree::TypeSyntax;
import frontend.syntax.tree::TypeSyntaxSequence;
import frontend.syntax.tree::Visibility;

class {
  final DeclarationKind kind;
  final SourceSpan name;
  final Visibility visibility;
  final TypeSyntax? declaredType;
  final ParameterSyntaxSequence parameters;
  final TypeSyntaxSequence throwsTypes;
  final bool explicitThrows;
  final bool staticMember;
  final bool finalMember;
  final bool overrideMember;
  final bool abstractMember;
  final int32 beginToken;
  final TokenIndexRange? fieldInitializerTokens;
  final TokenIndexRange? constructorInitializerTokens;
  final TokenIndexRange? bodyTokens;
  final SourceRange range;
  final bool valid;

  _DeclarationOutline(
      DeclarationKind kind, SourceSpan name, Visibility visibility,
      TypeSyntax? declaredType, ParameterSyntaxSequence parameters,
      TypeSyntaxSequence throwsTypes, bool explicitThrows, bool staticMember,
      bool finalMember, bool overrideMember, bool abstractMember,
      int32 beginToken, TokenIndexRange? fieldInitializerTokens,
      TokenIndexRange? constructorInitializerTokens,
      TokenIndexRange? bodyTokens, SourceRange range, bool valid) {
    self.kind = kind;
    self.name = name;
    self.visibility = visibility;
    self.declaredType = declaredType;
    self.parameters = parameters;
    self.throwsTypes = throwsTypes;
    self.explicitThrows = explicitThrows;
    self.staticMember = staticMember;
    self.finalMember = finalMember;
    self.overrideMember = overrideMember;
    self.abstractMember = abstractMember;
    self.beginToken = beginToken;
    self.fieldInitializerTokens = fieldInitializerTokens;
    self.constructorInitializerTokens = constructorInitializerTokens;
    self.bodyTokens = bodyTokens;
    self.range = range;
    self.valid = valid;
  }

  static func Build(
      DeclarationKind kind, SourceSpan name, Visibility visibility,
      TypeSyntax? declaredType, ParameterSyntaxSequence parameters,
      TypeSyntaxSequence throwsTypes, bool explicitThrows, bool staticMember,
      bool finalMember, bool overrideMember, bool abstractMember,
      int32 beginToken, TokenIndexRange? fieldInitializerTokens,
      TokenIndexRange? constructorInitializerTokens,
      TokenIndexRange? bodyTokens, SourceRange range,
      bool valid): DeclarationOutline throws StateError {
    if (beginToken < 0 || range.GetBegin().GetFile() !=
            name.GetSource().GetPath() ||
        range.GetEnd().GetFile() != name.GetSource().GetPath() ||
        range.GetBegin().GetOffset() > range.GetEnd().GetOffset() ||
        name.GetBeginOffset() < range.GetBegin().GetOffset() ||
        name.GetEndOffset() > range.GetEnd().GetOffset()) {
      throw StateError("invalid declaration outline source shape");
    }
    if (fieldInitializerTokens != null &&
        kind != DeclarationKind.kField) {
      throw StateError("only fields may have field initializer tokens");
    }
    if (constructorInitializerTokens != null &&
        kind != DeclarationKind.kConstructor) {
      throw StateError(
          "only constructors may have constructor initializer tokens");
    }
    if (bodyTokens != null && kind == DeclarationKind.kField) {
      throw StateError("fields cannot have body tokens");
    }
    if (kind == DeclarationKind.kField &&
        (declaredType == null || parameters.GetCount() != 0 ||
         throwsTypes.GetCount() != 0 || explicitThrows || overrideMember ||
         abstractMember)) {
      throw StateError("invalid field declaration outline shape");
    }
    if (kind == DeclarationKind.kConstructor &&
        (declaredType != null || fieldInitializerTokens != null ||
         staticMember || finalMember || overrideMember || abstractMember)) {
      throw StateError("invalid constructor declaration outline shape");
    }
    if (kind == DeclarationKind.kFunction &&
        (fieldInitializerTokens != null ||
         constructorInitializerTokens != null)) {
      throw StateError("invalid function declaration outline shape");
    }
    if (valid &&
        (name.GetLength() == 0 ||
         (kind == DeclarationKind.kFunction &&
          ((abstractMember && bodyTokens != null) ||
           (!abstractMember && bodyTokens == null))) ||
         (kind == DeclarationKind.kConstructor && bodyTokens == null) ||
         (fieldInitializerTokens != null &&
          fieldInitializerTokens.IsEmpty()) ||
         (constructorInitializerTokens != null &&
          constructorInitializerTokens.IsEmpty()) ||
         (bodyTokens != null && bodyTokens.IsEmpty()))) {
      throw StateError("valid declaration outline is incomplete");
    }
    return DeclarationOutline(
        kind, name, visibility, declaredType, parameters, throwsTypes,
        explicitThrows, staticMember, finalMember, overrideMember,
        abstractMember, beginToken, fieldInitializerTokens,
        constructorInitializerTokens, bodyTokens, range, valid);
  }

  func GetKind(): DeclarationKind { return self.kind; }
  func GetName(): SourceSpan { return self.name; }
  func GetVisibility(): Visibility { return self.visibility; }
  func GetDeclaredType(): TypeSyntax? { return self.declaredType; }
  func GetParameters(): ParameterSyntaxSequence { return self.parameters; }
  func GetThrowsTypes(): TypeSyntaxSequence { return self.throwsTypes; }
  func HasExplicitThrows(): bool { return self.explicitThrows; }
  func IsStatic(): bool { return self.staticMember; }
  func IsFinal(): bool { return self.finalMember; }
  func IsOverride(): bool { return self.overrideMember; }
  func IsAbstract(): bool { return self.abstractMember; }
  func GetBeginToken(): int32 { return self.beginToken; }
  func GetFieldInitializerTokens(): TokenIndexRange? {
    return self.fieldInitializerTokens;
  }
  func GetConstructorInitializerTokens(): TokenIndexRange? {
    return self.constructorInitializerTokens;
  }
  func GetBodyTokens(): TokenIndexRange? { return self.bodyTokens; }
  func GetRange(): SourceRange { return self.range; }
  func IsValid(): bool { return self.valid; }
}
