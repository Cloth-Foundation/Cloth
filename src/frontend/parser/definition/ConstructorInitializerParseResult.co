import frontend.syntax.declaration::ConstructorInitializerSyntax;

class {
  final ConstructorInitializerSyntax? initializer;
  final int32 nextToken;
  final bool valid;

  ConstructorInitializerParseResult(
      ConstructorInitializerSyntax? initializer, int32 nextToken, bool valid) {
    self.initializer = initializer;
    self.nextToken = nextToken;
    self.valid = valid;
  }

  func GetInitializer(): ConstructorInitializerSyntax? {
    return self.initializer;
  }
  func GetNextToken(): int32 { return self.nextToken; }
  func IsValid(): bool { return self.valid; }
}
