import frontend.diagnostic::ParseDiagnostic;
import frontend.diagnostic::ParseDiagnosticSequence;
import frontend.parser.declaration::DeclarationResult;
import frontend.source::SourceRange;
import frontend.syntax.tree::FileSyntax;
import frontend.syntax.tree::VerifiedSyntaxTree;

class {
  static func Verify(
      DeclarationResult declaration, VerifiedSyntaxTree tree,
      ParseDiagnosticSequence diagnostics,
      bool valid): void throws StateError {
    final FileSyntax file = tree.GetFile();
    if (file.GetSource() != declaration.GetSource() ||
        file.GetDeclarations().GetCount() !=
            declaration.GetMembers().GetCount()) {
      throw StateError("definition result does not match its declaration");
    }
    final var outline = declaration.GetFile();
    if (file.GetName() != outline.GetName() ||
        file.GetPackageName() != outline.GetPackageName() ||
        file.GetQualifiedName() != outline.GetQualifiedName() ||
        file.GetVisibility() != outline.GetVisibility() ||
        file.GetFileTypeKind() != outline.GetFileTypeKind() ||
        file.HasExplicitDeclaration() != outline.HasExplicitDeclaration() ||
        file.IsAbstract() != outline.IsAbstract() ||
        file.IsSealed() != outline.IsSealed()) {
      throw StateError("definition file identity changed after declaration");
    }
    int32 previousOffset = -1;
    for (int32 index = 0; index < diagnostics.GetCount(); index++) {
      final ParseDiagnostic value = diagnostics.Get(index);
      verifyRange(file.GetRange(), value.GetRange());
      if (value.GetRange().GetBegin().GetOffset() < previousOffset) {
        throw StateError("definition diagnostics are not in source order");
      }
      previousOffset = value.GetRange().GetBegin().GetOffset();
      final SourceRange? related = value.GetRelatedRange();
      if (related != null) { verifyRange(file.GetRange(), related); }
    }
    final bool expected = declaration.IsValid() && file.IsValid() &&
                          diagnostics.GetCount() == 0;
    if (valid != expected) {
      throw StateError("definition result validity is inconsistent");
    }
  }

  static func verifyRange(SourceRange parent,
                          SourceRange value): void throws StateError {
    if (value.GetBegin().GetFile() != parent.GetBegin().GetFile() ||
        value.GetEnd().GetFile() != parent.GetEnd().GetFile() ||
        value.GetBegin().GetOffset() < parent.GetBegin().GetOffset() ||
        value.GetBegin().GetOffset() > value.GetEnd().GetOffset() ||
        value.GetEnd().GetOffset() > parent.GetEnd().GetOffset()) {
      throw StateError("definition diagnostic is outside its source");
    }
  }
}
