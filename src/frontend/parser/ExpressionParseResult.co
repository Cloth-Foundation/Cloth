import frontend.syntax::ExpressionId;

class {
  final ExpressionId root;
  final int32 nextToken;
  final bool valid;

  ExpressionParseResult(ExpressionId root, int32 nextToken, bool valid) {
    self.root = root;
    self.nextToken = nextToken;
    self.valid = valid;
  }

  func GetRoot(): ExpressionId { return self.root; }
  func GetNextToken(): int32 { return self.nextToken; }
  func IsValid(): bool { return self.valid; }
}
