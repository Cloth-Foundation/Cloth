import frontend.parser.storage::TypeSyntaxPage;
import frontend.syntax.tree::TypeSyntax;
import frontend.syntax.tree::TypeSyntaxSequence;

class {
  TypeSyntaxPage? first;
  TypeSyntaxPage? last;
  int32 count;
  bool finished;

  TypeSyntaxBuilder() {
    self.first = null;
    self.last = null;
    self.count = 0;
    self.finished = false;
  }

  func Add(TypeSyntax value): void throws StateError {
    if (self.finished) {
      throw StateError("type syntax builder is already finished");
    }
    if (self.count == 2147483647) {
      throw StateError("type syntax count overflow");
    }
    if (self.last == null || self.last!.IsFull()) {
      final TypeSyntaxPage page = TypeSyntaxPage();
      if (self.last == null) {
        self.first = page;
      } else {
        self.last!.Link(page);
      }
      self.last = page;
    }
    self.last!.Add(value);
    self.count++;
  }

  func Finish(): TypeSyntaxSequence throws StateError {
    if (self.finished) {
      throw StateError("type syntax builder is already finished");
    }
    self.finished = true;
    final TypeSyntax?[] values = TypeSyntax?[:self.count];
    TypeSyntaxPage? current = self.first;
    int32 output = 0;
    while (current != null) {
      final TypeSyntaxPage page = current;
      for (int32 index = 0; index < page.GetCount(); index++) {
        if (output >= self.count) {
          throw StateError("type syntax builder exceeds its count");
        }
        values[output] = page.Get(index);
        output++;
      }
      current = page.GetNext();
      page.Seal();
    }
    if (output != self.count) {
      throw StateError("type syntax builder does not match its count");
    }
    return TypeSyntaxSequence.Build(values);
  }

  func GetCount(): int32 { return self.count; }
  func IsFinished(): bool { return self.finished; }
}
