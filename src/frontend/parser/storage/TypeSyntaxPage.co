import frontend.syntax.tree::TypeSyntax;

class {
  static final int32 pageCapacity = 64;

  final TypeSyntax?[] values;
  int32 count;
  TypeSyntaxPage? next;
  bool frozen;

  TypeSyntaxPage() {
    self.values = TypeSyntax?[:pageCapacity];
    self.count = 0;
    self.next = null;
    self.frozen = false;
  }

  func Add(TypeSyntax value): void throws StateError {
    if (self.frozen) { throw StateError("type syntax page is sealed"); }
    if (self.count >= self.values::length) {
      throw StateError("type syntax page is full");
    }
    self.values[self.count] = value;
    self.count++;
  }

  func Get(int32 index): TypeSyntax throws StateError {
    if (index < 0 || index >= self.count) {
      throw StateError("type syntax page index is out of bounds");
    }
    return self.values[index]!;
  }

  func Link(TypeSyntaxPage next): void throws StateError {
    if (self.frozen) { throw StateError("type syntax page is sealed"); }
    if (self.next != null) {
      throw StateError("type syntax page is already linked");
    }
    self.next = next;
  }

  func Seal(): void throws StateError {
    if (self.frozen) { throw StateError("type syntax page is already sealed"); }
    self.frozen = true;
  }

  func IsFull(): bool { return self.count == self.values::length; }
  func GetCount(): int32 { return self.count; }
  func GetNext(): TypeSyntaxPage? { return self.next; }
}
