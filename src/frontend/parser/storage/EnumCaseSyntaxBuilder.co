import frontend.parser.storage::EnumCaseSyntaxPage;
import frontend.syntax.tree::EnumCaseSyntax;
import frontend.syntax.tree::EnumCaseSyntaxSequence;

class {
  EnumCaseSyntaxPage? first;
  EnumCaseSyntaxPage? last;
  int32 count;
  bool finished;

  EnumCaseSyntaxBuilder() {
    self.first = null;
    self.last = null;
    self.count = 0;
    self.finished = false;
  }

  func Add(EnumCaseSyntax value): void throws StateError {
    if (self.finished) {
      throw StateError("enum case syntax builder is already finished");
    }
    if (self.count == 2147483647) {
      throw StateError("enum case syntax count overflow");
    }
    if (self.last == null || self.last!.IsFull()) {
      final EnumCaseSyntaxPage page = EnumCaseSyntaxPage();
      if (self.last == null) {
        self.first = page;
      } else {
        self.last!.Link(page);
      }
      self.last = page;
    }
    self.last!.Add(value);
    self.count++;
  }

  func Finish(): EnumCaseSyntaxSequence throws StateError {
    if (self.finished) {
      throw StateError("enum case syntax builder is already finished");
    }
    self.finished = true;
    final EnumCaseSyntax?[] values = EnumCaseSyntax?[:self.count];
    EnumCaseSyntaxPage? current = self.first;
    int32 output = 0;
    while (current != null) {
      final EnumCaseSyntaxPage page = current;
      for (int32 index = 0; index < page.GetCount(); index++) {
        if (output >= self.count) {
          throw StateError("enum case syntax builder exceeds its count");
        }
        values[output] = page.Get(index);
        output++;
      }
      current = page.GetNext();
      page.Seal();
    }
    if (output != self.count) {
      throw StateError("enum case syntax builder does not match its count");
    }
    return EnumCaseSyntaxSequence.Build(values);
  }

  func GetCount(): int32 { return self.count; }
  func IsFinished(): bool { return self.finished; }
}
