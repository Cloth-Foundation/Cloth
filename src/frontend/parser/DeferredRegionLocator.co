import frontend.diagnostic::ParseDiagnosticKind;
import frontend.parser::DeclarationLookahead;
import frontend.parser::DeclarationParseState;
import frontend.parser::ParserFacts;
import frontend.parser::TokenIndexRange;
import frontend.token::TokenKind;

class {
  static func LocateBody(DeclarationParseState state): TokenIndexRange?
      throws StateError {
    if (state.Current().GetKind() != TokenKind.kLeftBrace) {
      state.AddDiagnostic(ParseDiagnosticKind.kExpectedBody,
                          state.Current().GetRange(), null);
      return null;
    }
    final int32 begin = state.GetIndex();
    int32 depth = 0;
    while (!state.AtEnd()) {
      if (state.Current().GetKind() == TokenKind.kLeftBrace) {
        depth++;
      }
      if (state.Current().GetKind() == TokenKind.kRightBrace) {
        depth--;
      }
      state.Advance();
      if (depth == 0) {
        return TokenIndexRange(begin, state.GetIndex());
      }
    }
    state.AddDiagnostic(ParseDiagnosticKind.kUnterminatedBody,
                        state.GetTokens().Get(begin).GetRange(), null);
    return TokenIndexRange(begin, state.GetTokens().GetCount() - 1);
  }

  static func LocateFieldInitializer(
      DeclarationParseState state): TokenIndexRange throws StateError {
    final int32 begin = state.GetIndex();
    int32 depth = 0;
    while (!state.AtEnd()) {
      final TokenKind kind = state.Current().GetKind();
      if (kind == TokenKind.kLeftParen || kind == TokenKind.kLeftBracket) {
        depth++;
      }
      if ((kind == TokenKind.kRightParen ||
           kind == TokenKind.kRightBracket) && depth != 0) {
        depth--;
      }
      if (depth == 0 && isFieldBoundary(state, begin)) { break; }
      state.Advance();
    }
    final TokenIndexRange result = TokenIndexRange(begin, state.GetIndex());
    if (result.IsEmpty()) {
      state.AddDiagnostic(ParseDiagnosticKind.kExpectedFieldInitializer,
                          state.Current().GetRange(), null);
    }
    return result;
  }

  static func LocateConstructorInitializer(
      DeclarationParseState state): TokenIndexRange throws StateError {
    final int32 begin = state.GetIndex();
    int32 depth = 0;
    while (!state.AtEnd()) {
      final TokenKind kind = state.Current().GetKind();
      if (kind == TokenKind.kLeftBrace && depth == 0) { break; }
      if (kind == TokenKind.kLeftParen) { depth++; }
      if (kind == TokenKind.kRightParen && depth != 0) { depth--; }
      state.Advance();
    }
    final TokenIndexRange result = TokenIndexRange(begin, state.GetIndex());
    if (result.IsEmpty()) {
      state.AddDiagnostic(
          ParseDiagnosticKind.kExpectedConstructorInitializer,
          state.Current().GetRange(), null);
    }
    return result;
  }

  static func SkipNestedType(DeclarationParseState state) throws StateError {
    state.AddDiagnostic(ParseDiagnosticKind.kNestedTypeUnsupported,
                        state.Current().GetRange(), null);
    state.Advance();
    if (state.Current().GetKind() == TokenKind.kIdentifier) {
      state.Advance();
    }
    if (state.Current().GetKind() == TokenKind.kLeftBrace) {
      LocateBody(state);
      return;
    }
    while (!state.AtEnd() && !state.Match(TokenKind.kSemicolon)) {
      state.Advance();
    }
  }

  static func SynchronizeMember(
      DeclarationParseState state) throws StateError {
    while (!state.AtEnd()) {
      if (state.HasBodyStarted() &&
          state.Current().GetKind() == TokenKind.kRightBrace) {
        return;
      }
      if (state.Match(TokenKind.kSemicolon)) { return; }
      if (DeclarationLookahead.LooksLikeMemberStart(state)) { return; }
      state.Advance();
    }
  }

  static func isFieldBoundary(DeclarationParseState state,
                              int32 begin): bool throws StateError {
    final TokenKind kind = state.Current().GetKind();
    if (kind == TokenKind.kSemicolon ||
        (state.HasBodyStarted() && kind == TokenKind.kRightBrace) ||
        kind == TokenKind.kKwFunc || kind == TokenKind.kKwStatic ||
        kind == TokenKind.kKwOverride || ParserFacts.IsNestedType(kind)) {
      return true;
    }
    if (kind == TokenKind.kKwFinal &&
        ParserFacts.CanStartType(state.Peek(1).GetKind())) {
      return true;
    }
    return state.GetIndex() != begin && ParserFacts.CanStartType(kind) &&
           state.Peek(1).GetKind() == TokenKind.kIdentifier;
  }
}
