import frontend.diagnostic::LexDiagnostic;
import frontend.lexer::LexerResult;
import frontend.package::PackageIdentity;
import frontend.package::PackagePath;
import frontend.package::PackageSource;
import frontend.parser.declaration::DeclarationResult;
import frontend.parser.definition::DefinitionResult;
import frontend.parser.support::TokenBufferVerifier;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;

class {
  final PackageIdentity identity;
  final PackageSource packageSource;
  final string sourcePackage;
  final string fileName;
  final string qualifiedName;
  final LexerResult lexer;
  final DeclarationResult? declaration;
  final DefinitionResult? definition;
  final bool valid;

  _FileFrontendResult(
      PackageIdentity identity, PackageSource packageSource,
      string sourcePackage, string fileName, string qualifiedName,
      LexerResult lexer, DeclarationResult? declaration,
      DefinitionResult? definition, bool valid) {
    self.identity = identity;
    self.packageSource = packageSource;
    self.sourcePackage = sourcePackage;
    self.fileName = fileName;
    self.qualifiedName = qualifiedName;
    self.lexer = lexer;
    self.declaration = declaration;
    self.definition = definition;
    self.valid = valid;
  }

  static func Build(
      PackageIdentity identity, PackageSource packageSource,
      string sourcePackage, string fileName, string qualifiedName,
      LexerResult lexer, DeclarationResult? declaration,
      DefinitionResult? definition): FileFrontendResult throws StateError {
    final string expectedPackage =
        PackagePath.SourcePackage(packageSource.GetLogicalPath());
    final string expectedFile =
        PackagePath.FileName(packageSource.GetLogicalPath());
    final string expectedQualified =
        PackagePath.QualifiedName(identity, expectedPackage, expectedFile);
    if (sourcePackage != expectedPackage || fileName != expectedFile ||
        qualifiedName != expectedQualified) {
      throw StateError("frontend file result identity is inconsistent");
    }
    verifyLexicalResult(packageSource, lexer);
    final int32 lexicalDiagnosticCount =
        lexer.GetDiagnostics().GetCount();
    if (lexicalDiagnosticCount != 0) {
      if (declaration != null || definition != null) {
        throw StateError("lexically invalid frontend result contains parser results");
      }
      return FileFrontendResult(
          identity, packageSource, sourcePackage, fileName, qualifiedName,
          lexer, null, null, false);
    }
    if (declaration == null || definition == null) {
      throw StateError("lexically valid frontend result lacks parser results");
    }

    final DeclarationResult declarationValue = declaration;
    final DefinitionResult definitionValue = definition;
    if (declarationValue.GetSource() != packageSource.GetSource() ||
        declarationValue.GetTokens() != lexer.GetTokens() ||
        declarationValue.GetFile().GetPackageName() != sourcePackage ||
        declarationValue.GetFile().GetOwningPackageName() !=
            identity.GetName() ||
        declarationValue.GetFile().GetName() != fileName ||
        declarationValue.GetFile().GetQualifiedName() != qualifiedName ||
        definitionValue.GetDeclaration() != declarationValue ||
        definitionValue.GetTree().GetFile().GetSource() !=
            packageSource.GetSource() ||
        definitionValue.GetTree().GetFile().GetOwningPackageName() !=
            identity.GetName() ||
        definitionValue.GetTree().GetFile().GetQualifiedName() !=
            qualifiedName) {
      throw StateError("frontend file result identity is inconsistent");
    }
    return FileFrontendResult(
        identity, packageSource, sourcePackage, fileName, qualifiedName, lexer,
        declarationValue, definitionValue, definitionValue.IsValid());
  }

  func GetIdentity(): PackageIdentity { return self.identity; }
  func GetPackageSource(): PackageSource { return self.packageSource; }
  func GetSourcePackage(): string { return self.sourcePackage; }
  func GetFileName(): string { return self.fileName; }
  func GetQualifiedName(): string { return self.qualifiedName; }
  func GetLexer(): LexerResult { return self.lexer; }
  func GetDeclaration(): DeclarationResult? { return self.declaration; }
  func GetDefinition(): DefinitionResult? { return self.definition; }
  func IsValid(): bool { return self.valid; }

  static func verifyLexicalResult(PackageSource packageSource,
                                  LexerResult lexer) throws StateError {
    TokenBufferVerifier.Verify(packageSource.GetSource(), lexer.GetTokens());
    for (int32 index = 0;
         index < lexer.GetDiagnostics().GetCount(); index++) {
      final LexDiagnostic diagnostic = lexer.GetDiagnostics().Get(index);
      final SourceSpan span = diagnostic.GetSpan();
      final SourceRange range = diagnostic.GetRange();
      if (span.GetSource() != packageSource.GetSource() ||
          range.GetBegin().GetFile() != packageSource.GetSource().GetPath() ||
          range.GetEnd().GetFile() != packageSource.GetSource().GetPath() ||
          range.GetBegin().GetOffset() < 0 ||
          range.GetBegin().GetOffset() > range.GetEnd().GetOffset() ||
          range.GetEnd().GetOffset() > packageSource.GetSource().GetLength()) {
        throw StateError("frontend lexical diagnostic has foreign source ownership");
      }
    }
  }
}
