import frontend.lexer::ByteClass;
import frontend.lexer::KeywordClassifier;
import frontend.source::SourceCursor;
import frontend.source::SourceSpan;
import frontend.token::TokenKind;

class {
  static func Scan(SourceCursor cursor): TokenKind throws StateError {
    final int32 beginOffset = cursor.GetOffset();
    while (!cursor.AtEnd() &&
           ByteClass.IsIdentifierContinue(cursor.Peek(0))) {
      cursor.Advance();
    }

    final var span = SourceSpan(cursor.GetSource(), beginOffset,
                                cursor.GetOffset());
    return KeywordClassifier.Classify(span);
  }
}

