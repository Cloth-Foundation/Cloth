import frontend.diagnostic::LexDiagnosticKind;
import frontend.source::SourceRange;
import frontend.source::SourceSpan;

class {
  final LexDiagnosticKind kind;
  final SourceSpan span;
  final SourceRange range;

  LexDiagnostic(LexDiagnosticKind kind, SourceSpan span, SourceRange range) {
    self.kind = kind;
    self.span = span;
    self.range = range;
  }

  func GetKind(): LexDiagnosticKind {
    return self.kind;
  }

  func GetSpan(): SourceSpan {
    return self.span;
  }

  func GetRange(): SourceRange {
    return self.range;
  }
}
