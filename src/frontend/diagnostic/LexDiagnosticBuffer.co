import frontend.diagnostic::LexDiagnostic;

class {
  final LexDiagnostic?[] values;
  int32 count;

  LexDiagnosticBuffer(int32 capacity) {
    self.values = LexDiagnostic?[:capacity];
    self.count = 0;
  }

  func Add(LexDiagnostic value) throws StateError {
    if (self.count >= self.values::length) {
      throw StateError("lexical diagnostic buffer overflow");
    }
    self.values[self.count] = value;
    self.count++;
  }

  func Get(int32 index): LexDiagnostic throws StateError {
    if (index < 0 || index >= self.count) {
      throw StateError("lexical diagnostic index is out of bounds");
    }
    return self.values[index]!;
  }

  func GetCount(): int32 {
    return self.count;
  }

  func GetCapacity(): int32 {
    return self.values::length;
  }
}
