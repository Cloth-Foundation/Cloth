import frontend.diagnostic::ParseDiagnostic;

class {
  static final int32 pageCapacity = 64;

  final ParseDiagnostic?[] values;
  int32 count;
  ParseDiagnosticPage? next;
  bool frozen;

  ParseDiagnosticPage() {
    self.values = ParseDiagnostic?[:pageCapacity];
    self.count = 0;
    self.next = null;
    self.frozen = false;
  }

  func Add(ParseDiagnostic value): void throws StateError {
    if (self.frozen) {
      throw StateError("parse diagnostic page is sealed");
    }
    if (self.count >= self.values::length) {
      throw StateError("parse diagnostic page is full");
    }
    self.values[self.count] = value;
    self.count++;
  }

  func Get(int32 index): ParseDiagnostic throws StateError {
    if (index < 0 || index >= self.count) {
      throw StateError("parse diagnostic page index is out of bounds");
    }
    return self.values[index]!;
  }

  func Link(ParseDiagnosticPage next): void throws StateError {
    if (self.frozen) {
      throw StateError("parse diagnostic page is sealed");
    }
    if (self.next != null) {
      throw StateError("parse diagnostic page is already linked");
    }
    self.next = next;
  }

  func Seal(): void throws StateError {
    if (self.frozen) {
      throw StateError("parse diagnostic page is already sealed");
    }
    self.frozen = true;
  }

  func IsFull(): bool { return self.count == self.values::length; }
  func GetCount(): int32 { return self.count; }
  func GetNext(): ParseDiagnosticPage? { return self.next; }
}
