import bootstrap::DeclarationSubstrateCheck;
import bootstrap::DeclarationSubstrateFailure;
import bootstrap::DeclarationSubstrateGcCheck;
import bootstrap::DeclarationGrammarCheck;
import bootstrap::DeclarationGrammarGcCheck;
import bootstrap::DeclarationRecordWriter;
import bootstrap::DefinitionParserCheck;
import bootstrap::DefinitionParserDepthCheck;
import bootstrap::DefinitionParserGcCheck;
import bootstrap::DefinitionRecordWriter;
import bootstrap::ExpressionParserCheck;
import bootstrap::ExpressionParserDepthCheck;
import bootstrap::ExpressionParserGcCheck;
import bootstrap::LexerFoundationCheck;
import bootstrap::LexerLiteralCheck;
import bootstrap::LexRecordWriter;
import bootstrap::SyntaxStorageCheck;
import bootstrap::SyntaxStorageFailure;
import bootstrap::SyntaxTreeCheck;
import bootstrap::SyntaxTreeGcCheck;
import bootstrap::SyntaxTreeFailure;
import bootstrap::SyntaxTreeRecordWriter;

static func Main(string[] args): int32 throws IoError, StateError {
  if (args::length == 3 && args[0] == "--definition-records") {
    return DefinitionRecordWriter.Run(args[1], args[2]);
  }
  if (args::length == 1 && args[0] == "--definition-depth-check") {
    final int32 definitionDepthStatus = DefinitionParserDepthCheck.Run();
    if (definitionDepthStatus != 0) { println(definitionDepthStatus); }
    return definitionDepthStatus;
  }
  if (args::length == 1 && args[0] == "--definition-gc-check") {
    final int32 definitionGcStatus = DefinitionParserGcCheck.Run();
    if (definitionGcStatus != 0) { println(definitionGcStatus); }
    return definitionGcStatus;
  }
  if (args::length == 1 && args[0] == "--expression-depth-check") {
    final int32 depthStatus = ExpressionParserDepthCheck.Run();
    if (depthStatus != 0) { println(depthStatus); }
    return depthStatus;
  }
  if (args::length == 1 && args[0] == "--expression-gc-check") {
    final int32 gcStatus = ExpressionParserGcCheck.Run();
    if (gcStatus != 0) { println(gcStatus); }
    return gcStatus;
  }
  if (args::length == 3 && args[0] == "--declaration-records") {
    return DeclarationRecordWriter.Run(args[1], args[2]);
  }
  if (args::length == 1 && args[0] == "--declaration-grammar-gc-check") {
    return DeclarationGrammarGcCheck.Run();
  }
  if (args::length == 2 && args[0] == "--declaration-substrate-failure") {
    return DeclarationSubstrateFailure.Run(args[1]);
  }
  if (args::length == 1 && args[0] == "--declaration-substrate-gc-check") {
    return DeclarationSubstrateGcCheck.Run();
  }
  if (args::length == 2 && args[0] == "--lex-records") {
    return LexRecordWriter.Run(args[1]);
  }
  if (args::length == 2 && args[0] == "--syntax-storage-failure") {
    return SyntaxStorageFailure.Run(args[1]);
  }
  if (args::length == 1 && args[0] == "--syntax-tree-records") {
    return SyntaxTreeRecordWriter.Run();
  }
  if (args::length == 1 && args[0] == "--syntax-tree-gc-check") {
    return SyntaxTreeGcCheck.Run();
  }
  if (args::length == 2 && args[0] == "--syntax-tree-failure") {
    return SyntaxTreeFailure.Run(args[1]);
  }

  final int32 status = LexerFoundationCheck.Run();
  if (status != 0) {
    println(status);
    return status;
  }

  final int32 literalStatus = LexerLiteralCheck.Run();
  if (literalStatus != 0) {
    println(literalStatus);
    return literalStatus;
  }

  final int32 declarationStatus = DeclarationSubstrateCheck.Run();
  if (declarationStatus != 0) {
    println(declarationStatus);
    return declarationStatus;
  }

  final int32 grammarStatus = DeclarationGrammarCheck.Run();
  if (grammarStatus != 0) {
    println(grammarStatus);
    return grammarStatus;
  }

  final int32 storageStatus = SyntaxStorageCheck.Run();
  if (storageStatus != 0) {
    println(storageStatus);
    return storageStatus;
  }

  final int32 definitionStatus = DefinitionParserCheck.Run();
  if (definitionStatus != 0) {
    println(definitionStatus);
    return definitionStatus;
  }

  final int32 definitionDepthStatus = DefinitionParserDepthCheck.Run();
  if (definitionDepthStatus != 0) {
    println(definitionDepthStatus);
    return definitionDepthStatus;
  }

  final int32 definitionGcStatus = DefinitionParserGcCheck.Run();
  if (definitionGcStatus != 0) {
    println(definitionGcStatus);
    return definitionGcStatus;
  }

  final int32 expressionStatus = ExpressionParserCheck.Run();
  if (expressionStatus != 0) {
    println(expressionStatus);
    return expressionStatus;
  }

  final int32 treeStatus = SyntaxTreeCheck.Run();
  if (treeStatus != 0) {
    println(treeStatus);
    return treeStatus;
  }

  println("lexer literals ok");
  return 0;
}
