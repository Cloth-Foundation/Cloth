import cloth.io::Console;

import frontend.package::FrontendCoordinator;
import frontend.package::PackageFrontendInput;
import frontend.package::PackageFrontendResult;
import frontend.package::PackageIdentity;
import frontend.package::PackageSource;
import frontend.source::SourceFile;
import semantic.diagnostic::SemanticDiagnosticRenderer;
import semantic.package::PackageSymbolCollector;
import semantic.package::SemanticDependency;
import semantic.package::SemanticPackageInput;
import semantic.package::SemanticPackageResult;

class {
  static func Run(string[] args): int32 throws IoError, StateError {
    if (args::length == 1 &&
        (args[0] == "--help" || args[0] == "-h")) {
      printUsage();
      return 0;
    }
    if (args::length == 1 && args[0] == "--version") {
      println("clothc 0.0.1");
      return 0;
    }
    if (args::length == 2 && args[0] == "check") {
      return checkFile(args[1]);
    }

    Console.WriteErrorLine("clothc: expected 'check <file.co>'");
    printErrorUsage();
    return 2;
  }

  static func checkFile(string path): int32 throws IoError, StateError {
    final string name = fileName(path);
    if (name::isEmpty) {
      Console.WriteErrorLine("clothc: source path must name a .co file");
      return 2;
    }

    final SourceFile source = SourceFile.Load(path);
    final PackageSource?[] sources = PackageSource?[:1];
    sources[0] = PackageSource.Build(name + ".co", source);
    final PackageFrontendInput input = PackageFrontendInput.Build(
        PackageIdentity.Build("", ""), sources);
    final PackageFrontendResult frontend = FrontendCoordinator.Check(input);
    final SemanticPackageResult result = PackageSymbolCollector.Collect(
        SemanticPackageInput.Build(frontend, SemanticDependency?[:0]));
    if (!result.IsValid()) {
      Console.WriteError(SemanticDiagnosticRenderer.Render(result));
      return 1;
    }
    return 0;
  }

  static func fileName(string path): string {
    if (path::length < 4 ||
        path::slice(path::length - 3, path::length) != ".co") {
      return "";
    }
    int32 begin = 0;
    int32 end = path::length;
    for (int32 index = 0; index < path::length; index++) {
      final char value = path[index];
      if (value == '/' || value == '\\') {
        begin = index + 1;
        end = path::length;
      } else {
        if (value == '.') { end = index; }
      }
    }
    if (end <= begin) { return ""; }
    final string name = path::slice(begin, end);
    if (name::byteLength != name::length) { return ""; }
    final string printable =
        " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`" +
        "abcdefghijklmnopqrstuvwxyz{|}~";
    for (int32 index = 0; index < name::length; index++) {
      bool found = false;
      for (int32 rank = 0; rank < printable::length; rank++) {
        if (name[index] == printable[rank]) { found = true; }
      }
      if (!found) { return ""; }
    }
    return name;
  }

  static func printUsage(): void {
    println("Usage: clothc check <file.co>");
    println("       clothc --help");
    println("       clothc --version");
  }

  static func printErrorUsage(): void {
    Console.WriteErrorLine("Usage: clothc check <file.co>");
    Console.WriteErrorLine("       clothc --help");
    Console.WriteErrorLine("       clothc --version");
  }
}
