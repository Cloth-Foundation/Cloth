import std.algorithm : canFind, findSplit, max, sort;
import std.array : appender, split;
import std.conv : to;
import std.digest : LetterCase, toHexString;
import std.digest.sha : sha256Of;
import std.exception : enforce;
import std.file : mkdirRecurse, read, write;
import std.format : formattedWrite;
import std.path : buildPath;
import std.range : empty;
import std.stdio : stderr, writefln;
import std.string : lineSplitter, strip;
import std.zlib : Compress, HeaderFormat;

private enum unicodeVersion = "17.0.0";
private enum outputDir = "Compiler/src/main/resources/cloth/unicode/" ~ unicodeVersion;
private enum oracleDir = "Compiler/src/test/resources/cloth/unicode/" ~ unicodeVersion;
private enum tableCredits =
    "# Copyright © 2025 Unicode, Inc.; SPDX-License-Identifier: Unicode-3.0\n" ~
    "# License: LICENSE.txt. Generated by GenerateUnicodeCharacterTables; do not edit.\n";

private enum Input { generalCategory, coreProperties, propList, unicodeData, license }

private struct InputFile {
    string name;
    string sha256;
}

private immutable InputFile[5] inputFiles = [
    InputFile("DerivedGeneralCategory.txt", "d62e5bab70ca74f099343f71224fa051cb1fdd61a1ab45c0488c44cfc0b6102e"),
    InputFile("DerivedCoreProperties.txt", "24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08"),
    InputFile("PropList.txt", "130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd"),
    InputFile("UnicodeData.txt", "2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"),
    InputFile("LICENSE.txt", "e7a93b009565cfce55919a381437ac4db883e9da2126fa28b91d12732bc53d96"),
];

private struct CodeRange {
    uint first;
    uint last;
}

private struct CaseMapping {
    uint scalar;
    uint mapped;
}

// Run from the repository root with dmd -run UnicodeGenerator/UnicodeGenerator.d <input-directory>.
int main(string[] args) {
    try {
        enforce(args.length == 2, "Supply the directory containing the five pinned Unicode input files");
        generateTables(args[1]);
        return 0;
    } catch (Exception error) {
        stderr.writeln(error.msg);
        return 1;
    }
}

private void generateTables(string inputDir) {
    const(void)[][inputFiles.length] files;
    foreach (index, input; inputFiles) {
        const bytes = read(buildPath(inputDir, input.name));
        enforce(toHexString!(LetterCase.lower)(sha256Of(bytes)) == input.sha256,
            "Unexpected Unicode input hash: " ~ input.name);
        files[index] = bytes;
    }

    CodeRange[][string] properties;
    collectRanges(cast(const(char)[]) files[Input.generalCategory], [
        "Lu": "LETTER", "Ll": "LETTER", "Lt": "LETTER", "Lm": "LETTER", "Lo": "LETTER",
        "Nd": "DIGIT",
    ], properties);
    collectRanges(cast(const(char)[]) files[Input.coreProperties], [
        "Uppercase": "UPPERCASE", "Lowercase": "LOWERCASE",
    ], properties);

    auto table = appender!string();
    table.put("# Unicode " ~ unicodeVersion ~ " character properties\n" ~ tableCredits ~
        "# Sources: https://www.unicode.org/Public/17.0.0/ucd/extracted/DerivedGeneralCategory.txt\n" ~
        "#          https://www.unicode.org/Public/17.0.0/ucd/DerivedCoreProperties.txt\n");
    foreach (index, input; inputFiles) {
        if (index != Input.unicodeData) {
            table.formattedWrite("# SHA256 %s %s\n", input.name, input.sha256);
        }
    }
    foreach (property; ["LETTER", "DIGIT", "UPPERCASE", "LOWERCASE"]) {
        const ranges = mergeRanges(properties.get(property, null));
        enforce(ranges.length != 0, "Missing Unicode property: " ~ property);
        uint scalars;
        foreach (range; ranges) {
            table.formattedWrite("%s;%x;%x\n", property, range.first, range.last);
            scalars += range.last - range.first + 1;
        }
        writefln("%s: %s ranges, %s scalars", property, ranges.length, scalars);
    }

    auto mappings = collectMappings(cast(const(char)[]) files[Input.unicodeData]);
    auto casing = appender!string();
    casing.put("# Unicode " ~ unicodeVersion ~ " simple character case mappings\n" ~ tableCredits ~
        "# Source: https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt\n");
    casing.formattedWrite("# SHA256 UnicodeData.txt %s\n", inputFiles[Input.unicodeData].sha256);
    foreach (index, kind; ["UPPER", "LOWER"]) {
        auto entries = mappings[index];
        enforce(entries.length != 0, "Missing simple case mappings: " ~ kind);
        entries.sort!((a, b) => a.scalar < b.scalar);
        foreach (i, entry; entries) {
            enforce(i == 0 || entries[i - 1].scalar != entry.scalar, "Duplicate simple case mapping");
            casing.formattedWrite("%s;%x;%x\n", kind, entry.scalar, entry.mapped);
        }
        writefln("%s: %s simple mappings", kind, entries.length);
    }

    mkdirRecurse(outputDir);
    mkdirRecurse(oracleDir);
    write(buildPath(outputDir, "character-ranges.txt"), table.data);
    write(buildPath(outputDir, "character-case-mappings.txt"), casing.data);
    write(buildPath(outputDir, "LICENSE.txt"), files[Input.license]);
    foreach (index, input; inputFiles[0 .. Input.license]) {
        auto gzip = new Compress(HeaderFormat.gzip);
        ubyte[] compressed;
        compressed ~= cast(const(ubyte)[]) gzip.compress(files[index]);
        compressed ~= cast(const(ubyte)[]) gzip.flush();
        // Use the same platform-independent OS marker as the checked-in fixtures.
        compressed[9] = 0xff;
        write(buildPath(oracleDir, input.name ~ ".gz"), compressed);
    }
}

private void collectRanges(const(char)[] text, const string[string] names, ref CodeRange[][string] properties) {
    auto lines = text.lineSplitter();
    enforce(!lines.empty && lines.front.canFind(unicodeVersion), "Unexpected Unicode property file version");
    foreach (line; lines) {
        auto fields = line.findSplit(";");
        if (fields[1].empty || fields[0].empty || fields[0][0] == '#') continue;

        const property = fields[2].findSplit("#")[0].strip();
        const name = property in names;
        if (name is null) continue;

        auto endpoints = fields[0].strip().findSplit("..");
        const first = to!uint(endpoints[0], 16);
        const last = endpoints[2].empty ? first : to!uint(endpoints[2], 16);
        properties[*name] ~= CodeRange(first, last);
    }
}

private CodeRange[] mergeRanges(CodeRange[] ranges) {
    ranges.sort!((a, b) => a.first < b.first);
    CodeRange[] merged;
    foreach (range; ranges) {
        if (merged.length != 0 && range.first <= merged[$ - 1].last + 1) {
            merged[$ - 1].last = max(merged[$ - 1].last, range.last);
        } else {
            merged ~= range;
        }
    }
    return merged;
}

private CaseMapping[][2] collectMappings(const(char)[] text) {
    CaseMapping[][2] mappings;
    foreach (line; text.lineSplitter()) {
        if (line.strip().empty) continue;
        const fields = line.split(';');
        enforce(fields.length == 15, "Malformed UnicodeData row");
        const scalar = to!uint(fields[0], 16);
        foreach (index, field; fields[12 .. 14]) {
            if (field.empty) continue;
            const mapped = to!uint(field, 16);
            enforce(isScalar(scalar) && isScalar(mapped), "Invalid Unicode scalar in simple case mapping");
            if (mapped != scalar) mappings[index] ~= CaseMapping(scalar, mapped);
        }
    }
    return mappings;
}

private bool isScalar(uint value) {
    return value <= 0x10ffff && (value < 0xd800 || value > 0xdfff);
}
